  "relationships": [
    {
      "from": "樂進（文謙）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws17b-p1",
          "text": {
            "en": "Bold and valiant despite his short stature, Yue Jin entered Cao Cao's service as a clerk Under the Tent; sent to recruit troops, he raised over a thousand men and was made Acting Major and Commandant Who Breaks Formations.",
            "zht": "樂進雖然身材短小，卻憑着勇敢無畏投身太祖麾下，任帳下吏；奉命招募士兵得千餘人，升任軍中司馬之副、陷陣都尉。",
            "zhs": "乐进虽然身材短小，却凭着勇敢无畏投身太祖麾下，任帐下吏；奉命招募士兵得千余人，升任军中司马之副、陷阵都尉。"
          }
        },
        {
          "passageId": "ws17b-p3",
          "text": {
            "en": "Cao Cao memorialised the emperor praising Yue Jin's martial prowess, loyalty, and leadership in battle, and appointed him General Who Breaks the Charge.",
            "zht": "曹操上表漢帝，稱讚樂進武力弘毅、忠信守節、每戰身先士卒，任命他爲折衝將軍。",
            "zhs": "曹操上表汉帝，称赞乐进武力弘毅、忠信守节、每战身先士卒，任命他为折冲将军。"
          },
          "title": {
            "en": "General Who Breaks the Charge",
            "zht": "折衝將軍",
            "zhs": "折冲将军"
          }
        },
        {
          "passageId": "ws17b-p5",
          "text": {
            "en": "For his repeated merit, Cao Cao granted Yue Jin the Imperial Tally, increased his fief, enfeoffed one of his sons as a marquis, and promoted him to General of the Right.",
            "zht": "因樂進屢立戰功，太祖授予他節杖，增加封邑，封他一子爲列侯，並升任他爲右將軍。",
            "zhs": "因乐进屡立战功，太祖授予他节杖，增加封邑，封他一子为列侯，并升任他为右将军。"
          },
          "title": {
            "en": "General of the Right",
            "zht": "右將軍",
            "zhs": "右将军"
          }
        }
      ]
    },
    {
      "from": "樂進（文謙）",
      "to": "樂綝",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws17b-p6",
          "text": {
            "en": "Yue Jin's son Yue Chen, resolute like his father, succeeded him and rose to become Inspector of Yang Province.",
            "zht": "樂進之子樂綝繼承爵位，果敢剛毅有父風，官至揚州刺史。",
