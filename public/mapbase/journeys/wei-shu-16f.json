  "relationships": [
    {
      "from": "倉慈（孝仁）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16f-p1",
          "text": {
            "en": "During the Jian'an era Cao Cao recruited settlers to establish agricultural colonies in Huainan and appointed Cang Ci Commandant Who Calms and Gathers.",
            "zht": "建安年間曹操招募流民在淮南屯田，任命倉慈為綏集都尉。",
            "zhs": "建安年间曹操招募流民在淮南屯田，任命仓慈为绥集都尉。"
          },
          "title": {
            "en": "Commandant Who Calms and Gathers",
            "zht": "綏集都尉",
            "zhs": "绥集都尉"
          }
        }
      ]
    },
    {
      "from": "尹奉",
      "to": "倉慈（孝仁）",
      "type": "colleagues",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16f-p2",
          "text": {
            "en": "Former Grand Administrators of Dunhuang such as Yin Feng had merely followed established practice and made no attempt to reform it; Cang Ci succeeded them and curbed the powerful clans, redistributed surplus land, and cleared the backlog of lawsuits.",
            "zht": "尹奉等敦煌歷任太守只是沿襲舊例，未加改革；倉慈繼任後抑制豪強，重新分配多佔的土地，並清理積壓的訴訟。",
            "zhs": "尹奉等敦煌历任太守只是沿袭旧例，未加改革；仓慈继任后抑制豪强，重新分配多占的土地，并清理积压的诉讼。"
          }
        }
      ]
    },
    {
      "from": "倉慈（孝仁）",
      "to": "王遷",
      "type": "colleagues",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16f-p3",
          "text": {
            "en": "After Cang Ci died in office, Wang Qian of Tianshui succeeded him as Grand Administrator of Dunhuang; he followed Cang Ci's practices but could not equal him.",
            "zht": "倉慈在任去世後，天水人王遷繼任敦煌太守；他沿用倉慈的做法，卻不及倉慈。",
            "zhs": "仓慈在任去世后，天水人王迁继任敦煌太守；他沿用仓慈的做法，却不及仓慈。"
          }
        }
      ]
    },
    {
      "from": "王遷",
      "to": "趙基",
      "type": "colleagues",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16f-p3",
          "text": {
            "en": "Zhao Ji of Jincheng succeeded Wang Qian as Grand Administrator of Dunhuang but proved inferior even to him.",
            "zht": "金城人趙基繼王遷任敦煌太守，還不及王遷。",
            "zhs": "金城人赵基继王迁任敦煌太守，还不及王迁。"
          }
        }
      ]
    },
    {
      "from": "趙基",
      "to": "皇甫隆",
      "type": "colleagues",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16f-p3",
          "text": {
            "en": "Huangfu Long of Anding succeeded Zhao Ji and taught the people of Dunhuang to make seed drills and irrigate efficiently, halving the labour and raising the yield by half.",
            "zht": "安定人皇甫隆繼趙基任太守，教敦煌百姓製作耬犁、改進灌溉，省工過半，收成增加五成。",
            "zhs": "安定人皇甫隆继赵基任太守，教敦煌百姓制作耧犁、改进灌溉，省工过半，收成增加五成。"
          }
        }
      ]
    },
    {
      "from": "令狐邵（孔叔）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16f-p4",
          "text": {
            "en": "When Cao Cao captured Maocheng, he spared Linghu Shao on recognising his father's name and appointed him Military Strategy Section Administrator; Linghu Shao went on to serve as county magistrate, commandery governor, Registrar to the Chancellor and Grand Administrator of Hongnong.",
            "zht": "曹操攻破毛城，見令狐邵衣冠舉止像士人，問及家世，認出其父之名，遂將他釋放，署為軍謀掾；令狐邵後歷任縣令、郡守、丞相主簿，出為弘農太守。",
            "zhs": "曹操攻破毛城，见令狐邵衣冠举止像士人，问及家世，认出其父之名，遂将他释放，署为军谋掾；令狐邵后历任县令、郡守、丞相主簿，出为弘农太守。"
          },
          "title": {
            "en": "Military Strategy Section Administrator",
            "zht": "軍謀掾",
            "zhs": "军谋掾"
          }
        }
      ]
    },
    {
      "from": "令狐邵（孔叔）",
      "to": "樂詳（文載）",
      "type": "colleagues",
      "polarity": "positive",
      "directed": false,
      "notes": [
        {
          "passageId": "ws16f-p4",
          "text": {
            "en": "As Grand Administrator of Hongnong, Linghu Shao sent officials to Hedong to study the Classics under Yue Xiang, then established schools when they returned, so that learning gradually flourished in Hongnong.",
            "zht": "令狐邵任弘農太守時，遣送吏民赴河東跟隨樂詳學習經書，學成歸來後設立學校，弘農學風漸盛。",
            "zhs": "令狐邵任弘农太守时，遣送吏民赴河东跟随乐详学习经书，学成归来后设立学校，弘农学风渐盛。"
