  "relationships": [
    {
      "from": "杜恕（務伯）",
      "to": "曹叡（元仲）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16d-p1",
          "text": {
            "en": "During the Taihe era Du Shu served Cao Rui as Cavalier Attendant Gentleman and Attendant Gentleman within the Yellow Gates; Cao Rui, considering him the son of a great minister, promoted him despite his lack of early reputation.",
            "zht": "太和年間杜恕侍奉曹叡，任散騎侍郎、黃門侍郎；曹叡因他是大臣之子而加以提拔，雖然他早年並無聲名。",
            "zhs": "太和年间杜恕侍奉曹叡，任散骑侍郎、黄门侍郎；曹叡因他是大臣之子而加以提拔，虽然他早年并无声名。"
          },
          "title": {
            "en": "Attendant Gentleman within the Yellow Gates",
            "zht": "黃門侍郎",
            "zhs": "黄门侍郎"
          }
        },
        {
          "passageId": "ws16d-p23",
          "text": {
            "en": "For eight years at court, Du Shu submitted uncompromising and forthright memorials on economy, official assessment and the ruler's use of ministers.",
            "zht": "杜恕在朝八年，屢次上疏直言，論財用、考課及君主用臣之道，無所迴避。",
            "zhs": "杜恕在朝八年，屡次上疏直言，论财用、考课及君主用臣之道，无所回避。"
          }
        },
        {
          "passageId": "ws16d-p24",
          "text": {
            "en": "Because he would not conform to his contemporaries' ways, Du Shu was repeatedly sent out of the capital, as Grand Administrator of Hongnong and Hedong, Protector of the Provincial Army north of the Huai, and Inspector of You Province with the Imperial Tally.",
            "zht": "杜恕在朝不肯隨俗，屢被外放，歷任弘農太守、河東太守、淮北都督護軍，後出任幽州刺史，持節，領護烏丸校尉。",
            "zhs": "杜恕在朝不肯随俗，屡被外放，历任弘农太守、河东太守、淮北都督护军，后出任幽州刺史，持节，领护乌丸校尉。"
          },
          "title": {
            "en": "Inspector of You Province",
            "zht": "幽州刺史",
            "zhs": "幽州刺史"
          }
        }
      ]
    },
    {
      "from": "杜恕（務伯）",
      "to": "李豐（安國）",
      "type": "personal",
      "polarity": "mixed",
      "directed": false,
      "notes": [
        {
          "passageId": "ws16d-p1",
          "text": {
            "en": "Du Shu and Li Feng had been close since childhood, but as adults their aims diverged sharply: Li Feng assiduously cultivated his reputation while Du Shu was unrestrained, and Li Feng regarded Du Shu with hostility, rising at court while Du Shu stayed at home; they later served together at court.",
            "zht": "杜恕與李豐自幼親近，成年後志趣迥異：李豐刻意修飾名聲，杜恕則不拘小節，李豐因此敵視杜恕；李豐在朝中顯達時杜恕仍閒居在家，後來二人同朝為官。",
            "zhs": "杜恕与李丰自幼亲近，成年后志趣迥异：李丰刻意修饰名声，杜恕则不拘小节，李丰因此敌视杜恕；李丰在朝中显达时杜恕仍闲居在家，后来二人同朝为官。"
          }
        }
      ]
    },
    {
      "from": "辛毗（佐治）",
      "to": "杜恕（務伯）",
      "type": "personal",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws16d-p1",
          "text": {
            "en": "Because Du Shu cultivated no private connections and spoke forthrightly for the public good, Palace Attendant Xin Pi and others held him in high regard.",
            "zht": "杜恕在朝不結私黨、一心為公，敢於直言，侍中辛毗等人因此十分敬重他。",
            "zhs": "杜恕在朝不结私党、一心为公，敢于直言，侍中辛毗等人因此十分敬重他。"
          }
        }
      ]
    },
    {
      "from": "呂昭（子展）",
      "to": "杜恕（務伯）",
      "type": "colleagues",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws16d-p4",
          "text": {
            "en": "Du Shu objected to giving Lü Zhao, General Who Garrisons the North, charge of Ji Province as well, arguing that a man of his abilities could readily be replaced and that civil and military offices should be separate.",
            "zht": "杜恕反對讓鎮北將軍呂昭兼領冀州，認為以他的才幹不難另擇他人，並主張文武分職。",
            "zhs": "杜恕反对让镇北将军吕昭兼领冀州，认为以他的才干不难另择他人，并主张文武分职。"
          }
        }
      ]
    },
    {
      "from": "袁侃",
      "to": "杜恕（務伯）",
      "type": "colleagues",
      "polarity": "positive",
      "directed": false,
      "notes": [
        {
          "passageId": "ws16d-p12",
          "text": {
            "en": "Yuan Kan, a Gentleman within the Yellow Gates, was Du Shu's colleague and close friend, and later warned him to be careful in dealing with Cheng Xi, which Du Shu ignored.",
            "zht": "黃門侍郎袁侃是杜恕的同僚與摯友，後來曾勸他謹慎對待程喜，杜恕卻不以為意。",
            "zhs": "黄门侍郎袁侃是杜恕的同僚与挚友，后来曾劝他谨慎对待程喜，杜恕却不以为意。"
          }
        }
      ]
    },
    {
      "from": "荀俁",
      "to": "杜恕（務伯）",
      "type": "colleagues",
      "polarity": "positive",
      "directed": false,
      "notes": [
        {
          "passageId": "ws16d-p12",
          "text": {
            "en": "Xun Yu, later Grand Administrator of Dong Commandery, was Du Shu's colleague and close friend.",
            "zht": "荀俁是杜恕的同僚與摯友，後任東郡太守。",
            "zhs": "荀俁是杜恕的同僚与挚友，后任东郡太守。"
          }
        }
      ]
    },
    {
