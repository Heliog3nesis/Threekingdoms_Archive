  "relationships": [
    {
      "from": "曹操（孟德）",
      "to": "曹洪（子廉）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9d-p1",
          "text": {
            "en": "Cao Hong was Cao Cao's younger paternal cousin.",
            "zht": "曹洪是曹操的堂弟。",
            "zhs": "曹洪是曹操的堂弟。"
          }
        }
      ]
    },
    {
      "from": "曹鼎",
      "to": "曹洪（子廉）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9d-p1",
          "text": {
            "en": "Cao Hong's paternal uncle Cao Ding, Director of the Imperial Secretariat, appointed him Chief of Qichun.",
            "zht": "曹洪的伯父曹鼎任尚書令，任用曹洪爲蘄春縣長。",
            "zhs": "曹洪的伯父曹鼎任尚书令，任用曹洪为蕲春县长。"
          }
        }
      ]
    },
    {
      "from": "曹洪（子廉）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9d-p1",
          "text": {
            "en": "When Cao Cao lost his horse fleeing Xu Rong at Xingyang, Cao Hong gave him his own, saying the realm could do without him but not without Cao Cao, and found a boat to carry them across the Bian River.",
            "zht": "曹操在滎陽被徐榮擊敗、失去坐騎時，曹洪把自己的馬讓給他，說“天下可無洪，不可無君”，又沿汴水找到船隻，與曹操一同渡河。",
            "zhs": "曹操在荥阳被徐荣击败、失去坐骑时，曹洪把自己的马让给他，说“天下可无洪，不可无君”，又沿汴水找到船只，与曹操一同渡河。"
          }
        },
        {
          "passageId": "ws9d-p1",
          "text": {
            "en": "Cao Hong raised several thousand troops in Lujiang and Danyang and brought them to join Cao Cao at Longkang.",
            "zht": "曹洪在廬江、丹楊招募了數千士兵，到龍亢與曹操會合。",
            "zhs": "曹洪在庐江、丹杨招募了数千士兵，到龙亢与曹操会合。"
          }
        },
        {
          "passageId": "ws9d-p2",
          "text": {
            "en": "For securing Dongping and Fan and keeping the army supplied during the famine, Cao Hong was appointed Soaring Eagle Colonel and later Gentleman-General Who Promotes Valor.",
            "zht": "曹洪在饑荒中搶先佔據東平、范縣，聚集糧食供應大軍，因功被任命爲鷹揚校尉，後升揚武中郎將。",
            "zhs": "曹洪在饥荒中抢先占据东平、范县，聚集粮食供应大军，因功被任命为鹰扬校尉，后升扬武中郎将。"
          },
          "title": {
            "en": "Soaring Eagle Colonel, Gentleman-General Who Promotes Valor",
            "zht": "鷹揚校尉、揚武中郎將",
            "zhs": "鹰扬校尉、扬武中郎将"
          }
        },
        {
          "passageId": "ws9d-p3",
          "text": {
            "en": "After defeating Liu Biao's generals, Cao Hong was promoted to General Who Rouses the Vanguard and enfeoffed as Neighbourhood Marquis of Guoming.",
            "zht": "曹洪擊敗劉表部將後，升任厲鋒將軍，封國明亭侯。",
            "zhs": "曹洪击败刘表部将后，升任厉锋将军，封国明亭侯。"
          },
          "title": {
            "en": "General Who Rouses the Vanguard, Neighbourhood Marquis of Guoming",
            "zht": "厲鋒將軍、國明亭侯",
            "zhs": "厉锋将军、国明亭侯"
          }
        },
        {
          "passageId": "ws9d-p3",
          "text": {
            "en": "For service in successive campaigns, Cao Hong was appointed General Protector.",
            "zht": "曹洪因屢次隨軍征伐，被任命爲都護將軍。",
            "zhs": "曹洪因屡次随军征伐，被任命为都护将军。"
          },
          "title": {
            "en": "General Protector",
            "zht": "都護將軍",
            "zhs": "都护将军"
          }
        },
        {
          "passageId": "ws9d-p4",
          "text": {
            "en": "When Qiao's magistrate assessed property for levies, Cao Hong's wealth was found equal to Cao Cao's, and Cao Cao remarked, \"How could my household's wealth match Zilian's?\"",
            "zht": "譙縣縣令評估家產時，曹洪的家財與曹操家相當，曹操說：“我家的財產怎能比得上子廉！”",
            "zhs": "谯县县令评估家产时，曹洪的家财与曹操家相当，曹操说：“我家的财产怎能比得上子廉！”"
          }
        }
      ]
    },
    {
      "from": "曹洪（子廉）",
      "to": "曹丕（子桓）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9d-p3",
          "text": {
            "en": "When Cao Pi ascended the throne, Cao Hong became General of the Guards.",
            "zht": "曹丕即位後，曹洪任衛將軍。",
            "zhs": "曹丕即位后，曹洪任卫将军。"
          },
          "title": {
            "en": "General of the Guards",
            "zht": "衞將軍",
            "zhs": "衞将军"
          }
        },
        {
          "passageId": "ws9d-p3",
          "text": {
            "en": "Cao Pi promoted Cao Hong to General of Agile Cavalry, raised him to County Marquis of Yewang and granted him the rank of Specially Advanced.",
            "zht": "曹丕升曹洪爲驃騎將軍，進封野王侯，位特進。",
            "zhs": "曹丕升曹洪为骠骑将军，进封野王侯，位特进。"
          },
          "title": {
            "en": "General of Agile Cavalry, County Marquis of Yewang",
            "zht": "驃騎將軍、野王侯",
            "zhs": "骠骑将军、野王侯"
          }
        }
      ]
    },
    {
      "from": "曹丕（子桓）",
      "to": "曹洪（子廉）",
      "type": "personal",
      "polarity": "negative",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9d-p4",
          "text": {
            "en": "Cao Pi had resented Cao Hong ever since Hong refused him a loan in his youth; when Hong's retainer broke the law, Cao Pi imprisoned him and sentenced him to death, sparing him only after his mother's intervention, and even then dismissing him and reducing his rank and fief.",
            "zht": "曹丕年少時向曹洪借錢遭拒，一直懷恨在心；曹洪的門客犯法後，曹丕將曹洪下獄判處死刑，在卞太后干預下才免他一死，但仍罷免官職、削減爵位和封地。",
            "zhs": "曹丕年少时向曹洪借钱遭拒，一直怀恨在心；曹洪的门客犯法后，曹丕将曹洪下狱判处死刑，在卞太后干预下才免他一死，但仍罢免官职、削减爵位和封地。"
          }
        },
        {
          "passageId": "ws9d-p4",
          "text": {
            "en": "Cao Pi had once asked to borrow a hundred bolts of silk from Cao Hong and been refused; once spared, Cao Hong submitted a humble memorial confessing his greed and thanking him for his life.",
            "zht": "曹丕在東宮時曾向曹洪借絹一百匹，被拒絕；曹洪獲赦後上書謝罪，自認貪婪，感謝不殺之恩。",
            "zhs": "曹丕在东宫时曾向曹洪借绢一百匹，被拒绝；曹洪获赦后上书谢罪，自认贪婪，感谢不杀之恩。"
          }
        }
      ]
    },
    {
