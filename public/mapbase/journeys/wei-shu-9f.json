  "relationships": [
    {
      "from": "曹操（孟德）",
      "to": "曹真（子丹）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "Cao Zhen was the son of one of Cao Cao's clansmen; Cao Cao took pity on the orphaned boy, adopted him and raised him as one of his own sons.",
            "zht": "曹真是曹操的族子；曹操憐惜他年少喪父，將他收養，待他與自己的兒子一樣。",
            "zhs": "曹真是曹操的族子；曹操怜惜他年少丧父，将他收养，待他与自己的儿子一样。"
          }
        }
      ]
    },
    {
      "from": "曹邵",
      "to": "曹真（子丹）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "Cao Zhen's father Cao Shao recruited followers when Cao Cao raised troops and was killed by the provincial and commandery authorities, leaving Cao Zhen an orphan.",
            "zht": "曹真之父曹邵在曹操起兵時招募徒衆，被州郡官府所殺，曹真從小成了孤兒。",
            "zhs": "曹真之父曹邵在曹操起兵时招募徒众，被州郡官府所杀，曹真从小成了孤儿。"
          }
        }
      ]
    },
    {
      "from": "秦伯南",
      "to": "曹真（子丹）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "According to the Weilüe, Cao Zhen was born a Qin and his father was Qin Bonan; Cao Cao changed his surname in gratitude for his father's sacrifice.",
            "zht": "據《魏略》記載，曹真本姓秦，父親是秦伯南；曹操感念他父親的恩德，爲他改姓曹。",
            "zhs": "据《魏略》记载，曹真本姓秦，父亲是秦伯南；曹操感念他父亲的恩德，为他改姓曹。"
          }
        }
      ]
    },
    {
      "from": "秦伯南",
      "to": "曹操（孟德）",
      "type": "personal",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "Qin Bonan, an old friend of Cao Cao, took him in when Yuan Shu's men were pursuing him, told them he himself was Cao Cao, and was killed in his place.",
            "zht": "秦伯南向來與曹操交好；袁術部下追殺曹操時，秦伯南開門收留他，並對追兵自稱是曹操，結果被殺。",
            "zhs": "秦伯南向来与曹操交好；袁术部下追杀曹操时，秦伯南开门收留他，并对追兵自称是曹操，结果被杀。"
          }
        }
      ]
    },
    {
      "from": "曹邵",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "Loyal and capable, Cao Shao was trusted by Cao Cao and raised followers to accompany him when he took up arms in the Chuping era.",
            "zht": "曹邵忠厚有才智，深得曹操信任；初平年間曹操起兵時，他招募徒衆跟隨曹操。",
            "zhs": "曹邵忠厚有才智，深得曹操信任；初平年间曹操起兵时，他招募徒众跟随曹操。"
          }
        }
      ]
    },
    {
      "from": "黃琬（子琰）",
      "to": "曹邵",
      "type": "personal",
      "polarity": "negative",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "When Huang Wan, Inspector of Yu Province, tried to harm Cao Cao, Cao Cao escaped but Cao Shao was killed.",
            "zht": "豫州刺史黃琬想加害曹操，曹操躲過一劫，曹邵卻獨自遇害。",
            "zhs": "豫州刺史黄琬想加害曹操，曹操躲过一劫，曹邵却独自遇害。"
          }
        }
      ]
    },
    {
      "from": "曹真（子丹）",
      "to": "曹丕（子桓）",
      "type": "personal",
      "polarity": "positive",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "Cao Cao had Cao Zhen live together with Cao Pi.",
            "zht": "曹操讓曹真與曹丕一同居住。",
            "zhs": "曹操让曹真与曹丕一同居住。"
          }
        }
      ]
    },
    {
      "from": "曹真（子丹）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p1",
          "text": {
            "en": "Impressed when Cao Zhen shot down a pursuing tiger, Cao Cao placed him in command of the Tiger and Leopard Cavalry.",
            "zht": "曹真在打獵時回身射倒追趕他的老虎，曹操讚賞他的勇猛，讓他統領虎豹騎。",
            "zhs": "曹真在打猎时回身射倒追赶他的老虎，曹操赞赏他的勇猛，让他统领虎豹骑。"
          }
        },
        {
          "passageId": "ws9f-p2",
          "text": {
            "en": "After capturing the rebel town of Lingqiu, Cao Zhen was enfeoffed as Neighbourhood Marquis of Lingshou.",
            "zht": "曹真攻克靈丘賊寇後，被封爲靈壽亭侯。",
            "zhs": "曹真攻克灵丘贼寇后，被封为灵寿亭侯。"
          },
          "title": {
            "en": "Neighbourhood Marquis of Lingshou",
            "zht": "靈壽亭侯",
            "zhs": "灵寿亭侯"
          }
        },
        {
          "passageId": "ws9f-p2",
          "text": {
            "en": "After defeating one of Liu Bei's generals at Xiabian, Cao Zhen was appointed General of the Central Vanguard, and at Chang'an became Commander of the Central Army.",
            "zht": "曹真在下辯擊破劉備部將後，被任命爲中堅將軍，到長安後兼任中領軍。",
            "zhs": "曹真在下辩击破刘备部将后，被任命为中坚将军，到长安后兼任中领军。"
          },
          "title": {
            "en": "General of the Central Vanguard, Commander of the Central Army",
            "zht": "中堅將軍、中領軍",
            "zhs": "中坚将军、中领军"
          }
        },
        {
          "passageId": "ws9f-p2",
          "text": {
            "en": "Worried after Xiahou Yuan's death, Cao Cao made Cao Zhen Protector of the Army for the expedition against Shu, and later sent him to Wudu to bring Cao Hong and the others back to Chencang.",
            "zht": "夏侯淵陣亡後，曹操憂心忡忡，任命曹真爲征蜀護軍；後來又派他到武都接曹洪等人回駐陳倉。",
            "zhs": "夏侯渊阵亡后，曹操忧心忡忡，任命曹真为征蜀护军；后来又派他到武都接曹洪等人回驻陈仓。"
          },
          "title": {
            "en": "Protector of the Army for the Expedition against Shu",
            "zht": "征蜀護軍",
            "zhs": "征蜀护军"
          }
        }
      ]
    },
    {
      "from": "曹真（子丹）",
      "to": "曹丕（子桓）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p2",
          "text": {
            "en": "When Cao Pi became king, he appointed Cao Zhen General Who Garrisons the West with command of Yong and Liang provinces, and advanced him to Township Marquis of Dong.",
            "zht": "曹丕即王位後，任命曹真爲鎮西將軍，都督雍、涼二州諸軍事，進封東鄉侯。",
            "zhs": "曹丕即王位后，任命曹真为镇西将军，都督雍、凉二州诸军事，进封东乡侯。"
          },
          "title": {
            "en": "General Who Garrisons the West, Township Marquis of Dong",
            "zht": "鎮西將軍、東鄉侯",
            "zhs": "镇西将军、东乡侯"
          }
        },
        {
          "passageId": "ws9f-p2",
          "text": {
            "en": "On his return to the capital, Cao Zhen was appointed Grand General of the Upper Army and Commander of All Forces.",
            "zht": "曹真回到京城後，被任命爲上軍大將軍，都督中外諸軍事。",
            "zhs": "曹真回到京城后，被任命为上军大将军，都督中外诸军事。"
          },
          "title": {
            "en": "Grand General of the Upper Army",
            "zht": "上軍大將軍",
            "zhs": "上军大将军"
          }
        },
        {
          "passageId": "ws9f-p2",
          "text": {
            "en": "After the victory at Niuzhu, Cao Zhen was made Grand General of the Central Army with the additional office of Palace Aide.",
            "zht": "牛渚大捷後，曹真轉任中軍大將軍，加給事中。",
            "zhs": "牛渚大捷后，曹真转任中军大将军，加给事中。"
          },
          "title": {
            "en": "Grand General of the Central Army",
            "zht": "中軍大將軍",
            "zhs": "中军大将军"
          }
        },
        {
          "passageId": "ws9f-p3",
          "text": {
            "en": "On his deathbed, Cao Pi named Cao Zhen, Chen Qun and Sima Yi to receive his testamentary edict and assist in governing.",
            "zht": "曹丕病重時，曹真與陳羣、司馬懿等人一同接受遺詔輔政。",
            "zhs": "曹丕病重时，曹真与陈群、司马懿等人一同接受遗诏辅政。"
          }
        },
        {
          "passageId": "ws9f-p5",
          "text": {
            "en": "Cao Pi set aside two hundred households from Cao Zhen's fief to enfeoff his younger brother Cao Bin as a Marquis.",
            "zht": "曹丕分出曹真的封戶二百，封他的弟弟曹彬爲列侯。",
            "zhs": "曹丕分出曹真的封户二百，封他的弟弟曹彬为列侯。"
          }
        }
      ]
    },
    {
      "from": "曹真（子丹）",
      "to": "曹叡（元仲）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9f-p3",
          "text": {
            "en": "When Cao Rui ascended the throne, he advanced Cao Zhen to County Marquis of Shaoling and promoted him to Grand General.",
            "zht": "明帝即位後，曹真進封邵陵侯，升任大將軍。",
            "zhs": "明帝即位后，曹真进封邵陵侯，升任大将军。"
          },
          "title": {
            "en": "County Marquis of Shaoling, Grand General",
            "zht": "邵陵侯、大將軍",
            "zhs": "邵陵侯、大将军"
          }
        },
        {
          "passageId": "ws9f-p3",
          "text": {
            "en": "Cao Rui sent Cao Zhen to lead the armies at Meiguo against Zhuge Liang's first northern campaign.",
            "zht": "諸葛亮第一次北伐時，明帝派曹真督率諸軍駐守郿縣。",
            "zhs": "诸葛亮第一次北伐时，明帝派曹真督率诸军驻守郿县。"
          }
        },
        {
          "passageId": "ws9f-p4",
          "text": {
            "en": "Cao Zhen was promoted to Grand Marshal and granted the right to wear his sword and shoes in the palace hall and to attend court without quickening his step.",
            "zht": "曹真升任大司馬，獲准佩劍穿履上殿、入朝不必小步快走。",
            "zhs": "曹真升任大司马，获准佩剑穿履上殿、入朝不必小步快走。"
          },
          "title": {
            "en": "Grand Marshal",
            "zht": "大司馬",
            "zhs": "大司马"
          }
        },
        {
          "passageId": "ws9f-p4",
          "text": {
            "en": "Cao Rui accepted Cao Zhen's plan to invade Shu along several routes and saw him off in person, but recalled him when thirty days of rain cut the plank roads.",
            "zht": "明帝採納曹真多路伐蜀的計劃，親自爲他送行；後因連降大雨三十多天、棧道斷絕，下詔讓曹真撤軍。",
            "zhs": "明帝采纳曹真多路伐蜀的计划，亲自为他送行；后因连降大雨三十多天、栈道断绝，下诏让曹真撤军。"
          }
        },
        {
          "passageId": "ws9f-p5",
          "text": {
            "en": "Cao Rui granted Cao Zhen's request to share his fief with the sons of Cao Zun and Zhu Zan, likening him to Shuxiang and Yan Ping.",
            "zht": "明帝准許曹真分出封邑給曹遵、朱讚的兒子，稱讚他有叔向撫孤之仁、晏平仲久要之分。",
            "zhs": "明帝准许曹真分出封邑给曹遵、朱赞的儿子，称赞他有叔向抚孤之仁、晏平仲久要之分。"
          }
        },
        {
          "passageId": "ws9f-p5",
          "text": {
            "en": "Cao Rui visited the ailing Cao Zhen at his residence; after his death he praised his loyalty and modesty and enfeoffed all five of his sons as Marquises.",
            "zht": "曹真病重時，明帝親自到他府上探望；曹真死後，明帝下詔稱讚他忠節謙遜，把他的五個兒子都封爲列侯。",
            "zhs": "曹真病重时，明帝亲自到他府上探望；曹真死后，明帝下诏称赞他忠节谦逊，把他的五个儿子都封为列侯。"
          }
        }
      ]
    },
