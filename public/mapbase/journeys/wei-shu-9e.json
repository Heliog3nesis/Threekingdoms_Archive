  "relationships": [
    {
      "from": "曹操（孟德）",
      "to": "曹休（文烈）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9e-p1",
          "text": {
            "en": "Cao Xiu was the son of one of Cao Cao's clan brothers; Cao Cao called him \"our family's thousand-li horse\" and raised him as his own son.",
            "zht": "曹休是曹操的族子；曹操稱他爲“吾家千里駒”，待他如同親生兒子。",
            "zhs": "曹休是曹操的族子；曹操称他为“吾家千里驹”，待他如同亲生儿子。"
          }
        }
      ]
    },
    {
      "from": "曹休（文烈）",
      "to": "曹丕（子桓）",
      "type": "personal",
      "polarity": "positive",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9e-p1",
          "text": {
            "en": "Cao Cao had Cao Xiu live together with Cao Pi.",
            "zht": "曹操讓曹休與曹丕一同居住。",
            "zhs": "曹操让曹休与曹丕一同居住。"
          }
        }
      ]
    },
    {
      "from": "曹休（文烈）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9e-p1",
          "text": {
            "en": "After the clan scattered, Cao Xiu changed his name and made his way north to join Cao Cao, who put him in command of the Tiger and Leopard Cavalry as his personal guard.",
            "zht": "宗族離散後，曹休改名換姓，輾轉北歸投奔曹操，曹操讓他統領虎豹騎擔任宿衛。",
            "zhs": "宗族离散后，曹休改名换姓，辗转北归投奔曹操，曹操让他统领虎豹骑担任宿卫。"
          }
        },
        {
          "passageId": "ws9e-p2",
          "text": {
            "en": "Cao Cao made Cao Xiu Commandant of Cavalry on Cao Hong's staff against Wu Lan, telling him that though nominally on the staff, he was in fact the commander.",
            "zht": "曹操任命曹休爲騎都尉，參曹洪軍事征討吳蘭，並對他說：“你雖是參軍，實際上是統帥。”",
            "zhs": "曹操任命曹休为骑都尉，参曹洪军事征讨吴兰，并对他说：“你虽是参军，实际上是统帅。”"
          },
          "title": {
            "en": "Commandant of Cavalry",
            "zht": "騎都尉",
            "zhs": "骑都尉"
          }
        },
        {
          "passageId": "ws9e-p3",
          "text": {
            "en": "When the armies returned from Hanzhong to Chang'an, Cao Xiu was appointed Commander of the Central Army.",
            "zht": "大軍從漢中撤回長安後，曹休被任命爲中領軍。",
            "zhs": "大军从汉中撤回长安后，曹休被任命为中领军。"
          },
          "title": {
            "en": "Commander of the Central Army",
            "zht": "中領軍",
            "zhs": "中领军"
          }
        }
      ]
    },
    {
      "from": "曹休（文烈）",
      "to": "曹丕（子桓）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9e-p3",
          "text": {
            "en": "When Cao Pi became king, he made Cao Xiu General Commanding the Army and enfeoffed him as Neighbourhood Marquis of Dongyang.",
            "zht": "曹丕即王位後，任命曹休爲領軍將軍，封東陽亭侯。",
            "zhs": "曹丕即王位后，任命曹休为领军将军，封东阳亭侯。"
          },
          "title": {
            "en": "General Commanding the Army, Neighbourhood Marquis of Dongyang",
            "zht": "領軍將軍、東陽亭侯",
            "zhs": "领军将军、东阳亭侯"
          }
        },
        {
          "passageId": "ws9e-p3",
          "text": {
            "en": "After Xiahou Dun died, Cao Pi made Cao Xiu General Who Garrisons the South with command of the armies, and came in person to see him off, stepping down from his carriage to clasp his hand.",
            "zht": "夏侯惇去世後，曹丕任命曹休爲鎮南將軍，都督諸軍事，並親自送行，下車握手而別。",
            "zhs": "夏侯惇去世后，曹丕任命曹休为镇南将军，都督诸军事，并亲自送行，下车握手而别。"
          },
          "title": {
            "en": "General Who Garrisons the South",
            "zht": "鎮南將軍",
            "zhs": "镇南将军"
          }
        },
        {
          "passageId": "ws9e-p3",
          "text": {
            "en": "Cao Xiu was promoted to General Who Conquers the East and Inspector of Yang Province; when his grief over his mother's death wore him down, Cao Pi sent Xue Qiao to let him go home to bury her, then comforted him in person.",
            "zht": "曹休升任征東將軍，兼揚州刺史；他因母親去世哀傷過度，曹丕派薛喬讓他回家治喪，事後又親自寬慰他。",
            "zhs": "曹休升任征东将军，兼扬州刺史；他因母亲去世哀伤过度，曹丕派薛乔让他回家治丧，事后又亲自宽慰他。"
          },
          "title": {
            "en": "General Who Conquers the East, Inspector of Yang Province",
            "zht": "征東將軍、揚州刺史",
            "zhs": "征东将军、扬州刺史"
          }
        },
        {
          "passageId": "ws9e-p4",
          "text": {
            "en": "For Cao Pi's campaign against Sun Quan, Cao Xiu was made Grand General Who Conquers the East with the Yellow Yue, and after defeating Lü Fan he was appointed Governor of Yang Province.",
            "zht": "曹丕征討孫權時，任命曹休爲征東大將軍，假黃鉞；曹休擊破呂範後，被任命爲揚州牧。",
            "zhs": "曹丕征讨孙权时，任命曹休为征东大将军，假黄钺；曹休击破吕范后，被任命为扬州牧。"
          },
          "title": {
            "en": "Grand General Who Conquers the East, Governor of Yang Province",
            "zht": "征東大將軍、揚州牧",
            "zhs": "征东大将军、扬州牧"
