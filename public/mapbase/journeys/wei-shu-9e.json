      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9e-p3",
          "text": {
            "en": "Cao Xiu defeated the general Sun Quan had stationed at Liyang and burned the enemy camp at Wuhu.",
            "zht": "曹休擊敗孫權派駐歷陽的部將，又焚燒了蕪湖的敵營。",
            "zhs": "曹休击败孙权派驻历阳的部将，又焚烧了芜湖的敌营。"
          }
        },
        {
          "passageId": "ws9e-p4",
          "text": {
            "en": "Cao Xiu commanded more than twenty armies in Cao Pi's campaign against Sun Quan.",
            "zht": "在曹丕征討孫權的戰役中，曹休督率二十餘軍。",
            "zhs": "在曹丕征讨孙权的战役中，曹休督率二十余军。"
          }
        }
      ]
    },
