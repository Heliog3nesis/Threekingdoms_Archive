  "relationships": [
    {
      "from": "曹操（孟德）",
      "to": "曹仁（子孝）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p1",
          "text": {
            "en": "Cao Ren was Cao Cao's younger paternal cousin.",
            "zht": "曹仁是曹操的堂弟。",
            "zhs": "曹仁是曹操的堂弟。"
          }
        }
      ]
    },
    {
      "from": "曹褒",
      "to": "曹熾",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p1",
          "text": {
            "en": "Cao Ren's grandfather Cao Bao was Grand Administrator of Yingchuan, and his son Cao Chi was Cao Ren's father.",
            "zht": "曹仁的祖父曹褒任潁川太守，曹褒之子曹熾是曹仁的父親。",
            "zhs": "曹仁的祖父曹褒任颍川太守，曹褒之子曹炽是曹仁的父亲。"
          }
        }
      ]
    },
    {
      "from": "曹熾",
      "to": "曹仁（子孝）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p1",
          "text": {
            "en": "Cao Ren's father Cao Chi served as Palace Attendant and Colonel of the Changshui Garrison.",
            "zht": "曹仁的父親曹熾任侍中、長水校尉。",
            "zhs": "曹仁的父亲曹炽任侍中、长水校尉。"
          }
        },
        {
          "passageId": "ws9c-p7",
          "text": {
            "en": "On becoming king, Cao Pi posthumously honoured Cao Ren's father Cao Chi as County Marquis Mu of Chen and assigned ten households to guard his tomb.",
            "zht": "曹丕即王位後，追賜曹仁之父曹熾諡號陳穆侯，並設守冢十家。",
            "zhs": "曹丕即王位后，追赐曹仁之父曹炽谥号陈穆侯，并设守冢十家。"
          }
        }
      ]
    },
    {
      "from": "曹熾",
      "to": "曹純（子和）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p9",
          "text": {
            "en": "Cao Chun lost his father at fourteen and lived apart from his elder brother Cao Ren, managing the family estate and its hundreds of servants and retainers with skill.",
            "zht": "曹純十四歲喪父，與同胞兄長曹仁分居，繼承父業，管理數以百計的僮僕賓客，井井有條。",
            "zhs": "曹纯十四岁丧父，与同胞兄长曹仁分居，继承父业，管理数以百计的僮仆宾客，井井有条。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "曹純（子和）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p9",
          "text": {
            "en": "Cao Chun was Cao Ren's younger brother.",
            "zht": "曹純是曹仁的弟弟。",
            "zhs": "曹纯是曹仁的弟弟。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "曹操（孟德）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p1",
          "text": {
            "en": "Cao Ren gathered over a thousand young men and joined Cao Cao, who made him Major of a Separate Command and acting Colonel Who Rouses the Vanguard.",
            "zht": "曹仁暗中聚集一千多名青年，後來追隨曹操，任別部司馬，代理厲鋒校尉。",
            "zhs": "曹仁暗中聚集一千多名青年，后来追随曹操，任别部司马，代理厉锋校尉。"
          },
          "title": {
            "en": "Major of a Separate Command",
            "zht": "別部司馬",
            "zhs": "别部司马"
          }
        },
        {
          "passageId": "ws9c-p2",
          "text": {
            "en": "For repeated merit Cao Ren was appointed Grand Administrator of Guangyang, but Cao Cao, valuing his courage, kept him at court as a Gentleman Consultant commanding the cavalry.",
            "zht": "曹仁屢立戰功，被任命爲廣陽太守；曹操器重他的勇略，不讓他赴任，而以議郎身份督率騎兵。",
            "zhs": "曹仁屡立战功，被任命为广阳太守；曹操器重他的勇略，不让他赴任，而以议郎身份督率骑兵。"
          },
          "title": {
            "en": "Grand Administrator of Guangyang",
            "zht": "廣陽太守",
            "zhs": "广阳太守"
          }
        },
        {
          "passageId": "ws9c-p2",
          "text": {
            "en": "When Zhang Xiu pursued the withdrawing army and morale collapsed, Cao Ren rallied the troops; Cao Cao admired his valour.",
            "zht": "張繡追擊撤退的大軍，士卒喪氣，曹仁激勵將士奮戰；曹操讚賞他的勇氣。",
            "zhs": "张绣追击撤退的大军，士卒丧气，曹仁激励将士奋战；曹操赞赏他的勇气。"
          }
        },
        {
          "passageId": "ws9c-p3",
          "text": {
            "en": "During the stalemate at Guandu, Cao Ren advised striking Liu Bei before he could make use of Yuan Shao's troops; Cao Cao approved and sent him with cavalry.",
            "zht": "官渡相持時，曹仁建議趁劉備尚未能駕馭袁紹的軍隊時出擊；曹操採納了他的意見，派他率騎兵進擊。",
            "zhs": "官渡相持时，曹仁建议趁刘备尚未能驾驭袁绍的军队时出击；曹操采纳了他的意见，派他率骑兵进击。"
          }
        },
        {
          "passageId": "ws9c-p4",
          "text": {
            "en": "At the siege of Huguan, Cao Ren persuaded Cao Cao to withdraw his order to bury the defenders alive; the city surrendered, and Cao Cao enfeoffed him as Capital Neighbourhood Marquis.",
            "zht": "圍攻壺關時，曹仁勸曹操收回城破坑殺的命令；壺關投降，曹操封他爲都亭侯。",
            "zhs": "围攻壶关时，曹仁劝曹操收回城破坑杀的命令；壶关投降，曹操封他为都亭侯。"
          },
          "title": {
            "en": "Capital Neighbourhood Marquis",
            "zht": "都亭侯",
            "zhs": "都亭侯"
          }
        },
        {
          "passageId": "ws9c-p5",
          "text": {
            "en": "After Cao Ren's sally to rescue Niu Jin at Jiangling, Cao Cao esteemed his valour all the more and made him Neighbourhood Marquis of Anping.",
            "zht": "曹仁在江陵出城救出牛金後，曹操更加讚賞他的勇氣，轉封他爲安平亭侯。",
            "zhs": "曹仁在江陵出城救出牛金后，曹操更加赞赏他的勇气，转封他为安平亭侯。"
          },
          "title": {
            "en": "Neighbourhood Marquis of Anping",
            "zht": "安平亭侯",
            "zhs": "安平亭侯"
          }
        },
        {
          "passageId": "ws9c-p6",
          "text": {
            "en": "After putting down Hou Yin's rebellion at Wan, Cao Ren was formally appointed General Who Conquers the South.",
            "zht": "平定侯音在宛城的叛亂後，曹仁被正式任命爲征南將軍。",
            "zhs": "平定侯音在宛城的叛乱后，曹仁被正式任命为征南将军。"
          },
          "title": {
            "en": "General Who Conquers the South",
            "zht": "征南將軍",
            "zhs": "征南将军"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "曹丕（子桓）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p7",
          "text": {
            "en": "On becoming king, Cao Pi appointed Cao Ren General of Chariots and Cavalry in command of Jing, Yang and Yi provinces and advanced him to County Marquis of Chen.",
            "zht": "曹丕即王位後，任命曹仁爲車騎將軍，都督荊、揚、益三州諸軍事，進封陳侯。",
            "zhs": "曹丕即王位后，任命曹仁为车骑将军，都督荆、扬、益三州诸军事，进封陈侯。"
          },
          "title": {
            "en": "General of Chariots and Cavalry, County Marquis of Chen",
            "zht": "車騎將軍、陳侯",
            "zhs": "车骑将军、陈侯"
          }
        },
        {
          "passageId": "ws9c-p8",
          "text": {
            "en": "Cao Pi sent an envoy to appoint Cao Ren Grand General in the field.",
            "zht": "曹丕派使者前往軍中，任命曹仁爲大將軍。",
            "zhs": "曹丕派使者前往军中，任命曹仁为大将军。"
          },
          "title": {
            "en": "Grand General",
            "zht": "大將軍",
            "zhs": "大将军"
          }
        },
        {
          "passageId": "ws9c-p8",
          "text": {
            "en": "Ordered to move his garrison to Linying, Cao Ren was promoted to Grand Marshal.",
            "zht": "曹仁奉詔移駐臨潁，升任大司馬。",
            "zhs": "曹仁奉诏移驻临颍，升任大司马。"
          },
          "title": {
            "en": "Grand Marshal",
            "zht": "大司馬",
            "zhs": "大司马"
          }
        }
      ]
    },
    {
      "from": "曹丕（子桓）",
      "to": "曹仁（子孝）",
      "type": "personal",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p7",
          "text": {
            "en": "Writing to admonish Cao Zhang, Cao Pi held up Cao Ren, the General Who Conquers the South, as the model of a general who observes the law.",
            "zht": "曹丕寫信告誡曹彰，以征南將軍曹仁作爲爲將奉法的榜樣。",
            "zhs": "曹丕写信告诫曹彰，以征南将军曹仁作为为将奉法的榜样。"
          }
        }
      ]
    },
    {
      "from": "曹丕（子桓）",
      "to": "曹彰（子文）",
      "type": "kinship",
      "polarity": "neutral",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p7",
          "text": {
            "en": "When Cao Zhang campaigned north against the Wuhuan, his brother Cao Pi, then in the Eastern Palace, wrote urging him to observe the law as Cao Ren did.",
            "zht": "曹彰北征烏丸時，其兄曹丕尚在東宮，寫信告誡他要像曹仁那樣奉法爲將。",
            "zhs": "曹彰北征乌丸时，其兄曹丕尚在东宫，写信告诫他要像曹仁那样奉法为将。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "陶謙（恭祖）",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p2",
          "text": {
            "en": "Cao Ren crushed Tao Qian's forces at Pengcheng, and defeated the generals Tao Qian sent to relieve Fei, Hua, Jimo and Kaiyang.",
            "zht": "曹仁在彭城大破陶謙軍，又擊敗陶謙派去救援費、華、即墨、開陽等縣的將領。",
            "zhs": "曹仁在彭城大破陶谦军，又击败陶谦派去救援费、华、即墨、开阳等县的将领。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "呂由",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p2",
          "text": {
            "en": "Leading a separate force, Cao Ren defeated Tao Qian's general Lü You.",
            "zht": "曹仁率別軍擊破陶謙部將呂由。",
            "zhs": "曹仁率别军击破陶谦部将吕由。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "劉何",
      "type": "personal",
      "polarity": "negative",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p2",
          "text": {
            "en": "Cao Ren took Gouyang and captured Lü Bu's general Liu He alive.",
            "zht": "曹仁攻克句陽，生擒呂布部將劉何。",
            "zhs": "曹仁攻克句阳，生擒吕布部将刘何。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "張繡",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p2",
          "text": {
            "en": "Cao Ren overran the counties around Zhang Xiu, and when Zhang Xiu pursued the withdrawing army, Cao Ren rallied the troops to defeat him.",
            "zht": "曹仁攻掠張繡周邊各縣；張繡追擊撤軍時，曹仁激勵將士將他擊破。",
            "zhs": "曹仁攻掠张绣周边各县；张绣追击撤军时，曹仁激励将士将他击破。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "劉備（玄德）",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p3",
          "text": {
            "en": "Sent with cavalry against Liu Bei, who was rousing the counties south of Xu for Yuan Shao, Cao Ren drove him off and recovered all the revolted counties.",
            "zht": "劉備爲袁紹攻掠許都以南各縣，曹仁率騎兵出擊，打跑劉備，收復了全部叛縣。",
            "zhs": "刘备为袁绍攻掠许都以南各县，曹仁率骑兵出击，打跑刘备，收复了全部叛县。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "韓荀",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p3",
          "text": {
            "en": "Cao Ren crushed Yuan Shao's general Han Xun at Mount Jiluo, after which Yuan Shao dared not send out detached forces again.",
            "zht": "曹仁在雞洛山大破袁紹部將韓荀，袁紹從此不敢再分兵出擊。",
            "zhs": "曹仁在鸡洛山大破袁绍部将韩荀，袁绍从此不敢再分兵出击。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "史渙（公劉）",
      "type": "colleagues",
      "polarity": "positive",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p3",
          "text": {
            "en": "Cao Ren joined Shi Huan and others in raiding Yuan Shao's supply wagons and burning his grain.",
            "zht": "曹仁與史渙等人一同截擊袁紹的運糧車隊，燒燬其糧草。",
            "zhs": "曹仁与史涣等人一同截击袁绍的运粮车队，烧毁其粮草。"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "周瑜（公瑾）",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p4",
          "text": {
            "en": "Left to hold Jiangling, Cao Ren faced Zhou Yu's army of tens of thousands, and charged out himself to rescue Niu Jin from its vanguard.",
            "zht": "曹仁留守江陵，抵禦周瑜數萬大軍，並親自衝出城外，從其前鋒中救出牛金。",
            "zhs": "曹仁留守江陵，抵御周瑜数万大军，并亲自冲出城外，从其前锋中救出牛金。"
          }
        }
      ]
    },
    {
      "from": "牛金",
      "to": "曹仁（子孝）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p4",
          "text": {
            "en": "Cao Ren sent his unit commander Niu Jin with three hundred volunteers to challenge Zhou Yu's vanguard, and they were surrounded.",
            "zht": "曹仁派部曲將牛金率三百人出城挑戰周瑜的前鋒，結果被包圍。",
            "zhs": "曹仁派部曲将牛金率三百人出城挑战周瑜的前锋，结果被包围。"
          }
        },
        {
          "passageId": "ws9c-p5",
          "text": {
            "en": "Seeing Niu Jin about to be overwhelmed, Cao Ren rode out with a few dozen horsemen and charged twice into the enemy ranks to bring him and his men back.",
            "zht": "眼見牛金將被殲滅，曹仁率數十騎出城，兩度衝入敵陣，救出牛金及其部下。",
            "zhs": "眼见牛金将被歼灭，曹仁率数十骑出城，两度冲入敌阵，救出牛金及其部下。"
          }
        }
      ]
    },
    {
      "from": "陳矯（季弼）",
      "to": "曹仁（子孝）",
      "type": "service",
      "polarity": "positive",
      "directed": true,
      "notes": [
        {
          "passageId": "ws9c-p5",
          "text": {
            "en": "Cao Ren's Chief Clerk Chen Jiao tried to stop him riding out to save Niu Jin, then on his return exclaimed, \"General, you are truly divine!\"",
            "zht": "長史陳矯曾勸阻曹仁出城救援牛金，見他回來後感嘆道：“將軍真天人也！”",
            "zhs": "长史陈矫曾劝阻曹仁出城救援牛金，见他回来后感叹道：“将军真天人也！”"
          }
        }
      ]
    },
    {
      "from": "曹仁（子孝）",
      "to": "馬超（孟起）",
      "type": "personal",
      "polarity": "negative",
      "directed": false,
      "notes": [
        {
          "passageId": "ws9c-p6",
          "text": {
            "en": "As acting General Who Pacifies the West, Cao Ren held Tongguan and defeated Ma Chao south of the Wei River.",
            "zht": "曹仁代理安西將軍，督率諸將據守潼關，在渭南擊破馬超。",
            "zhs": "曹仁代理安西将军，督率诸将据守潼关，在渭南击破马超。"
          }
        }
      ]
    },
    {
