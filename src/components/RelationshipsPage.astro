---
// Relationships page: a per-chapter "mind map" of the people in a chapter and how they relate,
// with a narrow search column on the right. Shared by the en / zh-hans / zh-hant pages
// (src/pages/**/translations/sanguozhi/relationships.astro), which only pass `lang`.
//
// Data (read at build time, nothing is fetched):
//   - src/data/sgz/*.json  -> only chapters whose relationships use the new shape
//                             { from, to, type, polarity, directed, ancestral?, notes:[{passageId,text}] }
//   - src/data/persons.json -> the people registry (names in zht / zhs / en, courtesy names, aliases)
// See scripts/validate-relationships.mjs for the format and the direction convention.
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import ContactModal from './Contactmodal.astro';
import persons from '../data/persons.json';
import { t } from '../i18n/index.js';
import { url } from '../utils/url';

const { lang = 'en' } = Astro.props as { lang?: 'en' | 'zh-hans' | 'zh-hant' };
const strings = t(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
const chapterBase = url(`${prefix}/translations/sanguozhi`);
const mapBase = url(`${prefix}/maps/map-overall`);

const TEXT_TITLE = { en: 'Records of the Three Kingdoms', 'zh-hans': '三国志', 'zh-hant': '三國志' }[lang];

// UI text for this page (kept here rather than in src/i18n so the page is self-contained)
const UI = {
  en: {
    title: 'Relationships', translations: strings.nav.translations, readChapter: 'Read the chapter', readChapters: 'Read the chapters', chapter: 'Chapter',
    search: 'Search a person…', people: 'People', relations: 'relationships', noMatch: 'No one matches.',
    hint: 'Click a person or a line for details. Drag to move, scroll to zoom.',
    legendTypes: 'Type', legendTone: 'Polarity', showAncestors: 'Show ancestors', notes: 'Notes', seePassage: 'See biography', appointmentsUnder: 'Appointments under {lord} include:',
    arrowNote: 'Arrows point to the receiver — the child, the lord served, the person killed, praised or taught, or the successor.',
    courtesy: 'Courtesy name', ancestral: 'Ancestor (not a contemporary)', close: 'Close', fit: 'Fit', zoomIn: 'Zoom in', zoomOut: 'Zoom out', journey: 'Show life journey',
    types: { kinship: 'Kinship', personal: 'Friends & Foes', colleagues: 'Colleagues', service: 'Allegiance & Defiance' },
    tones: { positive: 'Positive', neutral: 'Neutral', negative: 'Negative', mixed: 'Mixed' },
    directed: 'directed', undirected: 'mutual', explore: 'Explore relationships', showRel: 'Show relationships',
  },
  'zh-hans': {
    title: '人物关系', translations: strings.nav.translations, readChapter: '阅读原文', readChapters: '阅读各篇章', chapter: '篇章',
    search: '搜索人物…', people: '人物', relations: '条关系', noMatch: '没有匹配的人物。',
    hint: '点击人物或连线查看详情；拖动可移动，滚轮可缩放。',
    legendTypes: '类型', legendTone: '倾向', showAncestors: '显示先祖', notes: '说明', seePassage: '查看人物传记', appointmentsUnder: '在{lord}麾下曾任：',
    arrowNote: '箭头指向子女、所效忠的主公、被杀、被称誉或被教导的人，或继任者。',
    courtesy: '字', ancestral: '先祖（非同时代人）', close: '关闭', fit: '适应窗口', zoomIn: '放大', zoomOut: '缩小', journey: '查看足迹',
    types: { kinship: '亲族', personal: '私交', colleagues: '同僚', service: '统属' },
    tones: { positive: '正面', neutral: '中性', negative: '负面', mixed: '毁誉参半' },
    directed: '有方向', undirected: '双向', explore: '人物关系', showRel: '查看人物关系',
  },
  'zh-hant': {
    title: '人物關係', translations: strings.nav.translations, readChapter: '閱讀原文', readChapters: '閱讀各篇章', chapter: '篇章',
    search: '搜尋人物…', people: '人物', relations: '條關係', noMatch: '沒有符合的人物。',
    hint: '點擊人物或連線查看詳情；拖動可移動，滾輪可縮放。',
    legendTypes: '類型', legendTone: '傾向', showAncestors: '顯示先祖', notes: '說明', seePassage: '查看人物傳記', appointmentsUnder: '在{lord}麾下曾任：',
    arrowNote: '箭頭指向子女、所效忠的主公、被殺、被稱譽或被教導的人，或繼任者。',
    courtesy: '字', ancestral: '先祖（非同時代人）', close: '關閉', fit: '適應視窗', zoomIn: '放大', zoomOut: '縮小', journey: '查看足跡',
    types: { kinship: '親族', personal: '私交', colleagues: '同僚', service: '統屬' },
    tones: { positive: '正面', neutral: '中性', negative: '負面', mixed: '毀譽參半' },
    directed: '有方向', undirected: '雙向', explore: '人物關係', showRel: '查看人物關係',
  },
}[lang];

// Chapters that already use the new relationship format
const mods = import.meta.glob('../data/sgz/*.json', { eager: true });
const allChapters = Object.values(mods)
  .map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => a.order - b.order);
const converted = allChapters.filter(
  (ch: any) => Array.isArray(ch.relationships) && ch.relationships.length > 0 && ch.relationships.every((r: any) => Array.isArray(r.notes))
);

// Slim per-chapter record (just id + subjects) — used only to resolve which chapter a
// person's own biography lives in, for the popup's biography/journey icons.
const chaptersData = converted.map((ch: any) => {
  const ids = new Set<string>();
  ch.relationships.forEach((r: any) => { ids.add(r.from); ids.add(r.to); });
  const subjects = (ch.journeyOverviews ?? []).map((o: any) => o.person).filter((id: string) => ids.has(id));
  return { id: ch.id, label: ch.label, subjects };
});

// Every converted chapter's people and relationships merged into one graph — people who
// appear in several chapters (e.g. Cao Cao) become a single shared node linking those
// chapters' clusters together. Each note keeps which chapter it came from, so its "See
// biography" link still points at the right page.
const nodesMap = new Map<string, any>();
const edgesList: any[] = [];
for (const ch of converted) {
  const ids = new Set<string>();
  ch.relationships.forEach((r: any) => { ids.add(r.from); ids.add(r.to); });
  for (const id of ids) {
    if (!nodesMap.has(id)) {
      const p = (persons as any)[id];
      nodesMap.set(id, { id, n: p.name, c: p.courtesyName, al: p.aliases ?? [], u: !!p.unnamed });
    }
  }
  for (const r of ch.relationships) {
    edgesList.push({
      a: r.from, b: r.to, t: r.type, p: r.polarity, d: r.directed, anc: !!r.ancestral,
      notes: r.notes.map((n: any) => ({ pid: n.passageId, x: n.text, ttl: n.title, ch: ch.id })),
    });
  }
}
const graph = { nodes: [...nodesMap.values()], edges: edgesList };

const clientData = JSON.stringify({ lang, chapterBase, mapBase, pageBase: `${chapterBase}/relationships`, ui: UI, chapters: chaptersData, graph }).replace(/</g, '\\u003c');
const footerQuote = strings.footer.quoteBySection?.translations ?? strings.footer.quote;
---

<Base title={`${UI.title} · ${TEXT_TITLE} · Three Kingdoms Archive`} lang={lang}>
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <div class="rel-main">
      <div class="page-header">
        <div class="breadcrumb">
          <a href={url(`${prefix}/translations`)} class="bc-link">{UI.translations}</a>
          <span class="bc-sep">›</span>
          <a href={chapterBase} class="bc-link">{TEXT_TITLE}</a>
          <span class="bc-sep">›</span>
          <span class="bc-cur">{UI.title}</span>
        </div>
      </div>

      <div class="rel-header">
        <div class="rel-title-group">
          <h1 class="rel-title" id="rel-title">{UI.title}</h1>
        </div>
        <div class="rel-header-actions">
          <a id="rel-read-link" class="rel-btn" href={chapterBase} target="_blank" rel="noopener">
            <i class="ti ti-book-2" aria-hidden="true"></i> {UI.readChapters}
          </a>
        </div>
      </div>

      <div class="rel-body">
        <div class="rel-canvas-wrap" id="rel-canvas-wrap">
          <div class="rel-stage" id="rel-stage">
          <svg id="rel-svg" class="rel-svg" role="img" aria-label={UI.title}>
            <defs id="rel-defs"></defs>
            <g id="rel-viewport">
              <g id="rel-edges"></g>
              <g id="rel-nodes"></g>
            </g>
          </svg>

          <div class="rel-panel" id="rel-panel">
            <div class="rel-panel-search">
              <i class="ti ti-search person-search-icon" aria-hidden="true"></i>
              <input type="text" id="rel-search" class="person-search-input" placeholder={UI.search} autocomplete="off" />
              <div class="rel-search-results" id="rel-search-results" hidden></div>
            </div>
            <div class="rel-legend" id="rel-legend"></div>
          </div>

          <div class="rel-controls">
            <button type="button" id="rel-zoom-in" class="rel-ctl" aria-label={UI.zoomIn}><i class="ti ti-plus" aria-hidden="true"></i></button>
            <button type="button" id="rel-zoom-out" class="rel-ctl" aria-label={UI.zoomOut}><i class="ti ti-minus" aria-hidden="true"></i></button>
            <button type="button" id="rel-fit" class="rel-ctl" aria-label={UI.fit}><i class="ti ti-focus-2" aria-hidden="true"></i></button>
          </div>

          <div class="rel-detail" id="rel-detail" hidden></div>
          <div class="rel-hint" id="rel-hint">{UI.hint}</div>
          </div>
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <span class="footer-quote">{footerQuote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<script type="application/json" id="rel-data" set:html={clientData}></script>

<script>
// @ts-nocheck
const DATA = JSON.parse(document.getElementById('rel-data').textContent || '{}');
const LANG = DATA.lang;
const UI = DATA.ui;
const NAME = LANG === 'en' ? 'en' : LANG === 'zh-hans' ? 'zhs' : 'zht';
const isZh = LANG !== 'en';

// personId -> id of the (loaded) chapter that person is a biography subject of, so the
// popup can link straight to their own passage rather than just the currently-viewed one.
const bioChapterOf = new Map();
for (const ch of DATA.chapters) for (const pid of ch.subjects) if (!bioChapterOf.has(pid)) bioChapterOf.set(pid, ch.id);

// ------------------------------------------------------------------ look
// colour = polarity, full stop — whether the edge is directed or not (shown separately by
// the arrowhead). Colleagues and personal relationships are mostly undirected but still have
// a real polarity (praise vs. a strained rivalry), so direction must not override that.
const TONE = { positive: '#4f7fb0', neutral: '#857f72', negative: '#b5533f' };   // ink blue / grey / vermilion
const GOLD = '#d0aa6b';
const BG = '#0d0d0d';
const TYPES = ['service', 'colleagues', 'personal', 'kinship'];
const TONES = ['positive', 'neutral', 'negative'];   // real, solid colours — drives marker creation
// "mixed" isn't a colour of its own — a relationship that's genuinely both (Yu Jin's decades of
// trust under Cao Cao ending in a rebuke, or Zhang He's advice ignored by Sima Yi to fatal
// effect) renders as a half-and-half split of the two tones rather than picking one dominant
// side and losing the other. Never index TONE[] with 'mixed' directly.
const toneSwatchCSS = (tone) => (tone === 'mixed' ? `linear-gradient(90deg, ${TONE.positive} 50%, ${TONE.negative} 50%)` : TONE[tone]);
// line style per type: double solid line (kinship — never arrowed, since "who begat whom"
// doesn't need a direction cue, and blood ties are the most permanent/certain bond here so
// they get the boldest treatment), solid (personal/friends & foes), dashed (service/
// allegiance — the type most likely to converge in bulk on a lord's hub node, so it stays
// light rather than compounding into a wall of double lines), dotted (colleagues).
function lineStyle(type) {
  switch (type) {
    case 'kinship': return { w: 1.1, dash: '', cap: 'butt', rails: 2.6 };
    case 'service': return { w: 1.4, dash: '8 6', cap: 'butt' };
    case 'colleagues': return { w: 1.7, dash: '0.1 6', cap: 'round' };
    default: return { w: 1.4, dash: '', cap: 'butt' };
  }
}
const SVGNS = 'http://www.w3.org/2000/svg';
const $ = (id) => document.getElementById(id);
const svg = $('rel-svg'), gViewport = $('rel-viewport'), gEdges = $('rel-edges'), gNodes = $('rel-nodes'), defs = $('rel-defs');
const wrap = $('rel-stage');
const panel = $('rel-panel');
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const el = (name, attrs = {}, parent) => { const e = document.createElementNS(SVGNS, name); for (const k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; };
const label = (obj) => (obj ? (obj[NAME] || obj.en || obj.zht || '') : '');
// the "other" language for a name — Chinese when the page is English, English otherwise
const otherLabel = (obj) => (obj ? (NAME === 'en' ? obj.zht : obj.en) || '' : '');
// The in-circle character's own font-size scales with the node's radius (so a small,
// peripheral person's character is smaller too, not the same fixed size as a subject's).
// Its opacity then ramps smoothly with on-screen size, from invisible up to fully legible
// at ZH_FADE_FULL_PX — a gradual reveal rather than a hard pop-in — and bigger circles
// reach full visibility at a lower zoom than small ones, instead of everyone together.
const ZH_FADE_START_PX = 6;
const ZH_FADE_FULL_PX = 11;
function zhFontSize(n) { return Math.max(7, radius(n) * 0.62); }

// ------------------------------------------------------------------ state
let nodesById = new Map();
let edges = [];
let view = { x: 0, y: 0, k: 1 };
let hiddenTypes = new Set(), hiddenTones = new Set(), showAncestors = false;
let selected = null;         // { kind: 'node'|'edge', ref }
let alpha = 0, raf = 0;

// arrowheads: a full triangle per tone (single-line edges), plus a mirrored half-arrow pair
// per tone for any double-line (rails) edge type that turns out to be directed — one barb on
// each rail, so together they read as one arrowhead instead of two separate lines just
// stopping dead. (Kinship is the only rails type today and it's never arrowed, but the pair
// is kept generic rather than hardcoded to one type.)
// All sized in world units (markerUnits=userSpaceOnUse) like everything else in the graph, so
// render() rescales markerWidth/Height by 1/view.k each frame — otherwise, combined with the
// edges' non-scaling stroke, the arrowhead would grow larger relative to the now-constant-
// width line at every zoom step instead of staying visually proportionate to it.
const ARROW_SIZE = 9;
const ARROW_SIZE_OVERVIEW = 4.5;
const arrowMarkers = {};
function makeMarker(id, innerHtml) {
  const m = el('marker', { id, viewBox: '0 0 10 10', refX: '9', refY: '5', markerWidth: String(ARROW_SIZE), markerHeight: String(ARROW_SIZE), markerUnits: 'userSpaceOnUse', orient: 'auto' }, defs);
  m.innerHTML = innerHtml;
  arrowMarkers[id] = m;
}
for (const tone of TONES) {
  makeMarker('arr-' + tone, `<path d="M0,1.5 L10,5 L0,8.5 z" fill="${TONE[tone]}" fill-opacity="0.8"/>`);
  makeMarker('arr-half-a-' + tone, `<path d="M1,1.4 L9,5" fill="none" stroke="${TONE[tone]}" stroke-opacity="0.8" stroke-width="1.6" stroke-linecap="round"/>`);
  makeMarker('arr-half-b-' + tone, `<path d="M1,8.6 L9,5" fill="none" stroke="${TONE[tone]}" stroke-opacity="0.8" stroke-width="1.6" stroke-linecap="round"/>`);
}

// ------------------------------------------------------------------ graph loading (once — every converted chapter merged together, no per-chapter switching)
const allSubjects = new Set(DATA.chapters.flatMap((c) => c.subjects));
function loadGraph() {
  const raw = DATA.graph;
  nodesById = new Map(raw.nodes.map((n) => [n.id, { ...n, x: 0, y: 0, vx: 0, vy: 0, deg: 0, subject: allSubjects.has(n.id), pinned: false }]));
  edges = raw.edges.map((e, i) => ({ ...e, i, u: nodesById.get(e.a), v: nodesById.get(e.b) }));
  for (const e of edges) { e.u.deg++; e.v.deg++; }
  // group edges of the same pair, so parallel lines can be fanned out
  const groups = new Map();
  for (const e of edges) { const k = [e.a, e.b].sort().join('||'); (groups.get(k) || groups.set(k, []).get(k)).push(e); }
  for (const g of groups.values()) g.forEach((e, idx) => { e.slot = idx - (g.length - 1) / 2; e.canon = e.a < e.b; });
  selected = null;
  hiddenTypes = new Set(); hiddenTones = new Set(); showAncestors = false;
  initPositions();
  setGravity();
  simulate(560);
  reduceCrossings();
  buildScene();
  buildLegend();
  $('rel-search').value = '';
  $('rel-search-results').hidden = true;
  hideDetail();
  fitView();
}

// ------------------------------------------------------------------ layout: mind-map start + force relaxation
const SECTOR = { service: -Math.PI / 2, kinship: Math.PI, colleagues: 0, personal: Math.PI / 2 };   // where each type fans out from the centre
function initPositions() {
  const nodes = [...nodesById.values()];
  // With many biography subjects merged into one graph, the most-connected person (usually
  // the shared overlord) makes a far better hub than picking an arbitrary one of them.
  const centre = nodes.slice().sort((a, b) => b.deg - a.deg)[0];
  const adj = new Map(nodes.map((n) => [n.id, []]));
  for (const e of edges) { adj.get(e.a).push({ to: e.b, e }); adj.get(e.b).push({ to: e.a, e }); }
  const prio = { service: 0, kinship: 1, colleagues: 2, personal: 3 };
  const level = new Map([[centre.id, 0]]), kind = new Map(), children = new Map();
  const queue = [centre.id];
  while (queue.length) {
    const id = queue.shift();
    const kids = [];
    for (const { to, e } of adj.get(id).slice().sort((x, y) => prio[x.e.t] - prio[y.e.t])) {
      if (level.has(to)) continue;
      level.set(to, level.get(id) + 1); kind.set(to, id === centre.id ? e.t : kind.get(id)); queue.push(to);
      kids.push(to);
    }
    children.set(id, kids);
  }
  // nodes the BFS never reached (their only edges are to already-visited nodes, or they're
  // isolated) still need a slot — hang them straight off the centre in the personal sector.
  const orphans = nodes.filter((n) => !level.has(n.id)).map((n) => n.id);
  for (const id of orphans) { level.set(id, 1); kind.set(id, 'personal'); children.set(id, []); }
  if (orphans.length) children.set(centre.id, [...(children.get(centre.id) || []), ...orphans]);

  // A proper radial tree: each node gets an angular slice *within its parent's own slice*,
  // sized by how many descendants it has — not a flat index position in a type-wide list.
  // That's what keeps e.g. a grandchild next to its actual parent instead of wherever its
  // sort rank in the whole "service" bucket happens to fall.
  const subtreeSize = new Map();
  function sizeOf(id) {
    if (subtreeSize.has(id)) return subtreeSize.get(id);
    const kids = children.get(id) || [];
    const size = kids.length ? kids.reduce((s, k) => s + sizeOf(k), 0) : 1;
    subtreeSize.set(id, size);
    return size;
  }
  sizeOf(centre.id);

  centre.x = 0; centre.y = 0;
  const RADIUS_STEP = 230;
  function place(kidsIds, angleStart, angleEnd, depth) {
    const total = kidsIds.reduce((s, id) => s + sizeOf(id), 0) || 1;
    let a = angleStart;
    kidsIds.forEach((id, i) => {
      const width = (angleEnd - angleStart) * (sizeOf(id) / total);
      const mid = a + width / 2;
      const n = nodesById.get(id);
      const r = 340 + RADIUS_STEP * depth + (sizeOf(id) === 1 ? (i % 2) * 40 : 0);
      n.x = Math.cos(mid) * r; n.y = Math.sin(mid) * r;
      place(children.get(id) || [], a, a + width, depth + 1);
      a += width;
    });
  }
  const topKids = children.get(centre.id) || [];
  const bySector = new Map();
  for (const id of topKids) { const k = kind.get(id) || 'personal'; (bySector.get(k) || bySector.set(k, []).get(k)).push(id); }
  for (const [k, ids] of bySector) {
    const weight = ids.reduce((s, id) => s + sizeOf(id), 0);
    const band = Math.min(Math.PI * 0.94, 0.55 + 0.28 * Math.sqrt(weight));
    place(ids, SECTOR[k] - band / 2, SECTOR[k] + band / 2, 1);
  }
}
function visibleEdge(e) {
  // a mixed edge is both blue and red, so it only disappears once both are switched off
  const toneHidden = e.p === 'mixed' ? hiddenTones.has('positive') && hiddenTones.has('negative') : hiddenTones.has(e.p);
  return !hiddenTypes.has(e.t) && !toneHidden && (showAncestors || !e.anc);
}
// A mixed-polarity edge's stroke is a per-edge gradient (its coordinates are kept in sync with
// the edge's own endpoints every render(), same as the path `d`), not a plain hex colour.
function edgeColor(e) { return e.p === 'mixed' ? `url(#edge-grad-${e.i})` : TONE[e.p]; }
// How "substantial" a person is: well-connected, has a courtesy name, has their own
// biography/journey — drives both node size and how much room their edges get, so minor
// figures (one connection, no courtesy name, no biography) shrink and pull in close instead
// of claiming the same visual weight as a well-documented hub.
function importance(n) {
  const degScore = Math.min(1, Math.sqrt(n.deg || 0) / 5);
  return Math.min(1, degScore + (n.subject ? 0.5 : 0) + (n.c ? 0.15 : 0));
}
function radius(n) { return n.subject ? 21 : 7 + importance(n) * 11; }
function tick(a) {
  const nodes = [...nodesById.values()];
  for (let i = 0; i < nodes.length; i++) {
    const p = nodes[i];
    for (let j = i + 1; j < nodes.length; j++) {
      const q = nodes[j];
      let dx = q.x - p.x, dy = q.y - p.y, d2 = dx * dx + dy * dy;
      if (d2 < 1) { dx = Math.random() - 0.5; dy = Math.random() - 0.5; d2 = 1; }
      // busy people get a wide berth (their many lines need room to fan out); a pair of
      // barely-connected ones can sit close and still read as two separate dots
      const dp = Math.sqrt(p.deg || 1), dq = Math.sqrt(q.deg || 1);
      const d = Math.sqrt(d2), min = radius(p) + radius(q) + 70 + 24 * (dp + dq);
      let f = (42000 * a * Math.min(3.6, 0.5 + 0.28 * dp * dq)) / d2;
      if (d < min) f += (min - d) * 0.35 * a;
      const fx = (dx / d) * f, fy = (dy / d) * f;
      p.vx -= fx; p.vy -= fy; q.vx += fx; q.vy += fy;
    }
  }
  for (const e of edges) {
    const p = e.u, q = e.v; const dx = q.x - p.x, dy = q.y - p.y; const d = Math.sqrt(dx * dx + dy * dy) || 1;
    // minor figures (low importance on either end) don't need as much personal space — only
    // edges between two well-documented people get the full-length spring.
    const rest = restLength(e), f = (d - rest) * 0.028 * a;
    const fx = (dx / d) * f, fy = (dy / d) * f;
