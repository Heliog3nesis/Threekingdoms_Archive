---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import ContactModal from '../../../components/Contactmodal.astro';
import { t } from '../../../i18n/index.js';
import { buildAllPositions } from '../../../scripts/translations/build-officials-index.js';
import { url } from '../../../utils/url';

const lang = 'zh-hant';
const strings = t(lang);
const s = strings.officials;

const allPositions = buildAllPositions().map((position) => ({
  ...position,
  url: position.url.startsWith('/')
    ? `/zh-hant${position.url}`
    : position.url,
}));

const categories = [
  {
    id: 'ministers',
    pageId: 'ministers',
    label: { en: 'Excellencies & Ministers', zht: '公卿', zhs: '公卿' },
    excerpt: { en: 'Three Excellencies, Nine Ministers...', zht: '上公，三公，九卿等...', zhs: '上公，三公，九卿等...' },
    seal: '/thumbs/excellencies_seal.svg',
  },
  {
    id: 'departments',
    pageId: 'departments',
    label: { en: 'Departments', zht: '臺省', zhs: '台省' },
    excerpt: { en: 'Attendants, Imperial Secretariat...', zht: '尚書臺，門下省，御史台等...', zhs: '尚书台，门下省，御史台等...' },
    seal: '/thumbs/department_seal.svg',
  },
  {
    id: 'military',
    pageId: 'military',
    label: { en: 'Military', zht: '武官', zhs: '武官' },
    excerpt: {  en: 'Generals, Commandants...', zht: '城門，將軍，校尉，都尉等...', zhs: '城门，将军，校尉，都尉等...' },
    seal: '/thumbs/military_seal.svg',
  },
  {
    id: 'regional',
    pageId: 'regional',
    label: { en: 'Regional Administration', zht: '地方', zhs: '地方' },
    excerpt: { en: 'Inspectors, Grand Administrators...', zht: '刺史，太守，縣令，鄉亭等...', zhs: '刺史，太守，县令，乡亭等...' },
    seal: '/thumbs/regional_seal.svg',
  },
  {
    id: 'household',
    pageId: 'household',
    label: { en: 'Imperial Household', zht: '東/后宮', zhs: '東/后宮' },
    excerpt: { en: 'Crown Prince, Empress...', zht: '太子，太后，皇后', zhs: '太子，太后，皇后' },
    seal: '/thumbs/household_seal.svg',
  },
  {
    id: 'nobility',
    pageId: 'nobility',
    label: { en: 'Nobility (WIP)', zht: '爵位（待整理）', zhs: '爵位（待整理)' },
    excerpt: { en: 'Marquis and others', zht: '列侯，五等爵', zhs: '列侯，五等爵' },
    seal: '/thumbs/nobility_seal.svg',
  },
];

function toRoman(num: number): string {
  const romanMap: [number, string][] = [
    [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let result = '';
  let n = num;
  for (const [value, symbol] of romanMap) {
    while (n >= value) {
      result += symbol;
      n -= value;
    }
  }
  return result;
}

function utf8ToBase64(str: string): string {
  const bytes = new TextEncoder().encode(str);
  let binary = '';
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary);
}
const officialsPayload = utf8ToBase64(JSON.stringify({ allPositions, categories, lang }));
---

<Base title={`三國職官表 · ${strings.siteTitle}`} lang="zh-hant">
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <div class="page-header">
      <div class="breadcrumb">
        <a href={url('/zh-hant/translations')} class="bc-link">{strings.nav.translations}</a>
        <span class="bc-sep">›</span>
        <span class="bc-cur">{s.title}</span>
      </div>
      <h1 class="page-title">{s.title}</h1>
      <p class="page-sub">{s.subtitle}</p>
    </div>

    <!-- SEARCH BAR — always visible -->
    <div class="search-bar">
      <div class="search-box">
        <input
          class="search-input"
          id="search-input"
          type="text"
          placeholder={s.searchPlaceholder}
          autocomplete="off"
        />
        <button class="search-clear" id="search-clear" style="display:none;">✕</button>
        <button class="search-btn" id="search-btn">{s.searchBtn}</button>
      </div>
      <div class="search-dropdown" id="search-dropdown" style="display:none;">
        <div class="dropdown-warning" id="search-dropdown-warning" style="display:none;"></div>
        <div class="dropdown-list" id="search-dropdown-list"></div>
        <button class="dropdown-more" id="search-dropdown-more" style="display:none;"></button>
      </div>
    </div>

    <!-- TABS — desktop -->
    <div class="tabs" id="tabs">
      <button class="tab active" data-tab="browse">{s.tabs.browse}</button>
      <button class="tab" data-tab="background">{s.tabs.background}</button>
      <button class="tab" data-tab="salary">{s.tabs.salary}</button>
      <button class="tab" data-tab="glossary">{s.tabs.glossary}</button>
    </div>

    <!-- TABS — mobile dropdown -->
    <div class="tab-dropdown">
      <select class="tab-select" id="tab-select">
        <option value="browse">{s.tabs.browse}</option>
        <option value="background">{s.tabs.background}</option>
        <option value="salary">{s.tabs.salary}</option>
        <option value="glossary">{s.tabs.glossary}</option>
      </select>
    </div>

    <!-- BROWSE TAB -->
     <div class="panels-wrapper">
    <div class="panel" id="panel-browse">
      <div class="cat-grid">
        {categories.map((cat, i) => (
          <a href={url(`/zh-hant/translations/officials/${cat.id}`)} class="cat-card">
            <div class="cat-card-top">
              <span class="cat-numeral">{toRoman(i + 1)}</span>
              <img src={url(cat.seal ?? '/thumbs/seal_icon.svg')} alt="" class="cat-seal" />
            </div>
            <div class="cat-divider"></div>
            <div class="cat-name">{cat.label.zht}</div>
            <div class="cat-excerpt">{cat.excerpt.zht}</div>
            <span class="cat-browse">{s.tabs.browse} <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
          </a>
        ))}
      </div>
    </div>

    <!-- BACKGROUND TAB -->
    <div class="panel" id="panel-background" style="display:none;">
      <div class="background-layout">
        <div class="background-prose">
          <p>本官職彙編主要整合自清代學者洪飴孫的《三國職官表》，並參酌相關權威著作。</p>
          <p>英譯名之選取擬定僅為個人考量，亦參照了諸多中譯英著作。</p>
        </div>
        <div class="background-rail">
          <div class="background-rail-group">
            <div class="background-rail-label">中文參考著作</div>
            <div class="background-rail-item">呂宗力，《中國歷代官制大辭典》</div>
            <div class="background-rail-item">洪武雄，《蜀漢職官表蜀漢部份考釋》</div>
            <div class="background-rail-item">楊晨，《三國會要》</div>
          </div>
          <div class="background-rail-group">
            <div class="background-rail-label">英文翻譯著作</div>
            <div class="background-rail-item">《漢代官名英譯》（華盛頓大學）</div>
            <div class="background-rail-item">張磊夫 （Rafe de Crespigny），《漢代官制辭典》</div>
            <div class="background-rail-item">魯惟一（Michael Loewe），《秦、前漢與新莽時期官制辭典》</div>
            <div class="background-rail-item">賀凱（Charles Hucker），《中國古代官名辭典》</div>
          </div>
        </div>
      </div>
    </div>

    <!-- SALARY TAB -->
    <div class="panel" id="panel-salary" style="display:none;"></div>

    <!-- GLOSSARY TAB -->
    <div class="panel" id="panel-glossary" style="display:none;"></div>
  </div>

    <footer class="site-footer">
      <span class="footer-quote">{strings.footer.quoteBySection?.translations ?? strings.footer.quote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<div id="officials-data" data-payload={officialsPayload} style="display:none;"></div>

<script>
  // @ts-nocheck
  import { initSearch } from '../../../scripts/translations/search-module.js';
  import { renderSalaryTab, renderGlossaryTab } from '../../../scripts/translations/tab-content-renderers.js';

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const officialsDataEl = document.getElementById('officials-data');
  const payload = officialsDataEl.dataset.payload || '';
  const binaryStr = atob(payload);
  const bytes = Uint8Array.from(binaryStr, c => c.charCodeAt(0));
  const jsonStr = new TextDecoder('utf-8').decode(bytes);
  const { allPositions, categories, lang } = JSON.parse(jsonStr || '{}');
  const langKey = lang === 'zh-hant' ? 'zht' : lang === 'zh-hans' ? 'zhs' : 'en';

  const tabSelect   = document.getElementById('tab-select');

  const panels = {
    browse:     document.getElementById('panel-browse'),
    background: document.getElementById('panel-background'),
    salary:     document.getElementById('panel-salary'),
    glossary:   document.getElementById('panel-glossary'),
  };

  let activeTab = 'browse';
  let salaryRendered = false;
  let glossaryRendered = false;

  function showTab(tab) {
    activeTab = tab;
    Object.values(panels).forEach(p => p.style.display = 'none');
    panels[tab].style.display = 'block';
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.toggle('active', t.dataset.tab === tab);
    });
    tabSelect.value = tab;

    if (tab === 'salary' && !salaryRendered) {
      panels.salary.innerHTML = renderSalaryTab(langKey);
      salaryRendered = true;
    }
    if (tab === 'glossary' && !glossaryRendered) {
      panels.glossary.innerHTML = renderGlossaryTab(langKey);
      glossaryRendered = true;
    }
  }

  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => showTab(tab.dataset.tab));
  });

  tabSelect.addEventListener('change', () => showTab(tabSelect.value));

  function goToResults(query) {
    if (!query.trim()) return;
    window.open(`${base}/zh-hant/translations/search?q=${encodeURIComponent(query.trim())}`, '_blank');
  }

  const { searchPositions } = initSearch({
    allPositions,
    categories,
    lang,
    onShowResults: goToResults,
    onClearResults: () => {},
  });

  document.getElementById('search-btn').addEventListener('click', () => {
    const query = document.getElementById('search-input').value;
    goToResults(query);
  });
</script>

<style is:global>
.site { max-width: 100%; background: var(--color-bg); min-height: 100vh; display: flex; flex-direction: column;}

.page-header { padding: 2rem 2rem 1.75rem; border-bottom: 0.5px solid var(--color-border);}
.breadcrumb { display: flex; align-items: center; gap: 6px; margin-bottom: 0.75rem; }
.bc-link { font-size: 15px; color: var(--color-text-tertiary); text-decoration: none; }
.bc-link:hover { color: var(--color-text-secondary); }
.bc-sep { font-size: 14px; color: var(--color-text-tertiary); }
.bc-cur { font-size: 16px; color: var(--color-text-secondary); }
.page-title {
  font-family: 'Noto Serif TC', serif;
  font-size: 42px; font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 4px;
}
.page-sub { font-family: 'LXGW WenKai', serif; font-size: 20px; color: var(--color-text-secondary); }

/* SEARCH */
.search-bar {
padding: 1.25rem 2rem;
border-bottom: 0.5px solid var(--color-border);
background:
  linear-gradient(to bottom,  rgba(255,255,255,0.02), rgba(255,255,255,0.01));
}
.search-box {display: flex; gap: 10px; align-items: center;
}
.search-input {
  flex: 1; background: rgba(255,255,255,0.015);
  border: 0.5px solid rgba(196,154,86,0.20);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  color: var(--color-text-primary);
  font-size: 17px;
  outline: none;
  font-family: 'LXGW WenKai', serif;
  transition:
   border-color .2s,
   box-shadow .2s,
   background .2s;
}
.search-input:focus{
  border-color: rgba(196,154,86,.55);
  box-shadow: 0 0 0 1px rgba(196,154,86,.15);
  background: rgba(255,255,255,.02);
}
.search-btn {
  background: linear-gradient( to bottom, #8f6b34, #725426);
  color: #f2eadc;
  border: 1px solid rgba(209,173,98,.25);
  border-radius: var(--radius-md);
  padding: 11px 22px;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: .02em;
  cursor: pointer;
  transition: .2s;
}
.search-btn:hover { background:linear-gradient(to bottom, #a47b3f, #82602d );

    transform: translateY(-1px); }
.search-clear { background: var(--color-bg); color: var(--color-text-secondary); border: 0.5px solid var(--color-border); border-radius: var(--radius-md); padding: 10px 14px; font-size: 15px; cursor: pointer; }

/* SEARCH DROPDOWN */
.search-dropdown { position: relative; margin-top: 6px; background: var(--color-bg); border: 0.5px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
.dropdown-warning { font-size: 15px; color: darkkhaki; padding: 8px 14px; border-bottom: 0.5px solid var(--color-border); background: var(--color-bg-secondary); }
.dropdown-list { display: flex; flex-direction: column; max-height: 360px; overflow-y: auto; }
.dropdown-item { display: flex; align-items: center; gap: 10px; padding: 9px 14px; text-decoration: none; border-bottom: 0.5px solid var(--color-border); transition: background 0.15s; }
.dropdown-item:last-child { border-bottom: none; }
.dropdown-item:hover { background: var(--color-bg-secondary); }
.dropdown-item-grade { width: 25px; height: 25px; border-radius: 50%; background: var(--color-bg-secondary); color: var(--color-text-secondary); font-size: 11px; font-weight: 500; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.dropdown-item-grade-empty { color: var(--color-text-tertiary); }
.dropdown-item-main { display: flex; align-items: baseline; gap: 8px; min-width: 0; flex: 1; }
.dropdown-item-name { font-size: 17px; font-weight: 500; color: var(--color-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dropdown-item-zh { font-size: 15px; color: var(--color-text-tertiary); white-space: nowrap; flex-shrink: 0; }
.dropdown-item-cat { font-size: 15px; padding: 2px 8px; border-radius: 20px; background: var(--color-bg-secondary); color: var(--color-text-tertiary); flex-shrink: 0; }
.dropdown-empty { padding: 16px; font-size: 13px; color: var(--color-text-tertiary); text-align: center; }
.dropdown-more { width: 100%; text-align: center; padding: 9px 14px; font-size: 16px; color: var(--map-teal-text); background: var(--color-bg-secondary); border: none; border-top: 0.5px solid var(--color-border); cursor: pointer; }
.dropdown-more:hover { opacity: 0.85; }

/* TABS */
.tabs { display: flex; border-bottom: 0.5px solid var(--color-border); }
.tab { font-size: 19px; padding: 10px 16px; color: var(--color-text-secondary); cursor: pointer; border-bottom: 2px solid transparent; background: none; border-top: none; border-left: none; border-right: none; font-family: 'LXGW WenKai', serif; transition: color 0.15s; }
.tab:hover { color: var(--color-text-primary); }
.tab.active { color: var(--color-text-primary); border-bottom-color: var(--color-text-primary); }
.tab.faded { color: var(--color-text-tertiary); opacity: 0.4; pointer-events: none; }
.tab-dropdown { display: none; }

/* PANELS */
.panel { padding: 1.5rem 2rem}
.panels-wrapper { flex: 1}

/* CATEGORY GRID */
.cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }

.cat-card {
  background: var(--color-bg-secondary);
  border: 0.5px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.5rem 1.75rem;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-height: 200px;
  transition: background 0.15s, transform 0.15s;
}
.cat-card:hover { background: #1a1a1a; transform: translateY(-1px); }

.cat-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.cat-numeral {
  font-family: 'Cormorant Garamond', serif;
  font-size: 29px;
  font-weight: 600;
  color: var(--archive-gold-soft, #d0aa6b);
}

.cat-seal {
  width: 72px;
  height: 72px;
  object-fit: contain;
  opacity: 0.5;
}

.cat-divider {
  width: 28px;
  height: 1px;
  background: var(--color-border);
  margin: 4px 0 1rem;
}

.cat-name {
  font-family: 'Noto Serif TC', serif;
  font-size: 35px;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 2px;
}

.cat-excerpt {
  font-family: 'LXGW WenKai', serif;
  font-size: 18px;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  flex: 1;
}

.cat-browse {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 16px;
  font-weight: 500;
  color: var(--archive-gold-soft, #d0aa6b);
  margin-top: 1rem;
}
.cat-browse i { font-size: 18px; }

/* BACKGROUND TAB — prose + citation rail */
.background-layout { display: flex; flex-direction: column; gap: 1.5rem; max-width: 1200px; }
.background-prose p { font-family: 'LXGW WenKai', serif; font-size: 17px; line-height: 1.75; color: var(--color-text-secondary); margin: 0 0 1rem; }
.background-prose p:last-child { margin-bottom: 0; }
.background-rail { border-top: 0.5px solid var(--color-border); padding-top: 1rem; }
.background-rail-group { margin-bottom: 1rem; }
.background-rail-group:last-child { margin-bottom: 0; }
.background-rail-label { font-size: 18px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-tertiary); margin-bottom: 8px; }
.background-rail-item { font-family: 'LXGW WenKai', serif; font-size: 16px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 6px; }
.background-rail-item:last-child { margin-bottom: 0; }

@media (min-width: 900px) {
  .background-layout { flex-direction: row; align-items: flex-start; max-width: none; }
  .background-prose { flex: 1; max-width: 920px; }
  .background-rail { border-top: none; border-left: 0.5px solid var(--color-border); padding-top: 0; padding-left: 1.5rem; max-width: 600px; flex-shrink: 0; }
}

/* SALARY TAB */
.salary-tab { max-width: 100%; }
.salary-title { font-size: 28px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 0.5rem; }
.salary-intro { font-size: 17px; color: var(--color-text-secondary); line-height: 1.65; margin-bottom: 1rem; }
.salary-estimated { color: var(--map-teal-text); }
.salary-footnoted { text-decoration: underline; }
.salary-alternate { color: var(--trans-purple-text); }

.salary-legend-mobile { display: none; }
.salary-legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 15px; color: var(--color-text-secondary); padding: 8px 12px; background: var(--color-bg-secondary); border: 0.5px solid var(--color-border); border-radius: var(--radius-md); }
.salary-legend-item { display: inline-flex; align-items: center; gap: 5px; }
.salary-legend-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.salary-footnoted-sample { background: var(--color-text-secondary); text-decoration: none; }
.salary-estimated-sample { background: var(--map-teal-text); }
.salary-alternate-sample { background: var(--trans-purple-text); }

.salary-table-wrap { display: block; overflow-x: auto; }
.salary-table { width: 100%; border-collapse: collapse; font-size: 17px; }
.salary-table th, .salary-table td { padding: 8px 10px; border-bottom: 0.5px solid var(--color-border); text-align: left; white-space: nowrap; }
.salary-table th { background: var(--color-bg-secondary); font-weight: 500; position: sticky; top: 0; z-index: 2; white-space: normal; vertical-align: top; }
.salary-th-label { display: block; }
.salary-th-sub { display: block; font-weight: 400; font-size: 16px; color: var(--color-text-tertiary); margin-top: 2px; white-space: nowrap; }
.salary-table th sup { font-weight: 400; letter-spacing: 0.5px; }
.salary-table tbody tr:nth-child(even) { background: rgba(255,255,255,0.02); }

.salary-cards { display: none; }
.salary-card { border: 0.5px solid var(--color-border); border-radius: var(--radius-lg); padding: 12px 14px; margin-bottom: 8px; }
.salary-card-rank { font-weight: 500; font-size: 16px; margin-bottom: 8px; }
.salary-card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 14px; }
.salary-card-label { color: var(--color-text-tertiary); margin-bottom: 2px; }

.salary-footnotes { margin-top: 1.25rem; font-size: 15px; color: var(--color-text-tertiary); line-height: 1.7; }
.salary-footnote-line { margin-bottom: 4px; }

@media (max-width: 800px) {
  .salary-legend-mobile { display: block; margin-bottom: 1rem; position: sticky; top: 70px; z-index: 5; }
  .salary-table-wrap { display: none; }
  .salary-cards { display: block; }
}

/* GLOSSARY TAB */
.glossary-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 2.5rem;
  align-items: start;
}

.glossary-main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 2rem;
  gap: 1.5rem;
  min-width: 0;
}

.glossary-aside {
  position: sticky;
  top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.glossary-info {
  display: flex;
  gap: 10px;
  align-items: flex-start;
