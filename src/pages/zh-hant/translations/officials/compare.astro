---
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../components/Nav.astro';
import ContactModal from '../../../../components/Contactmodal.astro';
import { t } from '../../../../i18n/index.js';
import { url } from '../../../../utils/url';
import '../../../../scripts/translations/officials.css';
import '../../../../scripts/translations/compare.css';

const lang = 'zh-hant';
const strings = t(lang);
const s = strings.officials;
---

<Base title={`官職比較 · ${strings.siteTitle}`} lang="zh-hant">
  <div class="site" data-lang={lang}>
    <Nav lang={lang} strings={strings} />

    <div class="page-header">
      <div class="breadcrumb">
        <a href={url('/zh-hant/translations')} class="bc-link">{strings.nav.translations}</a>
        <span class="bc-sep">›</span>
        <a href={url('/zh-hant/translations/officials')} class="bc-link">{s.title}</a>
        <span class="bc-sep">›</span>
        <span class="bc-cur">比較</span>
      </div>
      <h1 class="page-title">官職比較</h1>
      <p class="page-sub">並列比較，最多四項</p>
    </div>

    <div class="cmp-toolbar">
      <div class="cmp-picker">
        <input type="text" id="cmp-input" class="search-input" placeholder="加入官職，如：太尉、Grand Commandant……" autocomplete="off" />
        <div class="cmp-dropdown" id="cmp-dropdown"></div>
        <div class="cmp-msg" id="cmp-msg"></div>
      </div>
      <button class="cmp-clear" id="cmp-clear" type="button">全部清除</button>
    </div>

    <div class="cmp-body">
      <div class="cmp-empty" id="cmp-empty" style="display:none;">
        <div class="cmp-empty-title">尚無比較項目</div>
        <p>可於上方檢索，或在任一官職點「比較」加入，最多四項。</p>
      </div>
      <div id="cmp-root"></div>
    </div>

    <footer class="site-footer">
      <span class="footer-quote">{strings.footer.quoteBySection?.translations ?? strings.footer.quote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<script>
  import '../../../../scripts/translations/compare-module.js';
</script>
