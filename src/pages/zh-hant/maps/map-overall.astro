---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import ContactModal from '../../../components/Contactmodal.astro';
import { t } from '../../../i18n/index.js';
import { provinceData } from '../../../data/officials/provinces-data';
import provinceMapSvg from '../../../../public/province-map.svg?raw';
import { url } from '../../../utils/url';

const lang = 'zh-hant';
const strings = t(lang);
const s = strings.mapoverall;
const footerQuote = strings.footer.quoteBySection?.maps ?? strings.footer.quote;

function utf8ToBase64(str: string): string {
  const bytes = new TextEncoder().encode(str);
  let binary = '';
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary);
}
const mapsPayload = utf8ToBase64(JSON.stringify({ provinceData, lang }));

const aboutLink = { icon: 'ti-info-circle', label: '關於', href: url('/zh-hant/maps/about-maps-overall') };

const mapResources = [
  { icon: 'ti-link', label: '西域圖', href: url('/mapbase/Xiyu.png') },
  { icon: 'ti-link', label: '全域圖', href: url('/mapbase/Overall_detailed.png') },
];

const relatedMaps = [
  { title: 'Kongming\'s Archives', href: 'https://zgongjin.tumblr.com/jkmap' },
  { title: 'ROTK.net',             href: 'https://rotk.net/' },
];
---

<Base title={`${s.title} · ${strings.siteTitle}`} lang={lang}>
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="breadcrumb">
        <a href={url('/zh-hant/maps')} class="bc-link">地圖</a>
        <span class="bc-sep">›</span>
        <span class="bc-cur">{s.title}</span>
      </div>
      <h1 class="page-title">{s.title}</h1>
      <p class="page-sub">{s.subtitle}</p>
    </div>

    <!-- MAP TOOLBAR — slim search + tabs + About link, replacing the old intro block -->
    <div class="map-toolbar">
      <div class="toolbar-search-wrap" id="toolbar-search-wrap">
        <div class="search-box" id="search-box">
          <input
            class="search-input"
            id="search-input"
            type="text"
            placeholder="Luoyang, 成都..."
            autocomplete="off"
          />
          <button class="search-clear" id="search-clear" style="display:none;">✕</button>
          <button class="search-btn" id="search-btn"><i class="ti ti-search" aria-hidden="true"></i></button>
        </div>
        <div class="search-dropdown" id="search-dropdown" style="display:none;">
          <div class="dropdown-warning" id="search-dropdown-warning" style="display:none;"></div>
          <div class="dropdown-list" id="search-dropdown-list"></div>
          <button class="dropdown-more" id="search-dropdown-more" style="display:none;"></button>
        </div>
      </div>

      <!-- TABS — desktop, now sits in the toolbar row -->
      <div class="tabs" id="tabs">
        <button class="tab active" data-tab="interactive">{s.tabs.interactive}</button>
        <button class="tab" data-tab="regions">{s.tabs.regions}</button>
      </div>

      <a href={aboutLink.href} class="toolbar-about-link">
        <i class={`ti ${aboutLink.icon}`} aria-hidden="true"></i>
        <span>{aboutLink.label}</span>
      </a>
    </div>

    <!-- TABS — mobile dropdown, unchanged, stays as its own row -->
    <div class="tab-dropdown">
      <select class="tab-select" id="tab-select">
        <option value="interactive" selected>{s.tabs.interactive}</option>
        <option value="regions">{s.tabs.regions}</option>
      </select>
    </div>

    <div class="panels-wrapper">

      <!-- REGIONS TAB -->
      <div class="panel" id="panel-regions" style="display:none;">
        <div class="map-layout">

          <!-- SIDEBAR CARD -->
          <div class="map-sidebar">
            <div class="sidebar-section" style="margin-top:0;">
              <p class="sidebar-section-label">亦發佈於：</p>
              {relatedMaps.map(m => (
                <a href={m.href} class="sidebar-map-link" target={m.href.startsWith('http') ? '_blank' : undefined}>
                  <span class="era-title">{m.title}</span>
                </a>
              ))}
            </div>

            <div class="sidebar-section">
              <p class="sidebar-section-label">工具</p>
              {mapResources.map(link => (
                <a href={link.href} class="sidebar-map-link" target="_blank">
                  <span class="era-title">{link.label}</span>
                </a>
              ))}
            </div>

            <div class="sidebar-section">
              <p class="sidebar-section-label">國</p>
              <div class="legend-item">
                <span class="legend-dot" style="background:#4b6f9f;"></span>
                <span>魏</span>
              </div>
              <div class="legend-item">
                <span class="legend-dot" style="background:#5aaa78;"></span>
                <span>蜀</span>
              </div>
              <div class="legend-item">
                <span class="legend-dot" style="background:#c86060;"></span>
                <span>吳</span>
              </div>
            </div>

            <i class="ti ti-map-2 sidebar-watermark" aria-hidden="true"></i>
          </div>

          <!-- MAP COLUMN -->
          <div class="map-content">
            <div class="province-map-wrap">
              <div class="province-map-inner" id="province-map-inner" set:html={provinceMapSvg} />
              <div class="province-labels" id="province-labels" aria-hidden="true"></div>
            </div>
          </div>

        </div>
      </div>

      <!-- INTERACTIVE TAB -->
      <div class="panel" id="panel-interactive">
        <div class="imap-layout">

          <!-- MAP CONTAINER (now full width) -->
          <div class="imap-content">

            <button class="imap-legend-toggle" id="imap-legend-toggle" type="button" aria-label="Show legend" aria-expanded="false">
              <i class="ti ti-list" aria-hidden="true"></i>
            </button>

            <div class="imap-legend-dropdown" id="imap-legend-dropdown" style="display:none;">

              <div class="imap-legend-controls-box">
                <div class="imap-style-btns" id="imap-style-btns" aria-label="Base map">
                  <button class="imap-style-btn active" data-style="outdoor" type="button">
                    <span class="imap-style-frame imap-style-frame-topo"></span>
                    <span>地形</span>
                  </button>
                  <button class="imap-style-btn" data-style="satellite" type="button">
                    <span class="imap-style-frame imap-style-frame-sat"></span>
                    <span>衛星</span>
                  </button>
                </div>
                <div class="imap-legend-checkboxes">
                  <label class="imap-toggle-row imap-map-toggle">
                    <input type="checkbox" id="toggle-provinces" checked />
                    <span class="imap-toggle-track"></span>
                    <span>三國諸州</span>
                  </label>
                  <label class="imap-toggle-row imap-map-toggle">
                    <input type="checkbox" id="toggle-yellow-river" checked />
                    <span class="imap-toggle-track"></span>
                    <span>黃河故道</span>
                  </label>
                  <label class="imap-toggle-row imap-map-toggle">
                    <input type="checkbox" id="toggle-labels" />
                    <span class="imap-toggle-track"></span>
                    <span>現代地名</span>
                  </label>
                </div>
              </div>

              <div class="imap-legend-symbols-grid">
                <div class="legend-item"><span class="imap-sym imap-sym-prov">■</span><span>州治</span></div>
                <div class="legend-item"><span class="imap-sym imap-sym-comm">●</span><span>郡治</span></div>
                <div class="legend-item"><span class="imap-sym imap-sym-county">○</span><span>縣治</span></div>
                <div class="legend-item"><span class="imap-sym imap-sym-pass">×</span><span>關隘</span></div>
                <div class="legend-item"><span class="imap-sym imap-sym-land">★</span><span>地標</span></div>
                <div class="legend-item"><span class="imap-sym imap-sym-other">◆</span><span>其它</span></div>
              </div>
              <div class="imap-zoom-hint">
                <i class="ti ti-info-circle"></i>
                <span>放大地圖可見更多地名</span>
              </div>

              <div class="imap-legend-kingdoms-row">
                <div class="legend-item"><span class="legend-dot" style="background:#4b6f9f;"></span><span>魏</span></div>
                <div class="legend-item"><span class="legend-dot" style="background:#5aaa78;"></span><span>蜀</span></div>
                <div class="legend-item"><span class="legend-dot" style="background:#c86060;"></span><span>吳</span></div>
              </div>

            </div>

            <div id="imap-container"></div>

            <!-- Docked right-side column: region (province/commandery/river
                 search results) on top, specific place on bottom. Together
                 they fill the full height; if only one has content, it
                 simply takes the whole space since the other is display:none
                 and flex:1 has nothing left to share with. -->
            <div class="imap-right-dock" id="imap-right-dock" style="display:none;">
              <div class="imap-region-panel" id="imap-region-panel"></div>
              <div class="imap-town-panel" id="imap-town-panel"></div>
            </div>

            <div class="imap-loading" id="imap-loading">
              <div class="imap-loading-inner">
                <i class="ti ti-map-2"></i>
                <span>加載中...</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Journey overview toggle + panel — a sibling of .imap-layout
             rather than nested inside .imap-content, specifically so it
             can sit in normal document flow below the map on mobile
             (pulling it out of the map's own floating chrome avoids
             competing with the location detail bottom sheet for the
             same space), while still being absolutely positioned to
             overlay the map on desktop, below the legend icon, via
             #panel-interactive's position:relative. -->
        <button class="imap-journey-toggle" id="imap-journey-toggle" type="button" aria-label="Show journey overview" aria-expanded="false" style="display:none;">
          <i class="ti ti-route" aria-hidden="true"></i>
        </button>
        <div class="imap-journey-dropdown" id="imap-journey-dropdown" style="display:none;">
          <div id="imap-journey-panel"></div>
          <button class="imap-journey-exit" id="imap-journey-exit" type="button">
            <i class="ti ti-logout" aria-hidden="true"></i> 退出足跡
          </button>
        </div>

      </div>

    </div>

    <footer class="site-footer">
      <span class="footer-quote">{footerQuote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<div id="maps-data" data-payload={mapsPayload} style="display:none;"></div>

<script>
  // @ts-nocheck
  import { url } from '../../../utils/url';
  
  const mapsDataEl = document.getElementById('maps-data');
  const payload = mapsDataEl.dataset.payload || '';
  const binaryStr = atob(payload);
  const bytes = Uint8Array.from(binaryStr, c => c.charCodeAt(0));
  const jsonStr = new TextDecoder('utf-8').decode(bytes);
  const { provinceData, lang } = JSON.parse(jsonStr || '{}');
 

  const isZh = lang === 'zh-hant' || lang === 'zh-hans';

  let allTowns = [];
  let townsPromise = null;

  function normaliseTownsPayload(data) {
    return data?.All_Towns_Details ?? data ?? [];
  }

  function loadTowns() {
    if (allTowns.length) return Promise.resolve(allTowns);
    if (!townsPromise) {
      townsPromise = fetch(url('/mapbase/All_Towns.json'))
        .then(r => r.json())
        .then(data => {
          allTowns = normaliseTownsPayload(data);
          return allTowns;
        })
        .catch(e => {
          townsPromise = null;
          console.warn('Could not load towns data:', e);
          return [];
        });
    }
    return townsPromise;
  }

  window.__threeKArchiveLoadTowns = loadTowns;

  // TAB SWITCHING 
  const tabSelect = document.getElementById('tab-select');
  const panels = {
    regions:     document.getElementById('panel-regions'),
    interactive: document.getElementById('panel-interactive'),
  };

  function showTab(tab) {
    Object.values(panels).forEach(p => p.style.display = 'none');
    panels[tab].style.display = 'block';
    document.querySelectorAll('.tab').forEach(t => {
      t.classList.toggle('active', t.dataset.tab === tab);
    });
    tabSelect.value = tab;
    if (tab === 'regions') positionLabels();
    if (tab === 'interactive') {
      initInteractiveMap({ lang });
    }
  }

  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => showTab(tab.dataset.tab));
  });
  tabSelect.addEventListener('change', () => showTab(tabSelect.value));
  showTab(tabSelect.value || 'interactive');

  //  PROVINCE MAP (SVG) 
  const mapRoot = document.querySelector('#province-map-inner svg');
  const labelsContainer = document.getElementById('province-labels');
  const mapInner = document.getElementById('province-map-inner');

  if (mapRoot) {
    mapRoot.classList.add('province-map-svg');
    Object.keys(provinceData).forEach(provinceId => {
      const g = document.getElementById(provinceId);
      if (!g) return;
      const info = provinceData[provinceId];
      g.querySelectorAll('title').forEach(t => t.remove());
      g.addEventListener('mouseenter', () => g.classList.add('province-hover'));
      g.addEventListener('mouseleave', () => g.classList.remove('province-hover'));
      g.addEventListener('click', () => { if (info.pngUrl) window.open(url(info.pngUrl), '_blank'); });
    });
  }

  function createLabel(id, info) {
    const div = document.createElement('div');
    div.className = 'province-label';
    div.id = `plabel-${id}`;
    const nameEn = info.name?.en || id;
    const nameCn = lang === 'zh-hans'
      ? (info.name?.zhs || info.name?.zht || '')
      : (info.name?.zht || info.name?.zhs || '');
    if (isZh) {
      div.innerHTML = `<span class="plabel-primary">${nameCn || nameEn}</span>${nameEn ? `<span class="plabel-sub">${nameEn}</span>` : ''}`;
    } else {
      div.innerHTML = `<span class="plabel-primary">${nameEn}</span>${nameCn ? `<span class="plabel-sub">${nameCn}</span>` : ''}`;
    }
    labelsContainer.appendChild(div);
    return div;
  }

  const skipLabels = new Set(['Jiaozhou2']);

  function positionLabels() {
    if (!mapRoot || !labelsContainer) return;
    const containerRect = mapInner.getBoundingClientRect();
    if (containerRect.width === 0) return;
    Object.keys(provinceData).forEach(id => {
      if (skipLabels.has(id)) return;
      const g = document.getElementById(id);
      if (!g) return;
      const label = document.getElementById(`plabel-${id}`) || createLabel(id, provinceData[id]);
      const gRect = g.getBoundingClientRect();
      if (gRect.width < 30 || gRect.height < 20) { label.style.display = 'none'; return; }
      label.style.display = '';
      label.style.left = `${gRect.left - containerRect.left + gRect.width  / 2}px`;
      label.style.top  = `${gRect.top  - containerRect.top  + gRect.height / 2}px`;
    });
  }

  requestAnimationFrame(() => { requestAnimationFrame(positionLabels); });
  let resizeTimer;
  window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(positionLabels, 100); });

  //  LOCATION SEARCH 
  const provinceKingdom = {
    'Bingzhou': 'wei', 'Jizhou': 'wei', 'Qingzhou': 'wei',
    'Yanzhou': 'wei', 'Yuzhou': 'wei', 'Youzhou': 'wei',
    'Liangzhou': 'wei', 'Sili': 'wei', 'Yongzhou': 'wei',
    'Xuzhou': 'wei', 'Jingzhou (Wei)': 'wei', 'Yangzhou (Wei)': 'wei',
    'Xiyu': 'wei',
    'Yizhou (South)': 'shu', 'Yizhou (North)': "shu",
    'Jiaozhou': 'wu', 'Jingzhou (Wu)': 'wu', 'Yangzhou (Wu)': 'wu',
  };
  const provToPng = {
  'Bingzhou': url('/mapbase/Bingzhou.png'),
  'Jiaozhou': url('/mapbase/Jiaozhou.png'),
  'Jingzhou (Wei)': url('/mapbase/Jing_Wei.png'),
  'Jingzhou (Wu)': url('/mapbase/Jing_Wu.png'),
  'Jizhou': url('/mapbase/Jizhou.png'),
  'Liangzhou': url('/mapbase/Liangzhou.png'),
  'Qingzhou': url('/mapbase/Qing_Xu.png'),
  'Xuzhou': url('/mapbase/Qing_Xu.png'),
  'Sili': url('/mapbase/Sili.png'),
  'Yanzhou': url('/mapbase/Yan_Yu_Yang.png'),
  'Yuzhou': url('/mapbase/Yan_Yu_Yang.png'),
  'Yangzhou (Wei)': url('/mapbase/Yan_Yu_Yang.png'),
  'Yangzhou (Wu)': url('/mapbase/Yang_Wu.png'),
  'Yizhou (North)': url('/mapbase/Yi_North.png'),
  'Yizhou (South)': url('/mapbase/Yi_South.png'),
  'Yongzhou': url('/mapbase/Yongzhou.png'),
  'Youzhou': url('/mapbase/Youzhou.png'),
  'Xiyu': url('/mapbase/Xiyu.png'),
};
  const kingdomLabel = { wei: '魏', shu: '蜀', wu: '吳' };
  // Xiyu towns are tagged kingdom 'wei' for filtering purposes (matching how
  // the rest of the map treats the Western Regions), but should read as
  // "西域" rather than "魏" in the badge itself — same color, different
  // label, since "魏" would misleadingly imply direct administration
  // rather than the historical tributary relationship. Same convention as
  // search.astro's getTownBadgeInfo.
  function getTownBadgeInfo(provEn) {
    const k = getKingdom(provEn);
    if (!k) return null;
    if (provEn === 'Xiyu') return { cls: `b-${k}`, label: '西域' };
    return { cls: `b-${k}`, label: kingdomLabel[k] };
  }
  const typeLabel = { "Provincial Seat": "州治", "Commandery Seat": "郡治", "County Seat": "縣治", "Military Pass": "關隘", "Landmark": "地標", "Others": "其它" };
  function displaySearchTownName(t) {
    if (lang === 'zh-hans') return t.Town_CHS || t.Town_CH || t.Town_EN || '';
    if (lang === 'zh-hant') return t.Town_CH || t.Town_CHS || t.Town_EN || '';
    return t.Town_EN || '';
  }
  function displaySearchTownSub(t) {
    if (lang === 'zh-hans' || lang === 'zh-hant') return t.Town_EN || '';
    return t.Town_CH || t.Town_CHS || '';
  }
  function displaySearchType(type) {
    return typeLabel[type] || type || '';
  }
  function getKingdom(provEn) { return provinceKingdom[provEn] ?? null; }

  // "XX縣"/"XX县" should also match a County/Commandery/Provincial Seat
  // stored without the suffix — Commandery and Provincial Seats are
  // themselves counties (just also serving as the seat of a higher admin
  // level), and most county names don't carry 縣/县 in the data anyway
  // (unlike princely states, which keep 國 baked into their historical name).
  const COUNTY_LIKE_TYPES = new Set(['County Seat', 'Commandery Seat', 'Provincial Seat']);
  function countyStrippedQuery(q) {
    const m = q.match(/^(.+)[县縣]$/);
    return m ? m[1] : null;
  }
  function isCountySuffixMatch(t, qCounty, exact) {
    if (qCounty === null || !COUNTY_LIKE_TYPES.has(t.Type)) return false;
    return exact
      ? (t.Town_CH === qCounty || t.Town_CHS === qCounty)
      : (t.Town_CH?.includes(qCounty) || t.Town_CHS?.includes(qCounty));
  }

  // ── WATER BODIES (rivers/lakes) — search-only, never shown by default ──
  let allWaterBodies = [];
  let waterBodiesLoaded = false;

  async function loadWaterBodies() {
    if (waterBodiesLoaded) return allWaterBodies;
    allWaterBodies = await fetchWaterBodies();
    waterBodiesLoaded = true;
    return allWaterBodies;
  }

  function displaySearchWaterName(f) {
    const p = f.properties;
    return p.Name_CH || p.Name_CHS || p.Name_EN || '';
  }

  function displaySearchWaterSub(f) {
    const p = f.properties;
    return p.Name_EN || '';
  }

  function waterBodyMatches(f, q, ql) {
    const p = f.properties;
    const candidates = [
      p.Name_EN,
      p.Name_CH,
      p.Name_CHS,
      ...(p.Name_CH_variants || []),
      ...(p.Name_CHS_variants || [])
    ].filter(Boolean);

    return candidates.some(v =>
      String(v).toLowerCase() === ql || String(v).toLowerCase().includes(ql) ||
      v === q || v.includes(q)
    );
  }

  // tag shown in the search type column for water bodies.
function displaySearchWaterType(f) {
  return f.properties.Type_CH || f.properties.Type || '河流';
}

  // ── ADMIN BOUNDARIES (provinces/commanderies) — search-only, base layer stays as-is ──
  let allAdminBoundaries = [];
  let adminBoundariesLoaded = false;

  async function loadAdminBoundaries() {
    if (adminBoundariesLoaded) return allAdminBoundaries;
    allAdminBoundaries = await fetchAdminBoundaries();
    adminBoundariesLoaded = true;
    return allAdminBoundaries;
  }

  function displaySearchAdminName(f) {
    const p = f.properties;
    return p.Name_CH || p.Name_CHS || p.Name_EN || '';
  }

  function displaySearchAdminSub(f) {
    const p = f.properties;
    return p.level === 'province' ? formatProvinceLabel(p.Name_EN) : (p.Name_EN || '');
  }

  // "Yanzhou" -> "Yan Province"; used only for EN-form search matching, not
  // for zh-hant display (the raw Chinese name already conveys 州/郡/國).
function formatProvinceLabel(provEn) {
  if (!provEn) return '';
  // Extract a trailing bracket like "(Wei)"/"(Wu)" separately so it can be
  // re-appended AFTER "Province" — doing the zhou->Province replacement on
  // the whole string put the bracket in the middle (e.g. "Jing (Wei)
  // Province"), which broke substring search for "Jing Province".
  const bracketMatch = provEn.match(/^(.*?)\s*(\([^)]+\))?$/);
  const base = (bracketMatch ? bracketMatch[1] : provEn).trim();
  const suffix = bracketMatch && bracketMatch[2] ? bracketMatch[2] : '';
  const formatted = /zhou/i.test(base)
    ? `${base.replace(/zhou/ig, '').trim()} Province`
    : `${base} (Capital Region)`;
  return suffix ? `${formatted} ${suffix}` : formatted;
}

  function formatCommanderyLabel(nameEn, nameCh) {
    if (!nameEn) return '';
    const isState = (nameCh && nameCh.includes('國')) || /state$/i.test(nameEn.trim());
    return isState ? nameEn : `${nameEn} Commandery`;
  }

  function adminBoundaryMatches(f, q, ql) {
    const p = f.properties;
    const candidates = [p.Name_EN, p.Name_CH, p.Name_CHS].filter(Boolean);
    if (p.level === 'province') candidates.push(formatProvinceLabel(p.Name_EN));
    if (p.level === 'commandery') {
      candidates.push(formatCommanderyLabel(p.Name_EN, p.Name_CH));
      const isState = (p.Name_CH && p.Name_CH.includes('國')) || /state$/i.test((p.Name_EN || '').trim());
      if (isState) {
        const base = (p.Name_EN || '').replace(/\s*state$/i, '').trim();
        candidates.push(`${base} Guo`, `${base}Guo`);
      } else {
        candidates.push(`${p.Name_EN} Jun`, `${p.Name_EN}Jun`);
        // Regular commanderies are stored without 郡 in the raw Chinese name
        // (e.g. "南陽", not "南陽郡") — accept "XX郡" in both scripts. States
        // already carry 國 in their historical name and don't need this.
        if (p.Name_CH) candidates.push(`${p.Name_CH}郡`);
        if (p.Name_CHS) candidates.push(`${p.Name_CHS}郡`);
      }
    }

    return candidates.some(v => {
      const vl = String(v).toLowerCase();
      return v === q || vl.includes(ql);
    });
  }

  // 州/郡 tag shown in the search type column for admin boundaries — same
  // wording already used by interactive-map.js's popup for zh-hant.
  function displaySearchAdminType(f) {
    if (f.properties.level === 'commandery') return '郡';
    if (f.properties.level === 'tributary') return '藩屬國';
    return '州';
  }

  async function focusLocationFromUrl() {
    const params = new URLSearchParams(window.location.search);

    // "View life journey" links carry only ?journey=<chapterId>, no
    // lat/lng/water/admin at all — checked first and independently of
    // everything else below, since it's a pure overview (all of a
    // chapter's places at once), not tied to any single point.
    const journeyId = params.get('journey');
    if (journeyId) {
      showTab('interactive');
      showJourney(journeyId);
      return;
    }

    const waterId = params.get('water');
    if (waterId !== null && waterId !== '') {
      showTab('interactive');
      showWaterBodyById(waterId);
      return;
    }

    const adminId = params.get('admin');
    if (adminId !== null && adminId !== '') {
      showTab('interactive');
      showAdminBoundaryById(adminId);
      return;
    }

    const lat = Number(params.get('lat'));
    const lng = Number(params.get('lng'));
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

    const name = params.get('name') || '';
    const towns = await loadTowns();
    const town = towns.find(t => {
      if (Number(t?.Latitude) !== lat || Number(t?.Longitude) !== lng) return false;
      if (!name) return true;
      return [t.Town_EN, t.Town_CH, t.Town_CHS].some(value => String(value ?? '').toLowerCase() === name.toLowerCase());
    }) ?? null;

    showTab('interactive');
    flyToLocation(lat, lng, town);
  }

  const searchInput  = document.getElementById('search-input');
  const searchBtn    = document.getElementById('search-btn');
  const searchClear  = document.getElementById('search-clear');
  const dropdown     = document.getElementById('search-dropdown');
  const dropWarning  = document.getElementById('search-dropdown-warning');
  const dropList     = document.getElementById('search-dropdown-list');
  const dropMore     = document.getElementById('search-dropdown-more');

  const MAX_VISIBLE = 6;
  const WARN_LEN_EN = 3;
  const WARN_LEN_CN = 2;
  const CJK_RE = /[\u3400-\u9fff\uf900-\ufaff]/; // CJK Unified Ideographs (+ compat)
  function getWarnLen(q) { return CJK_RE.test(q) ? WARN_LEN_CN : WARN_LEN_EN; }

  async function runSearch(query) {
    const q = query.trim();
    if (!q) {
      dropdown.style.display = 'none';
      searchClear.style.display = 'none';
      clearWaterBodyHighlight();
      return;
    }
    searchClear.style.display = 'block';
    if (!allTowns.length || !waterBodiesLoaded || !adminBoundariesLoaded) {
      dropdown.style.display = 'block';
      dropWarning.style.display = 'none';
      dropMore.style.display = 'none';
      dropList.innerHTML = '<div class="search-empty">地點加載中...</div>';
      await Promise.all([loadTowns(), loadWaterBodies(), loadAdminBoundaries()]);
      if (searchInput?.value?.trim() !== q) return;
    }
    const ql = q.toLowerCase();
    const qCounty = countyStrippedQuery(q);
    const exact   = allTowns.filter(t =>
      t.Town_EN?.toLowerCase() === ql || t.Town_CH === q || t.Town_CHS === q ||
      isCountySuffixMatch(t, qCounty, true)
    );
    const partial = allTowns.filter(t =>
      (t.Town_EN?.toLowerCase().includes(ql) || t.Town_CH?.includes(q) || t.Town_CHS?.includes(q) || isCountySuffixMatch(t, qCounty, false)) &&
      t.Town_EN?.toLowerCase() !== ql && t.Town_CH !== q && t.Town_CHS !== q &&
      !isCountySuffixMatch(t, qCounty, true)
    );
    const townResults = [...exact, ...partial].map(t => ({ kind: 'town', item: t }));

    const waterResults = allWaterBodies
      .filter(f => waterBodyMatches(f, q, ql))
      .map(f => ({ kind: 'water', item: f }));

    const adminResults = allAdminBoundaries
      .filter(f => adminBoundaryMatches(f, q, ql))
      .map(f => ({ kind: 'admin', item: f }));

    const filtered = [...townResults, ...waterResults, ...adminResults];

    if (q.length < getWarnLen(q)) {
      dropWarning.style.display = 'block';
      dropWarning.textContent = '⚠ 當前檢索較短，或無法精準匹配。';
    } else { dropWarning.style.display = 'none'; }
    const visible = filtered.slice(0, MAX_VISIBLE);
    if (visible.length === 0) {
      dropList.innerHTML = '<div class="search-empty">無符合地點</div>';
      dropMore.style.display = 'none';
    } else {
      dropList.innerHTML = visible.map((result, index) => {
        if (result.kind === 'water') {
          const f = result.item;
          const subName = displaySearchWaterSub(f) ? `<span class="result-name-zh">${displaySearchWaterSub(f)}</span>` : '';
          const displayKingdoms = f.properties.display_kingdoms || [];
          const badge = displayKingdoms.length
            ? displayKingdoms.map(k => `<span class="badge b-${k}">${kingdomLabel[k]}</span>`).join('')
            : '<span class="badge b-water"><i class="ti ti-droplet"></i></span>';
          const pngUrl = provToPng[f.properties.primary_province];
          const pngBtn = pngUrl ? `<button class="result-action" data-png="${pngUrl}" title="图版地图"><i class="ti ti-map-2"></i></button>` : '';
          const mapBtn = `<button class="result-action result-action-water" data-index="${index}" title="互動地圖"><i class="ti ti-map-pin"></i></button>`;
          return `<div class="search-result-row" data-index="${index}" data-kind="water">
            <div class="search-result-left">${badge}<span class="result-name-en">${displaySearchWaterName(f)}</span>${subName}</div>
            <div class="result-right"><span class="result-type">${displaySearchWaterType(f)}</span><div style="display:flex;flex-direction:row;align-items:center;gap:4px;">${pngBtn}${mapBtn}</div></div>
          </div>`;
        }

        if (result.kind === 'admin') {
          const f = result.item;
          const subName = displaySearchAdminSub(f) ? `<span class="result-name-zh">${displaySearchAdminSub(f)}</span>` : '';
          const k = f.properties.kingdom;
          const badge = k ? `<span class="badge b-${k}">${kingdomLabel[k]}</span>` : '';
          const pngUrl = provToPng[f.properties.Prov_EN];
          const pngBtn = pngUrl ? `<button class="result-action" data-png="${pngUrl}" title="图版地图"><i class="ti ti-map-2"></i></button>` : '';
          const mapBtn = `<button class="result-action result-action-admin" data-index="${index}" title="互動地圖"><i class="ti ti-map-pin"></i></button>`;
          return `<div class="search-result-row" data-index="${index}" data-kind="admin">
            <div class="search-result-left">${badge}<span class="result-name-en">${displaySearchAdminName(f)}</span>${subName}</div>
            <div class="result-right"><span class="result-type">${displaySearchAdminType(f)}</span><div style="display:flex;flex-direction:row;align-items:center;gap:4px;">${pngBtn}${mapBtn}</div></div>
          </div>`;
        }

        const t     = result.item;
        const badgeInfo = getTownBadgeInfo(t.Prov_EN);
        const badge = badgeInfo ? `<span class="badge ${badgeInfo.cls}">${badgeInfo.label}</span>` : '';
        const subName = displaySearchTownSub(t) ? `<span class="result-name-zh">${displaySearchTownSub(t)}</span>` : '';
        const pngUrl = provToPng[t.Prov_EN];
        const pngBtn = pngUrl ? `<button class="result-action" data-png="${pngUrl}" title="图版地图"><i class="ti ti-map-2"></i></button>` : '';
        const mapBtn = `<button class="result-action result-action-map" data-index="${index}" data-lat="${t.Latitude}" data-lng="${t.Longitude}" title="互動地圖"><i class="ti ti-map-pin"></i></button>`;
        return `<div class="search-result-row" data-index="${index}" data-kind="town" data-en="${t.Town_EN}">
          <div class="search-result-left">${badge}<span class="result-name-en">${displaySearchTownName(t)}</span>${subName}</div>
          <div class="result-right"><span class="result-type">${displaySearchType(t.Type)}</span><div style="display:flex;flex-direction:row;align-items:center;gap:4px;">${pngBtn}${mapBtn}</div></div>
        </div>`;
      }).join('');

      function locateSearchTown(t) {
        const lat = Number(t?.Latitude);
        const lng = Number(t?.Longitude);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
        clearWaterBodyHighlight();
        showTab('interactive');
        flyToLocation(lat, lng, t);
        dropdown.style.display = 'none';
      }

      function locateSearchWater(f) {
        showTab('interactive');
        showWaterBodyById(f.properties?.id);
        dropdown.style.display = 'none';
      }

      function locateSearchAdmin(f) {
        showTab('interactive');
        showAdminBoundaryById(f.properties?.id);
        dropdown.style.display = 'none';
      }

      function handleResultActivate(index) {
        const result = visible[index];
        if (!result) return;
        if (result.kind === 'water') locateSearchWater(result.item);
        else if (result.kind === 'admin') locateSearchAdmin(result.item);
        else locateSearchTown(result.item);
      }

      dropList.querySelectorAll('.search-result-row').forEach(row => {
        row.addEventListener('click', () => handleResultActivate(Number(row.dataset.index)));
      });
      dropList.querySelectorAll('.result-action[data-png]').forEach(btn => {
        btn.addEventListener('click', e => { e.stopPropagation(); window.open(btn.dataset.png, '_blank'); });
      });
      dropList.querySelectorAll('.result-action-map, .result-action-water, .result-action-admin').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          handleResultActivate(Number(btn.dataset.index));
        });
      });
      if (filtered.length > MAX_VISIBLE) {
        dropMore.style.display = 'block';
        dropMore.textContent = `所有 ${filtered.length} 條`;
        dropMore.onclick = () => { window.location.href = url(`/zh-hant/maps/search?q=${encodeURIComponent(q)}`); };
      } else { dropMore.style.display = 'none'; }
    }
    dropdown.style.display = 'block';
  }

  searchInput?.addEventListener('focus',  () => { loadTowns(); loadWaterBodies(); loadAdminBoundaries(); });
  searchInput?.addEventListener('input',  e => { runSearch(e.target.value); });
  searchBtn?.addEventListener('click',    ()  => { runSearch(searchInput?.value ?? ''); });
  searchClear?.addEventListener('click',  () => {
    searchInput.value = '';
    searchClear.style.display = 'none';
    dropdown.style.display = 'none';
    clearWaterBodyHighlight();
  });
  document.addEventListener('click', e => { if (!e.target.closest('.toolbar-search-wrap')) dropdown.style.display = 'none'; });
  focusLocationFromUrl();

  // ── LEGEND TOGGLE (interactive tab) ───────────────────────────
  const legendToggle = document.getElementById('imap-legend-toggle');
  const legendDropdown = document.getElementById('imap-legend-dropdown');

  if (legendToggle && legendDropdown) {
    legendToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = legendDropdown.style.display !== 'none';
      legendDropdown.style.display = isOpen ? 'none' : 'block';
      legendToggle.setAttribute('aria-expanded', String(!isOpen));
      repositionJourneyToggle();
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#imap-legend-dropdown') && !e.target.closest('#imap-legend-toggle')) {
        legendDropdown.style.display = 'none';
        legendToggle.setAttribute('aria-expanded', 'false');
        repositionJourneyToggle();
      }
    });
  }

  // ── JOURNEY OVERVIEW TOGGLE ────────────────────────────────────
  // Desktop only — on mobile this whole toggle+dropdown pair stays
  // hidden via CSS and the panel instead renders in normal document
  // flow below the map (see the mobile media query).
  const journeyToggle = document.getElementById('imap-journey-toggle');
  const journeyDropdown = document.getElementById('imap-journey-dropdown');
  const journeyExitBtn = document.getElementById('imap-journey-exit');

  // The journey toggle sits directly below the legend icon by default
  // (top:54px) — the same spot the legend dropdown itself occupies when
  // open — so it needs to shift further down whenever that dropdown is
  // open, exactly like the old zoom-controls repositioning used to work.
  function repositionJourneyToggle() {
    if (!journeyToggle || !legendDropdown) return;
    const legendOpen = legendDropdown.style.display !== 'none';
    if (!legendOpen) {
      journeyToggle.style.top = '54px';
    } else {
      const dropdownRect = legendDropdown.getBoundingClientRect();
      const parent = legendDropdown.offsetParent;
      const parentRect = parent ? parent.getBoundingClientRect() : { top: 0 };
      journeyToggle.style.top = `${dropdownRect.bottom - parentRect.top + 8}px`;
    }
    if (journeyDropdown) {
      journeyDropdown.style.top = `${parseFloat(journeyToggle.style.top) + 44}px`;
    }
  }

  if (journeyToggle && journeyDropdown) {
    journeyToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = journeyDropdown.style.display !== 'none';
      journeyDropdown.style.display = isOpen ? 'none' : 'block';
      journeyToggle.setAttribute('aria-expanded', String(!isOpen));
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#imap-journey-dropdown') && !e.target.closest('#imap-journey-toggle')) {
        journeyDropdown.style.display = 'none';
        journeyToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  journeyExitBtn?.addEventListener('click', () => {
    exitJourneyMode();
    if (journeyDropdown) journeyDropdown.style.display = 'none';
    if (journeyToggle) journeyToggle.setAttribute('aria-expanded', 'false');
  });

  // INTERACTIVE MAP
  // Fully handled by interactive-map.js (with the journey-panel feature
  // split out into its own journey.js module alongside it)
  import {
    initInteractiveMap,
    flyToLocation,
    fetchWaterBodies,
    clearWaterBodyHighlight,
    showWaterBodyById,
    fetchAdminBoundaries,
    showAdminBoundaryById
  } from '../../../scripts/maps/interactive-map.js';
  import {
    showJourney,
    exitJourneyMode
  } from '../../../scripts/maps/journey.js';
</script>

