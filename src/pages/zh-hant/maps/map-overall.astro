/*  INTERACTIVE MAP TAB  */
.imap-layout {
  display: flex;
  height: 90vh;
  min-height: 560px;
  background: #080808;
  overflow: hidden;
}

.imap-legend-toggle {
  position: absolute;
  top: 10px;
  left: 12px;
  z-index: 6;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(18,18,17,0.9);
  border: 1px solid rgba(202,163,106,0.28);
  border-radius: 4px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.32);
  color: #d0a66a;
  font-size: 17px;
  cursor: pointer;
  transition: background 0.15s;
}
.imap-legend-toggle:hover { background: rgba(40,32,18,0.95); border-color: #d0a66a; }

.imap-legend-dropdown {
  position: absolute;
  top: 54px;
  left: 12px;
  z-index: 6;
  width: 460px;
  max-height: calc(90vh - 90px);
  overflow-y: auto;
  padding: 0.9rem 1rem;
  background: rgba(18,18,17,0.95);
  border: 1px solid rgba(202,163,106,0.28);
  border-radius: 4px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.32), inset 0 0 0 1px rgba(255,255,255,0.035);
  backdrop-filter: blur(8px);
}

/* Journey overview toggle — sits directly below the legend icon by
   default (same spot zoom controls used to occupy before they moved
   into the legend's own row), shifting further down whenever the
   legend dropdown is open, so the two never overlap. Hidden until a
   journey is actually loaded (interactive-map.js reveals it). */
.imap-journey-toggle {
  position: absolute;
  top: 54px;
  left: 12px;
  z-index: 6;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(18,18,17,0.9);
  border: 1px solid rgba(202,163,106,0.28);
  border-radius: 4px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.32);
  color: #d0a66a;
  font-size: 16px;
  cursor: pointer;
  transition: background 0.15s, top 0.15s;
}
.imap-journey-toggle:hover { background: rgba(40,32,18,0.95); border-color: #d0a66a; }

.imap-journey-dropdown {
  position: absolute;
  top: 98px;
  left: 12px;
  z-index: 6;
  width: 360px;
  max-height: calc(90vh - 130px);
  overflow-y: auto;
  padding: 0.9rem 1rem;
  background: rgba(18,18,17,0.95);
  border: 1px solid rgba(202,163,106,0.28);
  border-radius: 4px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.32), inset 0 0 0 1px rgba(255,255,255,0.035);
  backdrop-filter: blur(8px);
  transition: top 0.15s;
  scrollbar-width: thin;
  scrollbar-color: rgba(238,232,218,0.25) transparent;
}
.imap-journey-dropdown::-webkit-scrollbar {
  width: 6px;
}
.imap-journey-dropdown::-webkit-scrollbar-track {
  background: transparent;
}
.imap-journey-dropdown::-webkit-scrollbar-thumb {
  background: rgba(238,232,218,0.25);
  border-radius: 3px;
}
.imap-journey-dropdown::-webkit-scrollbar-thumb:hover {
  background: rgba(238,232,218,0.4);
}

.imap-journey-header {
  position: relative;
  padding: 0 28px; /* leaves room for the absolute-positioned corner icons */
}
.imap-journey-bio-link {
  position: absolute;
  top: 0;
  right: 0;
  color: #d0a66a;
  font-size: 17px;
  text-decoration: none;
}
.imap-journey-bio-link:hover { color: #f0d29a; }

.imap-journey-header-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
}
.imap-journey-arrow {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 1px solid rgba(202,163,106,0.28);
  border-radius: 4px;
  color: #d0a66a;
  font-size: 18px;
  cursor: pointer;
}
.imap-journey-arrow:hover { background: rgba(40,32,18,0.95); }
.imap-journey-header-info { text-align: center; min-width: 0; }

.imap-journey-name {
  font-family: 'Noto Serif TC', serif;
  font-size: 26px;
  color: #eee8da;
}
.imap-journey-name-secondary {
  font-family: initial;
  font-size: 17px;
  color: var(--color-text-secondary);
  margin-left: 6px;
}
.imap-journey-courtesy {
  font-family: 'Noto Serif TC', serif;
  font-size: 16px;
  font-style: italic;
  color: #eee8da;
  margin-top: 2px;
}
.imap-journey-courtesy-secondary {
  font-family: initial;
  font-size: 14px;
  font-style: normal;
  color: var(--color-text-secondary);
  margin-left: 5px;
}
.imap-journey-person-count {
  text-align: center;
  font-size: 11px;
  color: rgba(238,232,218,0.4);
  margin-top: 4px;
}

.imap-journey-dates {
  margin-top: 10px;
  padding-top: 8px;
  border-top: 1px solid rgba(202,163,106,0.28);
  text-align: center;
}
.imap-journey-dates-num { font-size: 17px; color: rgba(238,232,218,0.78); }
.imap-journey-dates-era { font-size: 15px; color: rgba(238,232,218,0.4); margin-top: 1px; }

.imap-journey-footnote {
  margin-top: 14px;
  padding-top: 8px;
  border-top: 1px solid rgba(202,163,106,0.15);
  font-size: 11px;
  color: rgba(238,232,218,0.4);
}

.imap-journey-timeline {
  margin-top: 16px;
  position: relative;
  padding-left: 20px;
}
/* The connecting spine - what actually makes this read as a timeline
   rather than a plain list. Runs the full height of the stop list,
   inset just enough that the dots sit centered on it. */
.imap-journey-timeline::before {
  content: '';
  position: absolute;
  left: 5px;
  top: 6px;
  bottom: 6px;
  width: 1px;
  background: rgba(202,163,106,0.3);
}
.imap-journey-timeline > * + * { margin-top: 18px; }

.imap-journey-stop { position: relative; }
.imap-journey-stop::before {
  content: '';
  position: absolute;
  top: 4px;
  border-radius: 50%;
}
/* Dated stops get a bigger, brighter dot than undated ones (hometown /
   early-life entries) - the dot weight itself signals whether this is a
   confirmed point in the chronology or a rough placement. */
.imap-journey-stop-dated::before {
  left: -21px;
  width: 9px;
  height: 9px;
  background: #d0a66a;
}
.imap-journey-stop-undated::before {
  left: -20px;
  width: 7px;
  height: 7px;
  background: rgba(202,163,106,0.4);
}
.imap-journey-stop-when-label {
  font-size: 12px;
  color: rgba(208,166,106,0.6);
}
.imap-journey-stop-when-dated {
  font-size: 15px;
  font-weight: 500;
  color: #d0a66a;
}
.imap-journey-stop-entry { margin-top: 4px; }
.imap-journey-stop-entry + .imap-journey-stop-entry { margin-top: 8px; }
.imap-journey-stop-location {
  font-size: 17px;
  color: #eee8da;
}
.imap-journey-stop-location > div + div {
  margin-top: 4px;
}
.imap-journey-loc-secondary {
  font-size: 14px;
  color: var(--color-text-secondary);
}
.imap-journey-loc-link {
  cursor: pointer;
}
.imap-journey-loc-link:hover {
  color: #d0a66a;
  text-decoration-color: #d0a66a;
}
.imap-journey-stop-position-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: rgba(238,232,218,0.4);
  margin-top: 6px;
}
.imap-journey-stop-position {
  font-size: 15px;
  color: rgba(238,232,218,0.85);
  margin-top: 1px;
}
.imap-journey-stop-position > div + div {
  margin-top: 4px;
}
.imap-journey-stop-position a {
  color: rgba(238,232,218,0.85);
  text-decoration: underline dotted rgba(238,232,218,0.35);
  text-underline-offset: 3px;
}
.imap-journey-stop-position a:hover {
  color: #d0a66a;
  text-decoration-color: #d0a66a;
}

.imap-journey-exit {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid rgba(202,163,106,0.25);
  width: 100%;
  background: transparent;
  border-left: none;
  border-right: none;
  border-bottom: none;
  color: var(--color-text-primary);
  font-size: 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.imap-journey-exit:hover { color: #eee8da; }

.imap-legend-controls-box {
  display: flex;
  flex-direction: row;
  gap: 1.75rem;
  align-items: flex-start;
  padding-bottom: 0.9rem;
  border-bottom: 0.5px solid rgba(202,163,106,0.18);
}
.imap-legend-controls-box .imap-style-btns { margin-top: 0; flex-shrink: 0; width: 190px; }
.imap-legend-checkboxes {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.imap-legend-checkboxes .imap-map-toggle:first-child {
  border-top: none;
  margin-top: 0;
  padding-top: 0;
}

.imap-legend-symbols-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.3rem 1.5rem;
  margin-top: 0.9rem;
}

.imap-legend-kingdoms-row {
  display: flex;
  flex-direction: row;
  gap: 1.5rem;
  justify-content: flex-end;
  margin-top: 1.2rem;
  padding-top: 0.9rem;
  border-top: 0.5px solid rgba(202,163,106,0.18);
}

/* Native MapLibre zoom/reset controls, moved from the default top-right
   corner to sit in the same horizontal row as the legend icon — all 4
   icons (legend, zoom in, zoom out, reset) in one row at top-left.
   Since they no longer sit below the legend icon, they're never in the
   legend dropdown's downward expansion path, so no repositioning logic
   is needed when the dropdown opens. */
#imap-container .maplibregl-ctrl-top-left {
  top: 10px !important;
  left: 56px !important;
  display: flex !important;
  flex-direction: row !important;
  gap: 6px;
}
#imap-container .maplibregl-ctrl-top-left .maplibregl-ctrl-group {
  display: flex !important;
  flex-direction: row !important;
  margin: 0 !important;
}
#imap-container .maplibregl-ctrl-top-left .maplibregl-ctrl-group button {
  border-radius: 4px !important;
}

#imap-region-panel {
  position: relative;
}
.imap-searchresult-close {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 26px;
  height: 26px;
  border: 1px solid rgba(92,70,42,0.2);
  background: rgba(255,255,255,0.5);
  border-radius: 3px;
  color: rgba(39,34,26,0.62);
  cursor: pointer;
  font-size: 15px;
  line-height: 1;
  z-index: 2;
}
.imap-searchresult-close:hover { background: rgba(255,255,255,0.75); color: #27221a; }

.imap-style-btns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 7px;
}

.imap-style-btn {
  min-width: 0;
  border: 1px solid transparent;
  background: transparent;
  color: rgba(238,232,218,0.68);
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.1;
  padding: 3px;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}

.imap-style-btn:hover {
  border-color: rgba(202,163,106,0.58);
  color: #eee8da;
}

.imap-style-btn.active {
  border-color: #caa36a;
  background: rgba(202,163,106,0.16);
  color: #f0d29a;
}

.imap-style-frame {
  display: block;
  width: 100%;
  aspect-ratio: 1.35 / 1;
  margin-bottom: 5px;
  border: 1px solid rgba(255,255,255,0.72);
