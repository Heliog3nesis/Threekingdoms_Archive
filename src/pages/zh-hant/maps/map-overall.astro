.province-label { position: absolute; transform: translate(-50%,-50%); display: flex; flex-direction: column; align-items: center; text-align: center; pointer-events: none; line-height: 1.2; filter: drop-shadow(0 1px 3px rgba(0,0,0,0.7)); }
.plabel-primary { font-size: 16px; font-weight: 600; color: #fff; letter-spacing: 0.02em; white-space: nowrap; }
.plabel-sub { font-size: 12px; color: rgba(255,255,255,0.65); white-space: nowrap; }

