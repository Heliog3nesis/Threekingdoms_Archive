  background-color: #1f241d;
  background-size: cover;
  background-position: center;
}

.imap-style-frame-topo {
  background-image: url('/mapbase/thumb-topography.webp');
}

.imap-style-frame-sat {
  background-image: url('/mapbase/thumb-satellite.webp');
}

/* overlay toggle rows */
.imap-toggle-row {
