---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import ContactModal from '../../../components/Contactmodal.astro';
import { t } from '../../../i18n/index.js';
import { url } from '../../../utils/url';

const lang = 'zh-hant';
const strings = t(lang);
---

<Base title={`檢索結果 · ${strings.siteTitle}`} lang={lang}>
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <div class="page-header">
      <div class="breadcrumb">
        <a href={url('/zh-hant/maps')} class="bc-link">地圖</a>
        <span class="bc-sep">›</span>
        <a href={url('/zh-hant/maps/map-overall')} class="bc-link">三國地圖</a>
        <span class="bc-sep">›</span>
        <span class="bc-cur" id="bc-query">檢索結果</span>
      </div>
      <h1 class="page-title">檢索結果</h1>
      <p class="page-sub" id="result-count">—</p>
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">
      <div class="filter-bar-left">
        <select class="filter-select" id="filter-type">
          <option value="all">所有類型</option>
        </select>
        <select class="filter-select" id="filter-kingdom">
          <option value="all">所有勢力</option>
          <option value="wei">魏</option>
          <option value="shu">蜀</option>
          <option value="wu">吳</option>
        </select>
        <label class="filter-exact">
          <input type="checkbox" id="filter-exact" />
          <span>精準匹配</span>
        </label>
      </div>
      <div class="filter-bar-right">
        <select class="filter-select" id="filter-sort">
          <option value="relevance">按相關度排序</option>
          <option value="az">地名 A → Z</option>
          <option value="za">地名 Z → A</option>
        </select>
      </div>
    </div>

    <!-- RESULTS TABLE -->
    <div class="results-wrap">
      <table class="results-table">
        <thead>
          <tr>
            <th>地名</th>
            <th>類型</th>
            <th>國</th>
            <th class="th-province">州</th>
            <th class="th-commandery">郡</th>
            <th class="col-map">地圖</th>
          </tr>
        </thead>
        <tbody id="results-body">
        </tbody>
      </table>
      <div class="results-empty" id="results-empty" style="display:none;">無符合地點</div>
    </div>

    <!-- PAGINATION -->
    <div class="pagination" id="pagination"></div>

    <footer class="site-footer">
      <span class="footer-quote">{strings.footer.quoteBySection?.maps ?? strings.footer.quote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<div id="search-payload" style="display:none;"></div>

<script>
// @ts-nocheck

const lang = document.documentElement.lang || 'en';
let allTowns = [];
let allWaterBodies = [];
let allAdminBoundaries = [];
import { url } from '../../../utils/url';

// Fixed display order for the Type filter — Admin. Boundary and Water Bodies
// are new top-level categories (select all admin/water results respectively,
// not a sub-Type match), everything else is the existing town Type values.
const TYPE_FILTER_ORDER = [
  'Admin. Boundary',
  'Provincial Seat',
  'Commandery Seat',
  'County Seat',
  'Landmark',
  'Military Pass',
  'Others',
  'Water Bodies',
];

async function loadData() {
  const [townsData, waterData, adminData] = await Promise.all([
    fetch(url(`/mapbase/All_Towns.json`)).then(r => r.json()),
    fetch(url(`/mapbase/all_water_bodies.json`)).then(r => r.json()).catch(() => ({ features: [] })),
    fetch(url(`/mapbase/All_Provinces.json`)).then(r => r.json()).catch(() => ({ features: [] })),
  ]);

  allTowns = townsData.All_Towns_Details ?? townsData ?? [];
  allWaterBodies = waterData.features ?? [];
  allAdminBoundaries = adminData.features ?? [];

  // populate type filter in fixed order now that data is ready
  const typeSelect = document.getElementById('filter-type');
  TYPE_FILTER_ORDER.forEach(value => {
    const opt = document.createElement('option');
    opt.value = value; opt.textContent = displayType(value);
    typeSelect.appendChild(opt);
  });

  // run initial render (reads q from URL)
  render();
}

loadData();

// ── PROVINCE → KINGDOM & PNG ────────────────────────────────────
const provinceKingdom = {
    'Bingzhou': 'wei', 'Jizhou': 'wei', 'Qingzhou': 'wei',
    'Yanzhou': 'wei', 'Yuzhou': 'wei', 'Youzhou': 'wei',
    'Liangzhou': 'wei', 'Sili': 'wei', 'Yongzhou': 'wei',
    'Xuzhou': 'wei', 'Jingzhou (Wei)': 'wei', 'Yangzhou (Wei)': 'wei',
    'Yizhou (South)': 'shu','Yizhou (North)': 'shu',
    'Jiaozhou': 'wu', 'Jingzhou (Wu)': 'wu', 'Yangzhou (Wu)': 'wu',
  };
 const provToPng = {
  'Bingzhou': url('/mapbase/Bingzhou.png'),
  'Jiaozhou': url('/mapbase/Jiaozhou.png'),
  'Jingzhou (Wei)': url('/mapbase/Jing_Wei.png'),
  'Jingzhou (Wu)': url('/mapbase/Jing_Wu.png'),
  'Jizhou': url('/mapbase/Jizhou.png'),
  'Liangzhou': url('/mapbase/Liangzhou.png'),
  'Qingzhou': url('/mapbase/Qing_Xu.png'),
  'Xuzhou': url('/mapbase/Qing_Xu.png'),
  'Sili': url('/mapbase/Sili.png'),
  'Yanzhou': url('/mapbase/Yan_Yu_Yang.png'),
  'Yuzhou': url('/mapbase/Yan_Yu_Yang.png'),
  'Yangzhou (Wei)': url('/mapbase/Yan_Yu_Yang.png'),
  'Yangzhou (Wu)': url('/mapbase/Yang_Wu.png'),
  'Yizhou (North)': url('/mapbase/Yi_North.png'),
  'Yizhou (South)': url('/mapbase/Yi_South.png'),
  'Yongzhou': url('/mapbase/Yongzhou.png'),
  'Youzhou': url('/mapbase/Youzhou.png'),
};
 
const kingdomLabel = { wei: '魏', shu: '蜀', wu: '吳' };
const typeLabel = { 'Admin. Boundary': '政區', 'Provincial Seat': '州治', 'Commandery Seat': '郡治', 'County Seat': '縣治', 'Military Pass': '關隘', Landmark: '地標', Others: '其他', 'Water Bodies': '水系' };
function displayType(type) { return typeLabel[type] || type || ''; }
function displayTownName(t) { return lang === 'zh-hans' ? (t.Town_CHS || t.Town_CH || t.Town_EN || '') : (t.Town_CH || t.Town_CHS || t.Town_EN || ''); }
function displayTownSub(t) { return t.Town_EN || ''; }
function displayProvince(t) { return lang === 'zh-hans' ? (t.Prov_CHS || t.Prov_CH || t.Prov_EN || '') : (t.Prov_CH || t.Prov_CHS || t.Prov_EN || ''); }
function displayCommandery(t) { return lang === 'zh-hans' ? (t.Comm_CHS || t.Comm_CH || t.Comm_EN || '') : (t.Comm_CH || t.Comm_CHS || t.Comm_EN || ''); }
const kingdomClass = { wei: 'b-wei', shu: 'b-shu', wu: 'b-wu' };

function getKingdom(provEn) {
  return provinceKingdom[provEn] ?? null;
}

// ── WATER BODY MATCHING (rivers/lakes; EN + both CH scripts + variants) ──
function waterBodyMatches(f, q, ql) {
  const p = f.properties;
  const candidates = [
    p.Name_EN,
    p.Name_CH,
    p.Name_CHS,
    ...(p.Name_CH_variants || []),
    ...(p.Name_CHS_variants || [])
  ].filter(Boolean);

  return candidates.some(v =>
    String(v).toLowerCase().includes(ql) || v.includes(q)
  );
}

// A stored name like "長江/江水" should count as an exact match for either
// "長江" or "江水" individually, not just the full combined string.
function exactNameMatches(stored, q, ql) {
  if (!stored) return false;
  if (String(stored).toLowerCase() === ql || stored === q) return true;

  return String(stored).split('/').some(part => {
    const trimmed = part.trim();
    return trimmed.toLowerCase() === ql || trimmed === q;
  });
}

function displayWaterName(f) {
  const p = f.properties;
  return p.Name_CH || p.Name_CHS || p.Name_EN || '';
}
function displayWaterSub(f) {
  return f.properties.Name_EN || '';
}
// tag shown in the Type column for water bodies.
function displayWaterType(f) {
  return f.properties.Type_CH || f.properties.Type || '河流';
}

// ── ADMIN BOUNDARY MATCHING (provinces/commanderies; EN + both CH scripts) ──
// "Yanzhou" -> "Yan Province"; used only for EN-form search matching, not
// for zh-hant display (the raw Chinese name already conveys 州/郡/國).
function formatProvinceLabel(provEn) {
  if (!provEn) return '';
  // Extract a trailing bracket like "(Wei)"/"(Wu)" separately so it can be
  // re-appended AFTER "Province" — doing the zhou->Province replacement on
  // the whole string put the bracket in the middle (e.g. "Jing (Wei)
  // Province"), which broke substring search for "Jing Province".
  const bracketMatch = provEn.match(/^(.*?)\s*(\([^)]+\))?$/);
  const base = (bracketMatch ? bracketMatch[1] : provEn).trim();
  const suffix = bracketMatch && bracketMatch[2] ? bracketMatch[2] : '';
  const formatted = /zhou/i.test(base)
    ? `${base.replace(/zhou/ig, '').trim()} Province`
    : `${base} (Capital Region)`;
  return suffix ? `${formatted} ${suffix}` : formatted;
}
function formatCommanderyLabel(nameEn, nameCh) {
  if (!nameEn) return '';
  const isState = (nameCh && nameCh.includes('國')) || /state$/i.test(nameEn.trim());
  return isState ? nameEn : `${nameEn} Commandery`;
}
function adminBoundaryMatches(f, q, ql) {
  const p = f.properties;
  const candidates = [p.Name_EN, p.Name_CH, p.Name_CHS].filter(Boolean);
  if (p.level === 'province') candidates.push(formatProvinceLabel(p.Name_EN));
  if (p.level === 'commandery') {
    candidates.push(formatCommanderyLabel(p.Name_EN, p.Name_CH));
    const isState = (p.Name_CH && p.Name_CH.includes('國')) || /state$/i.test((p.Name_EN || '').trim());
    if (isState) {
      const base = (p.Name_EN || '').replace(/\s*state$/i, '').trim();
      candidates.push(`${base} Guo`, `${base}Guo`);
    } else {
      candidates.push(`${p.Name_EN} Jun`, `${p.Name_EN}Jun`);
    }
  }

  return candidates.some(v => {
    const vl = String(v).toLowerCase();
    return v === q || vl.includes(ql);
  });
}
function displayAdminName(f) {
  const p = f.properties;
  return p.Name_CH || p.Name_CHS || p.Name_EN || '';
}
function displayAdminSub(f) {
  const p = f.properties;
  return p.level === 'province' ? formatProvinceLabel(p.Name_EN) : (p.Name_EN || '');
}
// 州/郡/臣屬部落 tag — same wording interactive-map.js's popup already uses for zh-hant.
function displayAdminType(f) {
  if (f.properties.level === 'commandery') return '郡';
  if (f.properties.level === 'tributary') return '臣屬部落';
  return '州';
}

// ── STATE ───────────────────────────────────────────────────────
const PER_PAGE = 15;
let currentPage = 1;
let currentResults = [];

// ── READ URL PARAMS ─────────────────────────────────────────────
function getParams() {
  const p = new URLSearchParams(window.location.search);
  return {
    q:       p.get('q')       || '',
    kingdom: p.get('kingdom') || 'all',
    type:    p.get('type')    || 'all',
    exact:   p.get('exact')   === 'true',
    sort:    p.get('sort')    || 'relevance',
    page:    parseInt(p.get('page') || '1'),
  };
}

function pushParams(overrides) {
  const params = { ...getParams(), ...overrides };
  const p = new URLSearchParams();
  if (params.q)       p.set('q', params.q);
  if (params.kingdom !== 'all') p.set('kingdom', params.kingdom);
  if (params.type    !== 'all') p.set('type', params.type);
  if (params.exact)   p.set('exact', 'true');
  if (params.sort !== 'relevance') p.set('sort', params.sort);
  if (params.page > 1) p.set('page', String(params.page));
  const newUrl = `${window.location.pathname}?${p.toString()}`;
  window.history.pushState({}, '', newUrl);
  render();
}

// ── FILTER & SORT ───────────────────────────────────────────────
function getResults(q, exact, kingdom, type, sort) {
  const ql = q.toLowerCase().trim();
  if (!ql) return [];

  let results;

  if (exact) {
    results = allTowns.filter(t =>
      t.Town_EN?.toLowerCase() === ql ||
      t.Town_CH === q ||
      t.Town_CHS === q
    );
  } else {
    // p1: exact town name
    const p1 = allTowns.filter(t =>
      t.Town_EN?.toLowerCase() === ql ||
      t.Town_CH === q || t.Town_CHS === q
    );
    const p1set = new Set(p1);
    // p2: partial town name
    const p2 = allTowns.filter(t =>
      !p1set.has(t) && (
        t.Town_EN?.toLowerCase().includes(ql) ||
        t.Town_CH?.includes(q) || t.Town_CHS?.includes(q)
      )
    );
    const p2set = new Set(p2);
    // p3: commandery / province
    const p3 = allTowns.filter(t =>
      !p1set.has(t) && !p2set.has(t) && (
        t.Comm_EN?.toLowerCase().includes(ql) ||
        t.Prov_EN?.toLowerCase().includes(ql) ||
        t.Comm_CHS?.includes(q) || t.Prov_CHS?.includes(q)
      )
    );
    results = [...p1, ...p2, ...p3];
  }

  const isAdminCategory = type === 'Admin. Boundary';
  const isWaterCategory = type === 'Water Bodies';

  if (kingdom !== 'all') results = results.filter(t => getKingdom(t.Prov_EN) === kingdom);
  if (isAdminCategory || isWaterCategory) {
    results = [];
  } else if (type !== 'all') {
    results = results.filter(t => t.Type === type);
  }

  // Water bodies (rivers/lakes) can span multiple kingdoms — match if the
  // selected kingdom is any of the kingdoms it touches.
  let waterResults = [];
  if (!isAdminCategory) {
    waterResults = exact
      ? allWaterBodies.filter(f => {
          const p = f.properties;
          return exactNameMatches(p.Name_EN, q, ql) ||
                 exactNameMatches(p.Name_CH, q, ql) ||
                 exactNameMatches(p.Name_CHS, q, ql);
        })
      : allWaterBodies.filter(f => waterBodyMatches(f, q, ql));

    if (kingdom !== 'all') {
      waterResults = waterResults.filter(f => (f.properties.kingdoms || []).includes(kingdom));
    }

    if (!isWaterCategory && type !== 'all') {
      waterResults = waterResults.filter(f => f.properties.Type === type);
    }
  }

  // Admin boundaries (provinces/commanderies) — Type filter doesn't apply
  // to sub-Type matching, only to the Admin. Boundary category itself.
  let adminResults = exact
    ? allAdminBoundaries.filter(f => {
        const p = f.properties;
        return exactNameMatches(p.Name_EN, q, ql) ||
               exactNameMatches(p.Name_CH, q, ql) ||
               exactNameMatches(p.Name_CHS, q, ql);
      })
    : allAdminBoundaries.filter(f => adminBoundaryMatches(f, q, ql));

  if (kingdom !== 'all') adminResults = adminResults.filter(f => f.properties.kingdom === kingdom);
  if (isWaterCategory) {
    adminResults = [];
  } else if (!isAdminCategory && type !== 'all') {
    adminResults = [];
  }

  const combined = [
    ...results.map(t => ({ _kind: 'town', _sortName: displayTownName(t), data: t })),
    ...waterResults.map(f => ({ _kind: 'water', _sortName: displayWaterName(f), data: f })),
    ...adminResults.map(f => ({ _kind: 'admin', _sortName: displayAdminName(f), data: f }))
  ];

  if (sort === 'az') combined.sort((a, b) => a._sortName.localeCompare(b._sortName, 'zh-hant-u-co-pinyin'));
  if (sort === 'za') combined.sort((a, b) => b._sortName.localeCompare(a._sortName, 'zh-hant-u-co-pinyin'));

  return combined;
}

// ── RENDER ──────────────────────────────────────────────────────
function render() {
  const { q, kingdom, type, exact, sort, page } = getParams();

  // sync controls
  document.getElementById('filter-kingdom').value = kingdom;
  document.getElementById('filter-type').value    = type;
  document.getElementById('filter-exact').checked = exact;
  document.getElementById('filter-sort').value    = sort;

  // breadcrumb + title
  document.getElementById('bc-query').textContent = q ? `"${q}"` : '檢索結果';

  currentResults = getResults(q, exact, kingdom, type, sort);
  currentPage    = Math.max(1, Math.min(page, Math.ceil(currentResults.length / PER_PAGE)));

  const total   = currentResults.length;
  const start   = (currentPage - 1) * PER_PAGE;
  const pageRows = currentResults.slice(start, start + PER_PAGE);

  document.getElementById('result-count').textContent =
    total === 0 ? '無符合地點' : `共${total}條`;
  const tbody = document.getElementById('results-body');
  const empty = document.getElementById('results-empty');

  if (total === 0) {
    tbody.innerHTML = '';
    empty.style.display = 'block';
  } else {
    empty.style.display = 'none';
    tbody.innerHTML = pageRows.map(result => {
      if (result._kind === 'water') {
        const p = result.data.properties;
        const displayKingdoms = p.display_kingdoms || [];
        const badge = displayKingdoms.length
          ? displayKingdoms.map(k => `<span class="badge ${kingdomClass[k]}">${kingdomLabel[k]}</span>`).join(' ')
          : '<span class="badge b-water"><i class="ti ti-droplet"></i></span>';
        const pngUrl = provToPng[p.primary_province];
        const pngBtn = pngUrl ? `<button class="result-action" data-png="${pngUrl}" title="查看該州圖版地圖"><i class="ti ti-map-2"></i></button>` : '';
        const mapBtn = `<button class="result-action result-action-water" data-id="${p.id}" title="在互動地圖中查看"><i class="ti ti-map-pin"></i></button>`;
        // Lakes: single dominant province, up to 2 commanderies (genuinely split ones).
        // Rivers: every province touched with meaningful overlap, commanderies left blank.
        const provinceText = (p.display_provinces_ch?.length ? p.display_provinces_ch : p.display_provinces || []).join(', ') || '—';
        const commanderyText = (p.display_commanderies_ch?.length ? p.display_commanderies_ch : p.display_commanderies || []).join(', ') || '—';
        return `<tr>
          <td class="td-name">
            <span class="td-name-primary">${displayWaterName(result.data) || '—'}</span>
            <span class="td-name-sub">${displayWaterSub(result.data)}</span>
          </td>
          <td>${displayWaterType(result.data)}</td>
          <td>${badge}</td>
          <td class="td-region">${provinceText}</td>
          <td class="td-region">${commanderyText}</td>
          <td class="td-map"><div style="display:flex;flex-direction:row;align-items:center;gap:6px;">${pngBtn}${mapBtn}</div></td>
        </tr>`;
      }

      if (result._kind === 'admin') {
        const p = result.data.properties;
        const isCommandery = p.level === 'commandery';
        const isTributary = p.level === 'tributary';
        const badge = p.kingdom
          ? `<span class="badge ${kingdomClass[p.kingdom]}">${kingdomLabel[p.kingdom]}</span>`
          : '—';
        const pngUrl = provToPng[p.Prov_EN];
        const pngBtn = pngUrl ? `<button class="result-action" data-png="${pngUrl}" title="查看該州圖版地圖"><i class="ti ti-map-2"></i></button>` : '';
        const mapBtn = `<button class="result-action result-action-admin" data-id="${p.id}" title="在互動地圖中查看"><i class="ti ti-map-pin"></i></button>`;
        return `<tr>
          <td class="td-name">
            <span class="td-name-primary">${displayAdminName(result.data) || '—'}</span>
            <span class="td-name-sub">${displayAdminSub(result.data)}</span>
          </td>
          <td>${displayAdminType(result.data)}</td>
          <td>${badge}</td>
          <td class="td-region">${p.Prov_CH || p.Prov_CHS || p.Prov_EN || '—'}</td>
          <td class="td-region">${(isCommandery || isTributary) ? (p.Name_CH || p.Name_CHS || p.Name_EN) : '—'}</td>
          <td class="td-map"><div style="display:flex;flex-direction:row;align-items:center;gap:6px;">${pngBtn}${mapBtn}</div></td>
        </tr>`;
      }

      const t = result.data;
      const k      = getKingdom(t.Prov_EN);
      const badge  = k
        ? `<span class="badge ${kingdomClass[k]}">${kingdomLabel[k]}</span>`
        : '—';
      const pngUrl  = provToPng[t.Prov_EN];
      const pngBtn  = pngUrl
        ? `<button class="result-action" data-png="${pngUrl}" title="查看該州圖版地圖"><i class="ti ti-map-2"></i></button>`
        : '';
      const mapBtn  = `<button class="result-action result-action-map" data-lat="${t.Latitude}" data-lng="${t.Longitude}" title="在互動地圖中查看"><i class="ti ti-map-pin"></i></button>`;
      return `<tr>
        <td class="td-name">
          <span class="td-name-primary">${displayTownName(t) || '—'}</span>
          <span class="td-name-sub">${displayTownSub(t)}</span>
        </td>
        <td>${displayType(t.Type) || '—'}</td>
        <td>${badge}</td>
        <td class="td-region">${displayProvince(t) || '—'}</td>
        <td class="td-region">${displayCommandery(t) || '—'}</td>
        <td class="td-map"><div style="display:flex;flex-direction:row;align-items:center;gap:6px;">${pngBtn}${mapBtn}</div></td>
      </tr>`;
    }).join('');

    // wire action buttons
    tbody.querySelectorAll('.result-action[data-png]').forEach(btn => {
      btn.addEventListener('click', () => window.open(btn.dataset.png, '_blank'));
    });
    tbody.querySelectorAll('.result-action-map').forEach(btn => {
      btn.addEventListener('click', () => {
      const params = new URLSearchParams({
          lat: btn.dataset.lat,
          lng: btn.dataset.lng,
        });
        const row = btn.closest('tr');
        const name = row?.querySelector('.td-name-primary')?.textContent?.trim();
        if (name) params.set('name', name);
        window.location.href = url(
        `/zh-hant/maps/map-overall?${params.toString()}`
      );
      });
    });
    tbody.querySelectorAll('.result-action-water').forEach(btn => {
      btn.addEventListener('click', () => {
        const params = new URLSearchParams({ water: btn.dataset.id });
        window.location.href = url(`/zh-hant/maps/map-overall?${params.toString()}`);
      });
    });
    tbody.querySelectorAll('.result-action-admin').forEach(btn => {
      btn.addEventListener('click', () => {
        const params = new URLSearchParams({ admin: btn.dataset.id });
        window.location.href = url(`/zh-hant/maps/map-overall?${params.toString()}`);
      });
    });
  }

  renderPagination(total, currentPage);
}

// ── PAGINATION ──────────────────────────────────────────────────
function renderPagination(total, page) {
  const totalPages = Math.ceil(total / PER_PAGE);
  const el = document.getElementById('pagination');
  if (totalPages <= 1) { el.innerHTML = ''; return; }

  function pageBtn(n, label, disabled, active) {
    return `<button class="page-btn${active ? ' active' : ''}${disabled ? ' disabled' : ''}"
      data-page="${n}" ${disabled ? 'disabled' : ''}>${label}</button>`;
  }

  // build page number list with ellipsis
  const pages = [];
  if (totalPages <= 7) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
  } else {
    pages.push(1);
    if (page > 3) pages.push('…');
    for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) pages.push(i);
    if (page < totalPages - 2) pages.push('…');
    pages.push(totalPages);
  }

  el.innerHTML = [
    pageBtn(page - 1, '上一頁', page === 1, false),
    ...pages.map(p => p === '…'
      ? `<span class="page-ellipsis">…</span>`
      : pageBtn(p, p, false, p === page)
    ),
    pageBtn(page + 1, '下一頁', page === totalPages, false),
  ].join('');

  el.querySelectorAll('.page-btn:not(.disabled)').forEach(btn => {
    btn.addEventListener('click', () => pushParams({ page: parseInt(btn.dataset.page) }));
  });
}

// ── FILTER CONTROLS ─────────────────────────────────────────────
document.getElementById('filter-kingdom').addEventListener('change', e => pushParams({ kingdom: e.target.value, page: 1 }));
document.getElementById('filter-type').addEventListener('change',    e => pushParams({ type: e.target.value,    page: 1 }));
document.getElementById('filter-exact').addEventListener('change',   e => pushParams({ exact: e.target.checked, page: 1 }));
document.getElementById('filter-sort').addEventListener('change',    e => pushParams({ sort: e.target.value,    page: 1 }));
window.addEventListener('popstate', render);
</script>

