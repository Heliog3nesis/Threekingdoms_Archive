---
// NOTE ON PATHS/ASSUMPTIONS — please verify and adjust:
// - Import paths assume this file lives at src/pages/translations/jiankang-map.astro
//   (2 levels under src/pages/, matching your other translations pages).
// - IMAGE_SRC below is a placeholder — point it at wherever you actually store
//   the scanned map image (e.g. public/maps/jiankang-map.jpg).
// - markersData below is sample placeholder data (box schema — see the
//   digitizer tool for how to generate real values from your existing
//   point JSON).
// - Breadcrumb parent link/text and siteTitle assume the same i18n structure
//   (strings.nav.translations, strings.siteTitle) used throughout your site.

import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import ContactModal from '../../components/Contactmodal.astro';
import { t } from '../../i18n/index.js';
import { url } from '../../utils/url';
import mapData from '../../data/translations/jiankang-map-markers.json';

const lang: string = 'en';
const strings = t(lang);
const cnField = lang === 'zh-hans' ? 'zhs' : 'zht';
const cnLangAttr = cnField === 'zhs' ? 'zh-hans' : 'zh-hant';

function cn(field: any) {
  return field?.[cnField] ?? field?.zht ?? field?.zhs ?? '';
}

function hasContent(field: any) {
  return Boolean(field?.en || field?.zht || field?.zhs);
}

const PAGE_TITLE = { zht: '東晉都建康圖', zhs: '东晋都建康图', en: 'Map of the Capital of Eastern Jin, Jiankang' };
const PAGE_META = {
  en: 'Chen Yi · Ming dynasty (16th century) · A Cartographic Study of Jinling, Past and Present',
  zht: '陳沂 · 明 · 《金陵古今圖考》',
  zhs: '陈沂 · 明 · 《金陵古今图考》',
};
const IMAGE_SRC = '/jinling.png'; 
const markers = mapData.markers as any[];
const references = mapData.references as any[];
---

<Base title={`${PAGE_TITLE.en} · ${strings.siteTitle}`} lang="en">
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <div class="page-header">
      <div class="breadcrumb">
        <a href={url('/translations')} class="bc-link">{strings.nav.translations}</a>
        <span class="bc-sep">›</span>
        <span class="bc-cur">{PAGE_TITLE.en}</span>
      </div>
      <h1 class="page-title">{PAGE_TITLE.en}</h1>
      <p class="page-sub" lang={cnLangAttr}>{cn(PAGE_TITLE)}</p>
      <p class="map-meta">{PAGE_META.en}</p>
    </div>

    <div class="map-layout">
      <div class="map-stage-wrap">
        <div class="map-toolbar">
          <span class="map-hint">
            <i class="ti ti-hand-click" aria-hidden="true"></i>
            Pinch or scroll to zoom, drag to pan.
          </span>
          <label class="map-num-toggle">
            <input type="checkbox" id="num-toggle" checked />
            <span class="map-num-toggle-track"><span class="map-num-toggle-thumb"></span></span>
            <span>Show numbers</span>
          </label>
        </div>

        <div class="map-viewport" id="map-viewport">
          <div class="map-content" id="map-content">
            <img src={url(IMAGE_SRC)} alt={PAGE_TITLE.en} id="map-image" draggable="false" />
            <div class="hotspot-layer" id="hotspot-layer">
              {markers.map((m: any) => (
                <button
                  class="map-hotspot"
                  style={`left:${m.x}%; top:${m.y}%; width:${m.w}%; height:${m.h}%;`}
                  data-id={m.id}
                  type="button"
                  aria-label={`${m.label.en} / ${cn(m.label)}`}
                >
                  <span class="map-hotspot-num">{m.num}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="map-controls">
          <button id="zoom-in" aria-label="Zoom in" type="button"><i class="ti ti-plus" aria-hidden="true"></i></button>
          <button id="zoom-out" aria-label="Zoom out" type="button"><i class="ti ti-minus" aria-hidden="true"></i></button>
          <button id="zoom-reset" aria-label="Reset view" type="button"><i class="ti ti-arrows-maximize" aria-hidden="true"></i></button>
        </div>
      </div>

      <div class="map-panel">
        <div class="map-panel-label">Locations</div>
        <div class="map-panel-list" id="panel-list">
          {markers.map((m: any) => (
            <div class="panel-item" data-id={m.id}>
              <button class="panel-item-head" type="button">
                <i class="ti ti-chevron-right panel-item-chevron" aria-hidden="true"></i>
                <span class="panel-item-num">{m.num}</span>
                <span class="panel-item-names">
                  <span class="panel-item-primary">{m.label.en}</span>
                  <span class="panel-item-secondary" lang={cnLangAttr}>{cn(m.label)}</span>
                </span>
              </button>
              <div class="panel-item-note">
                <p class="panel-item-note-en" set:html={m.note?.en} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {references.some((r: any) => hasContent(r)) && (
      <div class="map-references" id="references">
        <div class="map-references-label">References</div>
        <ol class="map-references-list">
          {references.map((r: any) => (
            <li id={`ref-${r.id}`}>
              {r.en && <span class="map-ref-primary" set:html={r.en} />}
              {cn(r) && <span class="map-ref-secondary" lang={cnLangAttr} set:html={cn(r)} />}
            </li>
          ))}
        </ol>
      </div>
    )}

    <footer class="site-footer">
      <span class="footer-quote">{strings.footer.quoteBySection?.translations ?? strings.footer.quote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<script src="https://cdn.jsdelivr.net/npm/panzoom@9.4.3/dist/panzoom.min.js"></script>
<script>
  declare const panzoom: (el: Element, options?: Record<string, unknown>) => any;

  document.addEventListener('DOMContentLoaded', () => {
    const viewport = document.getElementById('map-viewport');
    const content = document.getElementById('map-content');
    const numToggle = document.getElementById('num-toggle') as HTMLInputElement | null;
    const hotspotLayer = document.getElementById('hotspot-layer');
    const panelList = document.getElementById('panel-list');
    const imgEl = document.getElementById('map-image') as HTMLImageElement | null;
    const zoomInBtn = document.getElementById('zoom-in');
    const zoomOutBtn = document.getElementById('zoom-out');
    const zoomResetBtn = document.getElementById('zoom-reset');

    if (
      !viewport || !content || !numToggle || !hotspotLayer || !panelList ||
      !imgEl || !zoomInBtn || !zoomOutBtn || !zoomResetBtn
    ) {
      return;
    }

    const instance = panzoom(content, {
      maxZoom: 6,
      minZoom: 0.05,
      zoomDoubleClickSpeed: 1
    });

    // Keep the panel's height matched to the map's actual rendered height,
    // on every screen size — one rule instead of separate desktop/mobile
    // CSS approximations. The list scrolls internally beyond that height.
    const mapPanel = document.querySelector<HTMLElement>('.map-panel');
    const syncPanelHeight = () => {
      if (!mapPanel) return;
      const h = viewport.getBoundingClientRect().height;
      mapPanel.style.maxHeight = `${h}px`;
    };
    syncPanelHeight();
    window.addEventListener('resize', syncPanelHeight);

    let expandedId: string | null = null;

    const setExpanded = (id: string | null) => {
      const isSame = expandedId === id;
      expandedId = isSame ? null : id;

      panelList.querySelectorAll('.panel-item').forEach((item) => {
        const itemId = item.getAttribute('data-id');
        item.classList.toggle('expanded', itemId === expandedId);
      });

      hotspotLayer.querySelectorAll('.map-hotspot').forEach((el) => {
        el.classList.toggle('active', el.getAttribute('data-id') === expandedId);
      });
    };

    const selectAndReveal = (id: string | null) => {
      setExpanded(id);
      const panelItem = panelList.querySelector(`.panel-item[data-id="${id}"]`);
      panelItem?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    hotspotLayer.querySelectorAll('.map-hotspot').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        selectAndReveal(el.getAttribute('data-id'));
      });
    });

    panelList.querySelectorAll('.panel-item-head').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.closest('.panel-item')?.getAttribute('data-id') ?? null;
        selectAndReveal(id);
      });
    });

    numToggle.addEventListener('change', () => {
      hotspotLayer.classList.toggle('nums-hidden', !numToggle.checked);
    });

    zoomInBtn.addEventListener('click', () => {
      const rect = viewport.getBoundingClientRect();
      instance.smoothZoom(rect.width / 2, rect.height / 2, 1.4);
    });
    zoomOutBtn.addEventListener('click', () => {
      const rect = viewport.getBoundingClientRect();
      instance.smoothZoom(rect.width / 2, rect.height / 2, 1 / 1.4);
    });
    // Computes the zoom level that fits the ENTIRE image inside the current
    // viewport (rather than hardcoding zoom=1, which only shows the
    // image's natural pixel size — correct only by coincidence when the
    // scan's resolution happens to roughly match the viewport size. On a
    // narrower viewport (mobile), zoom=1 very visibly only showed the
    // top-left corner, since the natural-resolution image is larger than
    // the viewport box).
    const fitToView = () => {
      const viewportRect = viewport.getBoundingClientRect();
      const naturalWidth = imgEl.naturalWidth || imgEl.clientWidth;
      const naturalHeight = imgEl.naturalHeight || imgEl.clientHeight;
      if (!naturalWidth || !naturalHeight) return;
      const scale = Math.min(viewportRect.width / naturalWidth, viewportRect.height / naturalHeight);
      const offsetX = (viewportRect.width - naturalWidth * scale) / 2;
      const offsetY = (viewportRect.height - naturalHeight * scale) / 2;
      instance.zoomAbs(0, 0, scale);
      instance.moveTo(offsetX, offsetY);
    };

    if (imgEl.complete) {
      fitToView();
    } else {
      imgEl.addEventListener('load', fitToView, { once: true });
    }

    zoomResetBtn.addEventListener('click', fitToView);
  });
</script>

<style is:global>
.site { max-width: 100%; background: var(--color-bg); }

.page-header { padding: 2rem 2rem 1.75rem; border-bottom: 0.5px solid var(--color-border); }
.breadcrumb { display: flex; align-items: center; gap: 6px; margin-bottom: 0.75rem; flex-wrap: wrap; }
.bc-link { font-size: 15px; color: #d5ad6b; text-decoration: none; }
.bc-link:hover { color: #f0d39a; }
.bc-sep { font-size: 14px; color: rgba(232,221,202,0.35); }
.bc-cur { font-size: 16px; color: rgba(232,221,202,0.66); }
.page-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px; font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 4px;
}
.page-title:lang(zh-hans) { font-family: 'Noto Serif SC', serif; }
.page-title:lang(zh-hant) { font-family: 'Noto Serif TC', serif; }
.page-sub { font-size: 20px; color: var(--color-text-secondary); margin-bottom: 4px; }
.page-sub:lang(zh-hans) { font-family: 'Noto Serif SC', serif; }
.page-sub:lang(zh-hant) { font-family: 'Noto Serif TC', serif; }
.map-meta { font-size: 15px; color: var(--color-text-tertiary); }

.map-layout { display: grid; grid-template-columns: 1.7fr 1fr; gap: 1.5rem; padding: 1.5rem 2rem; }

.map-stage-wrap { position: relative; }
.map-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 0.75rem; flex-wrap: wrap; }
.map-hint { display: flex; align-items: center; gap: 6px; font-size: 16px; color: var(--color-text-tertiary); }

.map-num-toggle { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; font-size: 13px; color: var(--color-text-tertiary); }
.map-num-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
.map-num-toggle-track { width: 32px; height: 18px; border-radius: 10px; background: var(--color-border); position: relative; flex-shrink: 0; transition: background 0.15s; }
.map-num-toggle-thumb { position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-text-tertiary); transition: transform 0.15s, background 0.15s; }
.map-num-toggle input:checked + .map-num-toggle-track { background: rgba(208, 170, 107, 0.3); }
.map-num-toggle input:checked + .map-num-toggle-track .map-num-toggle-thumb { transform: translateX(14px); background: var(--archive-gold-soft, #d0aa6b); }

.map-viewport {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border: 0.5px solid var(--color-border);
  border-radius: var(--radius-lg, var(--radius-md));
  background: #0d0d0c;
  touch-action: none;
  cursor: grab;
}
.map-viewport:active { cursor: grabbing; }

.map-content { position: absolute; top: 0; left: 0; transform-origin: 0 0; }
.map-content img { display: block; max-width: none; user-select: none; }

.hotspot-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }

.map-hotspot {
  position: absolute;
  border: 1px solid transparent;
  border-radius: 4px;
  background: transparent;
  cursor: pointer;
  pointer-events: all;
  padding: 0;
  transition: background 0.15s, border-color 0.15s;
}
.map-hotspot:hover, .map-hotspot.active { background: rgba(208, 170, 107, 0.32); border-width: 2px; border-color: var(--archive-gold-soft, #d0aa6b); }

.map-hotspot-num {
  position: absolute;
  top: -9px; left: -9px;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: var(--archive-gold-soft, #d0aa6b);
  color: #1a1508;
  font-size: 11px; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  border: 1.5px solid #1a1508;
}
.hotspot-layer.nums-hidden .map-hotspot-num { display: none; }

.map-hotspot.active .map-hotspot-num { background: #d1453a; color: #fff; border-color: #6e1f18; }

.map-controls {
  position: absolute;
  bottom: 0.75rem; right: 0.75rem;
  display: flex; flex-direction: column; gap: 4px;
  z-index: 2;
}
.map-controls button {
  width: 32px; height: 32px;
  border-radius: var(--radius-md);
  border: 0.5px solid var(--color-border);
  background: rgba(13,13,12,0.85);
  color: var(--color-text-secondary);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  font-size: 15px;
}
.map-controls button:hover { background: var(--color-bg-secondary); color: var(--color-text-primary); }

.map-panel { display: flex; flex-direction: column; border: 0.5px solid var(--color-border); border-radius: var(--radius-lg, var(--radius-md)); overflow: hidden; }
.map-panel-label { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-tertiary); padding: 0.85rem 1rem 0.6rem; flex-shrink: 0; }
.map-panel-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 0.5rem 0.5rem;
  scrollbar-width: thin;
  scrollbar-color: var(--color-border) transparent;
}
.map-panel-list::-webkit-scrollbar { width: 6px; }
.map-panel-list::-webkit-scrollbar-track { background: transparent; }
.map-panel-list::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 3px; }
.map-panel-list::-webkit-scrollbar-thumb:hover { background: var(--color-text-tertiary); }

.panel-item { border-bottom: 0.5px solid var(--color-border); }
.panel-item:last-child { border-bottom: none; }
.panel-item-head {
  width: 100%;
  display: flex; align-items: center; gap: 8px;
  background: none; border: none;
  padding: 0.6rem 0.5rem;
  cursor: pointer;
  text-align: left;
}
.panel-item-chevron { font-size: 11px; color: var(--color-text-tertiary); transition: transform 0.15s; flex-shrink: 0; }
.panel-item.expanded .panel-item-chevron { transform: rotate(90deg); }
.panel-item-num { font-size: 19px; color: var(--archive-gold-soft, #d0aa6b); flex-shrink: 0; }
.panel-item-names { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.panel-item-primary { font-size: 19px; font-weight: 500; color: var(--color-text-primary); }
.panel-item-secondary { font-size: 18px; color: var(--color-text-tertiary); }
.panel-item-primary:lang(zh-hans), .panel-item-primary:lang(zh-hant),
.panel-item-secondary:lang(zh-hans), .panel-item-secondary:lang(zh-hant) { font-family: 'LXGW WenKai', serif; }

.panel-item-note { display: none; padding: 0 0.5rem 0.75rem 1.9rem; }
.panel-item.expanded .panel-item-note { display: block; }
.panel-item-note-en { font-size: 17px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 4px; }
.panel-item-note-zh { font-family: 'LXGW WenKai', serif; font-size: 17px; color: var(--color-text-tertiary); line-height: 1.6; }

.note-ref { font-size: 0.75em; margin-left: 1px; }
.note-ref a { color: var(--archive-gold-soft, #d0aa6b); text-decoration: none; }
.note-ref a:hover { text-decoration: underline; }

.map-references { padding: 0 2rem 1.5rem; }
.map-references-label { font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-tertiary); margin-bottom: 0.6rem; }
.map-references-list { list-style: none; counter-reset: refs; padding: 0; margin: 0; border-top: 0.5px solid var(--color-border); }
.map-references-list li {
  counter-increment: refs;
  display: flex;
  gap: 8px;
  padding: 0.5rem 0;
  border-bottom: 0.5px solid var(--color-border);
  scroll-margin-top: 80px;
}
.map-references-list li::before {
  content: counter(refs) '.';
  color: var(--archive-gold-soft, #d0aa6b);
  font-size: 16px;
  flex-shrink: 0;
}
.map-ref-primary { font-size: 16px; color: var(--color-text-secondary); line-height: 1.6; }
.map-ref-secondary { font-size: 16px; color: var(--color-text-tertiary); line-height: 1.6; margin-left: 6px; }
.map-ref-primary:lang(zh-hans), .map-ref-primary:lang(zh-hant),
.map-ref-secondary:lang(zh-hans), .map-ref-secondary:lang(zh-hant) { font-family: 'LXGW WenKai', serif; }

.site-footer { border-top: 0.5px solid var(--color-border); padding: 0.875rem 2rem; display: flex; justify-content: space-between; align-items: center; background: var(--color-bg-secondary); margin-top: 1rem; }
.footer-right { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
.footer-copy { font-size: 0.82rem; color: var(--color-text-tertiary); }
.footer-github { color: var(--color-text-tertiary); font-size: 18px; text-decoration: none; transition: color 0.15s; }
.footer-github:hover { color: var(--color-text-primary); }
.footer-quote { font-family: 'Inter', serif; font-size: 0.8rem; color: var(--color-text-tertiary); font-style: italic; white-space: pre-line; }

@media (max-width: 800px) {
  .page-header { padding: 1.5rem 1rem; }
  .map-layout { grid-template-columns: 1fr; padding: 1rem; gap: 1rem; }
  .map-references { padding: 0 1rem 1rem; }
  .site-footer { flex-direction: column; align-items: center; gap: 0.75rem; padding: 1rem; text-align: center; }
}
</style>