---
import Base from '../../../../layouts/Base.astro';
import Nav from '../../../../components/Nav.astro';
import ContactModal from '../../../../components/Contactmodal.astro';
import { t } from '../../../../i18n/index.js';
import { url } from '../../../../utils/url';

const TEXT_TITLE = { zht: '三國志', zhs: '三国志', en: 'Records of the Three Kingdoms' };

const chapterModules = import.meta.glob('../../../../data/sgz/*.json', { eager: true });

const chapters = Object.values(chapterModules)
  .map((mod: any) => mod.default ?? mod)
  .sort((a: any, b: any) => a.order - b.order);

// Sidebar sections, grouped by book, in the order chapters first appear
const bookSections: any[] = [];
const bookMap = new Map<string, any>();
for (const ch of chapters) {
  if (!bookMap.has(ch.book)) {
    const section = { id: ch.book, label: ch.bookLabel, chapters: [] as any[] };
    bookMap.set(ch.book, section);
    bookSections.push(section);
  }
  bookMap.get(ch.book).chapters.push(ch);
}

export function getStaticPaths() {
  const mods = import.meta.glob('../../../../data/sgz/*.json', { eager: true });
  const chs = Object.values(mods)
    .map((mod: any) => mod.default ?? mod)
    .sort((a: any, b: any) => a.order - b.order);
  const paths: any[] = [{ params: { chapter: undefined } }]; // cover
  for (const ch of chs) {
    paths.push({ params: { chapter: ch.id } });
  }
  return paths;
}

const chapterId = Astro.params.chapter as string | undefined;
const isCover = !chapterId;
const currentIndex = isCover ? -1 : chapters.findIndex((c: any) => c.id === chapterId);
const currentChapter = currentIndex >= 0 ? chapters[currentIndex] : null;
const prevChapter = currentIndex > 0 ? chapters[currentIndex - 1] : null;
const nextChapter = currentIndex >= 0 && currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null;

const lang: string = 'zh-hans';
const strings = t(lang);
const cnField = lang === 'zh-hans' ? 'zhs' : 'zht';
const cnLangAttr = cnField === 'zhs' ? 'zh-hans' : 'zh-hant';

function cn(field: any) {
  return field?.[cnField] ?? field?.zht ?? field?.zhs ?? '';
}

function linkify(text: string): string {
  const escaped = String(text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return escaped.replace(/\[\[([^|\]]+)\|([^\]]+)\]\]/g, (_match, label, rawUrl) => {
    const isLocation = rawUrl.includes('/maps');
    const isOfficial = rawUrl.includes('/officials');
    const typeClass = isLocation ? ' term-link-loc' : isOfficial ? ' term-link-off' : '';
    const icon = isLocation
      ? '<i class="ti ti-map-pin term-link-icon" aria-hidden="true"></i>'
      : isOfficial
      ? '<i class="ti ti-file-text term-link-icon" aria-hidden="true"></i>'
      : '';
    return `<a href="${url(rawUrl)}" class="term-link${typeClass}" target="_blank" rel="noopener">${label}${icon}</a>`;
  });
}

const baseUrl = url('/zh-hans/translations/sanguozhi');
const chapterUrl = (id: string) => `${baseUrl}/${id}`;

// Only chapters with real translated content — used for the cover's Contents list
const translatedChapters = chapters.filter((c: any) => c.passages && c.passages.length > 0);
const coverChapters = translatedChapters.length > 0 ? translatedChapters : chapters;

// Embedded once, used by client JS to swap content with no reload/fetch
const clientData = JSON.stringify({ chapters, bookSections, baseUrl, initialChapterId: chapterId ?? null }).replace(/</g, '\\u003c');
---

<Base title={`${cn(TEXT_TITLE)} · ${strings.siteTitle}`} lang="zh-hans">
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <div class="reader-layout">
      <!-- ══ Desktop sidebar ══ -->
      <aside class="sidebar" id="sidebar-desktop">
        <a href={baseUrl} class="sb-header sb-header-link" data-sgz-link data-chapter="">
          <div class="sb-text-title" lang={cnLangAttr}>{cn(TEXT_TITLE)}</div>
          <div class="sb-text-sub">{TEXT_TITLE.en}</div>
        </a>
        <nav class="sb-scroll" id="sb-scroll-desktop">
          {bookSections.map((book: any) => (
            <div class="sb-section">
              <div class="sb-section-label">
                <span lang={cnLangAttr}>{cn(book.label)}</span> {book.label.en}
              </div>
              <div class="sb-chapter-list">
                {book.chapters.map((ch: any) => (
                  <a
                    href={chapterUrl(ch.id)}
                    class:list={['sb-ch', { on: ch.id === chapterId }]}
                    data-sgz-link
                    data-chapter={ch.id}
                  >
                    <span class="sb-ch-num">{ch.num}</span>
                    <div>
                      <div class="sb-ch-zh" lang={cnLangAttr}>{cn(ch.label)}</div>
                      <div class="sb-ch-en">{ch.label.en}</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
      </aside>

      <!-- ══ Mobile drawer + overlay ══ -->
      <div class="mob-overlay" id="mob-overlay"></div>
      <aside class="sidebar mob-drawer" id="mob-drawer">
        <div class="sb-header" style="display:flex;align-items:center;justify-content:space-between">
          <a href={baseUrl} class="sb-header-link" data-sgz-link data-chapter="">
            <div class="sb-text-title" lang={cnLangAttr}>{cn(TEXT_TITLE)}</div>
            <div class="sb-text-sub">{TEXT_TITLE.en}</div>
          </a>
          <button class="mob-drawer-close" id="mob-drawer-close" aria-label="Close chapter list">
            <i class="ti ti-x" aria-hidden="true"></i>
          </button>
        </div>
        <nav class="sb-scroll" id="sb-scroll-mobile">
          {bookSections.map((book: any) => (
            <div class="sb-section">
              <div class="sb-section-label">
                <span lang={cnLangAttr}>{cn(book.label)}</span> {book.label.en}
              </div>
              <div class="sb-chapter-list">
                {book.chapters.map((ch: any) => (
                  <a
                    href={chapterUrl(ch.id)}
                    class:list={['sb-ch', { on: ch.id === chapterId }]}
                    data-sgz-link
                    data-chapter={ch.id}
                  >
                    <span class="sb-ch-num">{ch.num}</span>
                    <div>
                      <div class="sb-ch-zh" lang={cnLangAttr}>{cn(ch.label)}</div>
                      <div class="sb-ch-en">{ch.label.en}</div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
      </aside>

      <!-- ══ Main content (re-rendered client-side on navigation) ══ -->
      <div class="main">
        <div class="mob-toolbar">
          <button class="mob-menu-btn" id="mob-menu-btn" aria-label="Open chapter list">
            <i class="ti ti-menu-2" aria-hidden="true"></i>
          </button>
        <div class="mob-toolbar-title" id="mob-toolbar-title">
          <span class="mob-ch-title">目录</span>
          {!isCover && <span class="mob-ch-pos">{currentIndex + 1}/{chapters.length}</span>}
        </div>
        </div>

        <div id="sgz-main-content">
          <!-- initial server-rendered markup; client JS swaps this innerHTML on nav -->
          <div class="page-header">
            <div class="breadcrumb">
              <a href={url('/zh-hans/translations')} class="bc-link">{strings.nav.translations}</a>
              <span class="bc-sep">›</span>
              {isCover ? (
                <span class="bc-cur" lang={cnLangAttr}>{cn(TEXT_TITLE)}</span>
              ) : (
                <>
                  <a href={baseUrl} class="bc-link" lang={cnLangAttr} data-sgz-link data-chapter="">{cn(TEXT_TITLE)}</a>
                  <span class="bc-sep">›</span>
                  <span class="bc-cur" lang={cnLangAttr}>{cn(currentChapter.label)}</span>
                </>
              )}
            </div>
          </div>

          {isCover ? (
            <div class="cover">
              <div class="cover-left">
                <h1 class="cover-title-zh" lang={cnLangAttr}>{cn(TEXT_TITLE)}</h1>
                <p class="cover-title-en">{TEXT_TITLE.en}</p>
                <p class="cover-meta">陈寿 撰 · 裴松之 注</p>
                <p class="cover-desc">
                  三国时期的史书，涵盖魏、蜀、吴三国，也附裴松之注。
                  <br> <br>
                  与ZL181合作翻译。
                </p>
              </div>
              <div class="cover-right">
                <div class="cover-contents-label">目录</div>
                <div class="cover-book-grid">
                  {coverChapters.map((ch: any) => (
                    <a
                      href={chapterUrl(ch.id)}
                      class="cover-book-card"
                      data-sgz-link
                      data-chapter={ch.id}
                    >
                      <div class="cbc-zh" lang={cnLangAttr}>{cn(ch.label)}</div>
                      <div class="cbc-en">{ch.label.en}</div>
                      <div class="cbc-count" lang={cnLangAttr}>{cn(ch.bookLabel)}</div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <>
              <div class="chapter-header">
                <div class="ch-title-group">
                  <h1 class="ch-title-zh" lang={cnLangAttr}>{cn(currentChapter.title)}</h1>
                  <p class="ch-title-en">{currentChapter.title.en}</p>
                </div>
                <div class="view-toggle" role="group" aria-label="View mode">
                  <button class="view-toggle-btn active" data-view="both" type="button">对照</button>
                  <button class="view-toggle-btn" data-view="orig" type="button">原文</button>
                  <button class="view-toggle-btn" data-view="en" type="button">英译</button>
                </div>
              </div>

              <div class="term-legend">
                <span class="term-legend-item"><i class="ti ti-map-pin term-legend-icon term-legend-icon-loc" aria-hidden="true"></i>地名：新窗口打开地图</span>
                <span class="term-legend-item"><i class="ti ti-file-text term-legend-icon term-legend-icon-off" aria-hidden="true"></i>官职：新窗口打开官职表</span>
                <div class="term-legend-actions">
                  <label class="term-toggle">
                    <input type="checkbox" id="term-toggle-checkbox" checked />
                    <span class="term-toggle-track"><span class="term-toggle-thumb"></span></span>
                    <span class="term-toggle-label">显示标记</span>
                  </label>
                  <a href={url(`/zh-hans/maps/map-overall?journey=${currentChapter.id}`)} class="term-journey-link" target="_blank" rel="noopener">
                    <i class="ti ti-route" aria-hidden="true"></i> 查看足迹
                  </a>
                </div>
              </div>

              <div class="passages">
                {currentChapter.passages.length === 0 && (
                  <p class="ps-pending">{strings.translations?.pending ?? 'Translation in progress.'}</p>
                )}
                {currentChapter.passages.map((p: any) => (
                  <div class="passage" id={p.id}>
                    <p class="ps-orig" lang={cnLangAttr} set:html={linkify(cn(p.orig))} />
                    <p class="ps-en" set:html={linkify(p.en)} />
                    {p.annotations && p.annotations.length > 0 && (
                      <div class="annotations">
                        {p.annotations.map((a: any, ai: number) => (
                          <div class="annotation">
                            <button class="ann-toggle" data-passage={p.id} data-idx={ai}>
                              <i class="ti ti-chevron-right ann-chevron" aria-hidden="true"></i>
                              <span class="ann-label">
                                <span class="ann-label-zh" lang={cnLangAttr}>
                                  {cn(a.annotator)}注引{a.source && <>《{cn(a.source)}》</>}
                                </span>
                                <span class="ann-label-en">
                                  {strings.translations?.annotationBy ?? 'Annotation'} by {a.annotator.en}, quoting
                                  {a.source && <span class="ann-source"> {a.source.en}</span>}
                                </span>
                              </span>
                            </button>
                            <div class="ann-body" data-passage={p.id} data-idx={ai}>
                              <p class="ann-zh" lang={cnLangAttr} set:html={linkify(cn(a))} />
                              <p class="ann-en" set:html={linkify(a.en)} />
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>

              <div class="ch-nav-row">
                {prevChapter ? (
                  <a href={chapterUrl(prevChapter.id)} class="ch-nav-btn" data-sgz-link data-chapter={prevChapter.id}>
                    <i class="ti ti-arrow-left" aria-hidden="true"></i> <span lang={cnLangAttr}>{cn(prevChapter.label)}</span>
                  </a>
                ) : (
                  <span class="ch-nav-btn disabled"><i class="ti ti-arrow-left" aria-hidden="true"></i> <span>{strings.translations?.previous ?? 'Previous'}</span></span>
                )}
                {nextChapter ? (
                  <a href={chapterUrl(nextChapter.id)} class="ch-nav-btn" data-sgz-link data-chapter={nextChapter.id}>
                    <span lang={cnLangAttr}>{cn(nextChapter.label)}</span> <i class="ti ti-arrow-right" aria-hidden="true"></i>
                  </a>
                ) : (
                  <span class="ch-nav-btn disabled"><span>{strings.translations?.next ?? 'Next'}</span> <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
                )}
              </div>
            </>
          )}


        </div>
      </div>
    </div>

    <footer class="site-footer">
      <span class="footer-quote">{strings.footer.quoteBySection?.translations ?? strings.footer.quote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
          <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
             <i class="ti ti-brand-github"></i>
              </a>
       </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<script type="application/json" id="sgz-data" set:html={clientData}></script>

<script>
  import { url } from '../../../../utils/url';

  const dataEl = document.getElementById('sgz-data');
  const DATA = JSON.parse(dataEl ? dataEl.textContent ?? '{}' : '{}');
  const { chapters, bookSections, baseUrl, initialChapterId } = DATA;
  const STR = {
    annotationBy: 'Annotation', previous: '上一章', next: '下一章',
    pending: '翻译中……', translations: '翻译',
  };

  const mainEl = document.getElementById('sgz-main-content');

  const ESCAPE_MAP: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  function esc(s: unknown): string {
    return String(s ?? '').replace(/[&<>"']/g, (c: string) => ESCAPE_MAP[c] ?? c);
  }

  function linkify(text: unknown): string {
    const escaped = String(text ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return escaped.replace(/\[\[([^|\]]+)\|([^\]]+)\]\]/g, (_match: string, label: string, rawUrl: string) => {
      const isLocation = rawUrl.includes('/maps');
      const isOfficial = rawUrl.includes('/officials');
      const typeClass = isLocation ? ' term-link-loc' : isOfficial ? ' term-link-off' : '';
      const icon = isLocation
        ? '<i class="ti ti-map-pin term-link-icon" aria-hidden="true"></i>'
        : isOfficial
        ? '<i class="ti ti-file-text term-link-icon" aria-hidden="true"></i>'
        : '';
      return `<a href="${url(rawUrl)}" class="term-link${typeClass}" target="_blank" rel="noopener">${label}${icon}</a>`;
    });
  }

  function renderPassage(p: any): string {
    const anns = (p.annotations || []).map((a: any, ai: number) => `
      <div class="annotation">
        <button class="ann-toggle" data-passage="${p.id}" data-idx="${ai}">
          <i class="ti ti-chevron-right ann-chevron" aria-hidden="true"></i>
          <span class="ann-label">
            <span class="ann-label-zh" lang="zh-hans">${esc(a.annotator.zht || a.annotator.zhs)}注引${a.source ? `《${esc(a.source.zht || a.source.zhs)}》` : ''}</span>
            <span class="ann-label-en">${esc(STR.annotationBy)} by ${esc(a.annotator.en)}${a.source.en ? `<span class="ann-source"> (${esc(a.source.en)})</span>` : ''}</span>
          </span>
        </button>
        <div class="ann-body" data-passage="${p.id}" data-idx="${ai}">
          <p class="ann-zh" lang="zh-hans">${linkify(a.zht || a.zhs)}</p>
          <p class="ann-en">${linkify(a.en)}</p>
        </div>
      </div>`).join('');
    return `
      <div class="passage" id="${p.id}">
        <p class="ps-orig" lang="zh-hans">${linkify(p.orig.zht || p.orig.zhs)}</p>
        <p class="ps-en">${linkify(p.en)}</p>
        ${anns ? `<div class="annotations">${anns}</div>` : ''}
      </div>`;
  }

  function renderCover(): string {
    const translated = chapters.filter((c: any) => c.passages && c.passages.length > 0);
    const coverChapters = translated.length > 0 ? translated : chapters;
    const bookCards = coverChapters.map((ch: any) => `
      <a href="${baseUrl}/${ch.id}" class="cover-book-card" data-sgz-link data-chapter="${ch.id}">
        <div class="cbc-zh" lang="zh-hans">${esc(ch.label.zht || ch.label.zhs)}</div>
        <div class="cbc-en">${esc(ch.label.en)}</div>
        <div class="cbc-count" lang="zh-hans">${esc(ch.bookLabel.zhs || ch.bookLabel.zht)}</div>
      </a>`).join('');
    return `
      <div class="page-header">
        <div class="breadcrumb">
          <a href="${url('/zh-hans/translations')}" class="bc-link">${esc(STR.translations)}</a>
          <span class="bc-sep">›</span>
          <span class="bc-cur" lang="zh-hans">三国志</span>
        </div>
      </div>
      <div class="cover">
        <div class="cover-left">
          <h1 class="cover-title-zh" lang="zh-hans">三国志</h1>
          <p class="cover-title-en">Records of the Three Kingdoms</p>
          <p class="cover-meta">陈寿 撰．裴松之 注</p>
          <p class="cover-desc">三国时期的编年史，涵盖魏、蜀、吴三国，并附裴松之注。
                  <br> <br>
                  与ZL181合作翻译。</p>
        </div>
        <div class="cover-right">
          <div class="cover-contents-label">目录</div>
          <div class="cover-book-grid">${bookCards}</div>
        </div>
      </div>`;
  }

  function renderChapter(ch: any, idx: number): string {
    const prev = idx > 0 ? chapters[idx - 1] : null;
    const next = idx < chapters.length - 1 ? chapters[idx + 1] : null;
    const passages = ch.passages.length
      ? ch.passages.map(renderPassage).join('')
      : `<p class="ps-pending">${esc(STR.pending)}</p>`;
    return `
      <div class="page-header">
        <div class="breadcrumb">
          <a href="${url('/zh-hans/translations')}" class="bc-link">${esc(STR.translations)}</a>
          <span class="bc-sep">›</span>
          <a href="${baseUrl}" class="bc-link" lang="zh-hans" data-sgz-link data-chapter="">三国志</a>
          <span class="bc-sep">›</span>
          <span class="bc-cur" lang="zh-hans">${esc(ch.label.zht || ch.label.zhs)}</span>
        </div>
      </div>
      <div class="chapter-header">
        <div class="ch-title-group">
          <h1 class="ch-title-zh" lang="zh-hans">${esc(ch.title.zht || ch.title.zhs)}</h1>
          <p class="ch-title-en">${esc(ch.title.en)}</p>
        </div>
        <div class="view-toggle" role="group" aria-label="View mode">
          <button class="view-toggle-btn active" data-view="both" type="button">对照</button>
          <button class="view-toggle-btn" data-view="orig" type="button">原文</button>
          <button class="view-toggle-btn" data-view="en" type="button">英译</button>
        </div>
      </div>
      <div class="term-legend">
        <span class="term-legend-item"><i class="ti ti-map-pin term-legend-icon term-legend-icon-loc" aria-hidden="true"></i>地名：于新页面打开地图</span>
        <span class="term-legend-item"><i class="ti ti-file-text term-legend-icon term-legend-icon-off" aria-hidden="true"></i>官职：于新页面打开官职表</span>
        <div class="term-legend-actions">
          <label class="term-toggle">
            <input type="checkbox" id="term-toggle-checkbox" checked />
            <span class="term-toggle-track"><span class="term-toggle-thumb"></span></span>
            <span class="term-toggle-label">显示标记</span>
          </label>
          <a href="${url(`/zh-hans/maps/map-overall?journey=${ch.id}`)}" class="term-journey-link" target="_blank" rel="noopener">
            <i class="ti ti-route" aria-hidden="true"></i> 查看足迹
          </a>
        </div>
      </div>
      <div class="passages">${passages}</div>
      <div class="ch-nav-row">
        ${prev
          ? `<a href="${baseUrl}/${prev.id}" class="ch-nav-btn" data-sgz-link data-chapter="${prev.id}"><i class="ti ti-arrow-left" aria-hidden="true"></i> <span lang="zh-hans">${esc(prev.label.zhs || prev.label.zht)}</span></a>`
          : `<span class="ch-nav-btn disabled"><i class="ti ti-arrow-left" aria-hidden="true"></i> <span>${esc(STR.previous)}</span></span>`}
        ${next
          ? `<a href="${baseUrl}/${next.id}" class="ch-nav-btn" data-sgz-link data-chapter="${next.id}"><span lang="zh-hans">${esc(next.label.zhs || next.label.zht)}</span> <i class="ti ti-arrow-right" aria-hidden="true"></i></a>`
          : `<span class="ch-nav-btn disabled"><span>${esc(STR.next)}</span> <i class="ti ti-arrow-right" aria-hidden="true"></i></span>`}
      </div>`;
  }

  function updateSidebarActive(chapterId: string | null): void {
    document.querySelectorAll('[data-sgz-link]').forEach((el) => {
      const isMatch = (el.getAttribute('data-chapter') || '') === (chapterId || '');
      el.classList.toggle('on', isMatch && el.classList.contains('sb-ch'));
    });
  }

  function updateMobileToolbar(chapterId: string | null, idx: number): void {
    const titleEl = document.querySelector('#mob-toolbar-title .mob-ch-title');
    let posEl = document.querySelector('#mob-toolbar-title .mob-ch-pos');
    const toolbarTitle = document.getElementById('mob-toolbar-title');
    if (!chapterId) {
      if (titleEl) titleEl.textContent = '目录';
      if (posEl) posEl.remove();
    } else {
      const ch = chapters.find((c: any) => c.id === chapterId);
      if (titleEl && ch) titleEl.textContent = '目录';
      if (!posEl && toolbarTitle) {
        posEl = document.createElement('span');
        posEl.className = 'mob-ch-pos';
        toolbarTitle.appendChild(posEl);
      }
      if (posEl) posEl.textContent = `${idx + 1}/${chapters.length}`;
    }
  }

  function renderRoute(chapterId: string | null, opts: { push: boolean } = { push: true }): void {
    const idx = chapterId ? chapters.findIndex((c: any) => c.id === chapterId) : -1;
    const html = chapterId ? renderChapter(chapters[idx], idx) : renderCover();
    if (mainEl) mainEl.innerHTML = html;
    updateSidebarActive(chapterId);
    updateMobileToolbar(chapterId, idx);
    if (opts.push) {
      const path = chapterId ? `${baseUrl}/${chapterId}` : baseUrl;
      history.pushState({ chapterId }, '', path);
    }
    attachAnnotationHandlers();
    attachViewToggleHandlers();
    attachTermLinkToggleHandler();
    closeDrawer();
    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
  }

  function attachAnnotationHandlers(): void {
    document.querySelectorAll('.ann-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const passageId = btn.getAttribute('data-passage');
        const idx = btn.getAttribute('data-idx');
        const body = document.querySelector(`.ann-body[data-passage="${passageId}"][data-idx="${idx}"]`);
        if (!body) return;
        const isOpen = body.classList.toggle('open');
        btn.classList.toggle('open', isOpen);
        if (isOpen) setTimeout(() => body.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 120);
      });
    });
  }

  function attachViewToggleHandlers(): void {
    const passagesEl = document.querySelector('.passages');
    document.querySelectorAll('.view-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        document.querySelectorAll('.view-toggle-btn').forEach((b) => b.classList.toggle('active', b === btn));
        if (passagesEl) {
          passagesEl.classList.remove('view-orig', 'view-en');
          if (view === 'orig') passagesEl.classList.add('view-orig');
          if (view === 'en') passagesEl.classList.add('view-en');
        }
      });
    });
  }

  function attachTermLinkToggleHandler(): void {
    const checkbox = document.getElementById('term-toggle-checkbox') as HTMLInputElement | null;
    const passagesEl = document.querySelector('.passages');
    checkbox?.addEventListener('change', () => {
      if (passagesEl) passagesEl.classList.toggle('links-hidden', !checkbox.checked);
    });
  }

  // Intercept all internal Sanguozhi links for instant client-side swap
  document.addEventListener('click', (e: MouseEvent) => {
    const target = e.target as HTMLElement | null;
    const link = target ? target.closest('[data-sgz-link]') : null;
    if (!link) return;
    e.preventDefault();
    renderRoute(link.getAttribute('data-chapter') || null);
  });

  window.addEventListener('popstate', (e: PopStateEvent) => {
    renderRoute(e.state ? e.state.chapterId : null, { push: false });
  });

  // ---- Mobile drawer ----
  const overlay = document.getElementById('mob-overlay');
  const drawer = document.getElementById('mob-drawer');
  function toggleDrawer(): void {
    drawer?.classList.toggle('open');
    overlay?.classList.toggle('open');
  }
  function closeDrawer(): void {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
  }
  document.getElementById('mob-menu-btn')?.addEventListener('click', toggleDrawer);
  document.getElementById('mob-drawer-close')?.addEventListener('click', toggleDrawer);
  overlay?.addEventListener('click', toggleDrawer);

  attachAnnotationHandlers();
  attachViewToggleHandlers();
  attachTermLinkToggleHandler();
  history.replaceState({ chapterId: initialChapterId }, '', location.pathname);
</script>

