---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import ContactModal from '../../../components/Contactmodal.astro';
import { t } from '../../../i18n/index.js';
import { buildAllPositions } from '../../../scripts/translations/build-officials-index.js';
import { url } from '../../../utils/url';

const lang = 'zh-hans';
const strings = t(lang);
const s = strings.officials;

const allPositions = buildAllPositions();

const categories = [
  { id: 'ministers', label: '公卿' },
  { id: 'departments', label: '臺省' },
  { id: 'military', label: '武官' },
  { id: 'regional', label: '地方' },
  { id: 'household', label: '東/后宮' },
  { id: 'nobility', label: '爵位' },
];

function utf8ToBase64(str: string): string {
  const bytes = new TextEncoder().encode(str);
  let binary = '';
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary);
}
const officialsPayload = utf8ToBase64(JSON.stringify({ allPositions, categories, lang }));
---

<Base title={`搜索结果 · ${strings.siteTitle}`} lang="zh-hans">
  <div class="site">
    <Nav lang={lang} strings={strings} />

    <div class="page-header">
      <div class="breadcrumb">
        <a href={url('/zh-hans/translations')} class="bc-link">{strings.nav.translations}</a>
        <span class="bc-sep">›</span>
        <a href={url('/zh-hans/translations/officials')} class="bc-link">{s.title}</a>
        <span class="bc-sep">›</span>
        <span class="bc-cur">检索</span>
      </div>
      <h1 class="page-title" id="results-title">检索结果</h1>
      <p class="page-sub" id="results-count"></p>
    </div>

    <div class="search-layout">
      <aside class="filter-aside">
        <div class="filter-header">
          <span class="filter-title">筛选</span>
          <button class="filter-clear" id="filter-clear">清除全部</button>
        </div>

        <div class="filter-group">
          <div class="filter-group-label">类别</div>
          <div id="filter-category-list"></div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label">品</div>
          <div id="filter-rank-list"></div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label">俸禄（石）</div>
          <div id="filter-gradeclass-list"></div>
        </div>
      </aside>

      <div class="results-main">
        <div id="results-container"></div>
        <div class="pagination" id="pagination"></div>
      </div>
    </div>

    <footer class="site-footer">
      <span class="footer-quote">{strings.footer.quoteBySection?.translations ?? strings.footer.quote}</span>
      <div class="footer-right">
        <span class="footer-copy">{strings.footer.copyright} © {new Date().getFullYear()}</span>
        <a href={strings.footer.github} class="footer-github" target="_blank" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
      </div>
    </footer>

    <ContactModal strings={strings} />
  </div>
</Base>

<div id="officials-data" data-payload={officialsPayload} style="display:none;"></div>

<script>
  // @ts-nocheck
  import { searchPositions } from '../../../scripts/translations/search-module.js';

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const PAGE_SIZE = 15;
  let page = 1;

  const officialsDataEl = document.getElementById('officials-data');
  const payload = officialsDataEl.dataset.payload || '';
  const binaryStr = atob(payload);
  const bytes = Uint8Array.from(binaryStr, c => c.charCodeAt(0));
  const jsonStr = new TextDecoder('utf-8').decode(bytes);
  const { allPositions, categories, lang } = JSON.parse(jsonStr || '{}');
  const langKey = lang === 'zh-hant' ? 'zht' : lang === 'zh-hans' ? 'zhs' : 'en';
  const langPrefix = lang === 'en' ? '' : `/${lang}`;

  function catLabelFor(p) {
    const cat = p.categoryLabel || {};
    return cat[langKey] ?? cat.en ?? '';
  }
  function descFor(p) {
    const d = p.desc || {};
    return d[langKey] ?? d.en ?? '';
  }
  function nameFor(p) {
    return langKey === 'zht' ? (p.nameZht || p.nameEn) : langKey === 'zhs' ? (p.nameZhs || p.nameEn) : p.nameEn;
  }
  function altNameFor(p) {
    return langKey === 'en' ? p.nameZht : p.nameEn;
  }
  function superiorNameFor(sup) {
    return langKey === 'zht' ? (sup.nameZht || sup.nameEn) : langKey === 'zhs' ? (sup.nameZhs || sup.nameEn) : sup.nameEn;
  }
  function superiorAltFor(sup) {
    return langKey === 'en' ? sup.nameZht : sup.nameEn;
  }

  const params = new URLSearchParams(window.location.search);
  const query = params.get('q') || '';

  document.getElementById('results-title').textContent = query
    ? `"${query}"的检索结果`
    : '检索结果';

  const allResults = query ? searchPositions(allPositions, query) : [];

  // ---- Filter state ----
  const activeCategories = new Set();
  const activeRanks = new Set();
  const activeGradeClasses = new Set();

  function rankTextFor(p) {
    return (p.rank && (p.rank[langKey] || p.rank.en)) || '';
  }

function shiPhraseFor(p) {
  let text = rankTextFor(p);
  text = text.replace(/[（(][^）)]*[）)]/g, '').trim();

  let match;
  if (langKey === 'en') {
    match = text.match(/([^,]*\b\d+\s*shi\b[^,]*)/i);
  } else {
    match = text.match(/([^，]*石)/);
  }
  if (!match) return null;
  return match[1].trim().replace(/\bshi\b/gi, '').replace(/石/g, '').replace(/\s+/g, ' ').trim();
}

  function getFiltered() {
    return allResults.filter(p => {
      if (activeCategories.size && !activeCategories.has(p.category)) return false;
      if (activeRanks.size) {
        const rankVal = p.gradeNum != null ? String(p.gradeNum) : 'none';
        if (!activeRanks.has(rankVal)) return false;
      }
      if (activeGradeClasses.size) {
        const shi = shiPhraseFor(p) ?? 'none';
        if (!activeGradeClasses.has(shi)) return false;
      }
      return true;
    });
  }

  // ---- Build filter sidebar options ----
  function buildCategoryFilters() {
    const counts = {};
    allResults.forEach(p => { counts[p.category] = (counts[p.category] || 0) + 1; });
    const list = document.getElementById('filter-category-list');
    list.innerHTML = categories
      .filter(c => counts[c.id])
      .map(c => `
        <label class="filter-option">
          <input type="checkbox" data-filter="category" value="${c.id}" />
          <span>${c.label}</span>
          <span class="filter-count">${counts[c.id]}</span>
        </label>`).join('');
  }

  function buildRankFilters() {
    const counts = {};
    allResults.forEach(p => {
      const key = p.gradeNum != null ? String(p.gradeNum) : 'none';
      counts[key] = (counts[key] || 0) + 1;
    });
    const ranks = Object.keys(counts)
      .filter(k => k !== 'none')
      .map(Number)
      .sort((a, b) => a - b)
      .map(String);
    if (counts['none']) ranks.push('none');

    const list = document.getElementById('filter-rank-list');
    list.innerHTML = ranks.map(r => `
      <label class="filter-option">
        <input type="checkbox" data-filter="rank" value="${r}" />
        <span>${r === 'none' ? '无考' : r}</span>
        <span class="filter-count">${counts[r]}</span>
      </label>`).join('');
  }

  function buildGradeClassFilters() {
    const counts = {};
    allResults.forEach(p => {
      const shi = shiPhraseFor(p) ?? 'none';
      counts[shi] = (counts[shi] || 0) + 1;
    });

    const keys = Object.keys(counts).filter(k => k !== 'none');
    keys.sort((a, b) => {
      const numA = parseInt((a.match(/\d+/) || ['0'])[0], 10);
      const numB = parseInt((b.match(/\d+/) || ['0'])[0], 10);
      return numB - numA;
    });
    if (counts['none']) keys.push('none');

    const list = document.getElementById('filter-gradeclass-list');
    list.innerHTML = keys.map(k => `
      <label class="filter-option">
        <input type="checkbox" data-filter="gradeclass" value="${k}" />
        <span>${k === 'none' ? '无考' : k}</span>
        <span class="filter-count">${counts[k]}</span>
      </label>`).join('');
  }

  function wireFilterCheckboxes() {
    document.querySelectorAll('input[data-filter]').forEach(box => {
      box.addEventListener('change', () => {
        const set = box.dataset.filter === 'category' ? activeCategories
                  : box.dataset.filter === 'rank' ? activeRanks
                  : activeGradeClasses;
        if (box.checked) set.add(box.value);
        else set.delete(box.value);
        page = 1;
        renderResults();
      });
    });
  }

  document.getElementById('filter-clear').addEventListener('click', () => {
    activeCategories.clear();
    activeRanks.clear();
    activeGradeClasses.clear();
    document.querySelectorAll('input[data-filter]').forEach(box => { box.checked = false; });
    page = 1;
    renderResults();
  });

  // ---- Pagination ----
  function renderPagination(totalItems) {
  const paginationEl = document.getElementById('pagination');
  const totalPages = Math.max(1, Math.ceil(totalItems / PAGE_SIZE));
  page = Math.min(page, totalPages);

  paginationEl.innerHTML = '';
  if (totalPages <= 1) return;

  const prev = document.createElement('button');
  prev.className = 'page-btn';
  prev.innerHTML = '<i class="ti ti-chevron-left" aria-hidden="true"></i>';
  prev.disabled = page === 1;
  prev.addEventListener('click', () => { page--; renderResults(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
  paginationEl.appendChild(prev);

  function addPageBtn(i) {
    const btn = document.createElement('button');
    btn.className = 'page-btn' + (i === page ? ' active' : '');
    btn.textContent = i;
    btn.addEventListener('click', () => { page = i; renderResults(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
    paginationEl.appendChild(btn);
  }

  function addEllipsis() {
    const span = document.createElement('span');
    span.className = 'page-ellipsis';
    span.textContent = '…';
    paginationEl.appendChild(span);
  }

  const windowSize = 1; // how many pages to show on each side of current
  const pagesToShow = new Set([1, totalPages]);
  for (let i = page - windowSize; i <= page + windowSize; i++) {
    if (i >= 1 && i <= totalPages) pagesToShow.add(i);
  }

  const sorted = Array.from(pagesToShow).sort((a, b) => a - b);
  let lastShown = 0;
  for (const p of sorted) {
    if (p - lastShown > 1) addEllipsis();
    addPageBtn(p);
    lastShown = p;
  }

  const next = document.createElement('button');
  next.className = 'page-btn';
  next.innerHTML = '<i class="ti ti-chevron-right" aria-hidden="true"></i>';
  next.disabled = page === totalPages;
  next.addEventListener('click', () => { page++; renderResults(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
  paginationEl.appendChild(next);
}

  const kingdomLabels = { wei: '魏', shu: '蜀', wu: '吴' };

  function kingdomBadgesHtml(p) {
    const kingdoms = p.kingdoms || [];
    if (!kingdoms.length) return '';
    return `<span class="result-card-kingdoms">${
      kingdoms.map(k => `<span class="kingdom-badge kingdom-${k}">${kingdomLabels[k]}</span>`).join('')
    }</span>`;
  }

  // ---- Result cards ----
  function renderResults() {
    const filtered = getFiltered();

    document.getElementById('results-count').textContent = `共 ${filtered.length} 条`;

    const container = document.getElementById('results-container');

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="no-results">
          <div class="no-results-title">${query ? `未找到符合"${query}"的官职` : '未找到官职'}</div>
        </div>`;
      document.getElementById('pagination').innerHTML = '';
      return;
    }

    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    page = Math.min(page, totalPages);
    const start = (page - 1) * PAGE_SIZE;
    const pageItems = filtered.slice(start, start + PAGE_SIZE);

    container.innerHTML = `<div class="result-cards">${
      pageItems.map(p => {
        const gradeBadge = p.gradeNum
          ? `<span class="result-card-grade">${p.gradeNum}</span>`
          : `<span class="result-card-grade result-card-grade-empty">?</span>`;

        const chainItems = [...(p.superiors || []), p];
        const breadcrumbHtml = chainItems.length > 1
          ? `<div class="result-card-breadcrumb">${
              chainItems.map((node, i) => {
                const isLast = i === chainItems.length - 1;
                const primary = isLast ? nameFor(p) : superiorNameFor(node);
                const alt = isLast ? altNameFor(p) : superiorAltFor(node);
                return `<span class="bc-node"><span class="bc-primary">${primary}</span>${alt ? ` <span class="bc-alt">${alt}</span>` : ''}</span>`;
              }).join('<span class="result-card-bc-sep">›</span>')
            }</div>`
          : '';

        const descHtml = descFor(p)
          ? `<div class="result-card-desc">${descFor(p)}</div>`
          : '';

        return `
          <a href="${base}${langPrefix}${p.url}" class="result-card">
            <div class="result-card-top">
              ${gradeBadge}
              <div class="result-card-heading">
                <span class="result-card-name">${nameFor(p)}</span>
                <span class="result-card-zh">${altNameFor(p) ?? ''}</span>
              </div>
              ${kingdomBadgesHtml(p)}
              <span class="result-card-cat">${catLabelFor(p)}</span>
            </div>
            ${descHtml}
            ${breadcrumbHtml ? `<br>${breadcrumbHtml}` : ''}
          </a>`;
      }).join('')
    }</div>`;

    renderPagination(filtered.length);
  }

  buildCategoryFilters();
  buildRankFilters();
  buildGradeClassFilters();
  wireFilterCheckboxes();
  renderResults();
</script>

<style is:global>
.site { max-width: 100%; background: var(--color-bg); min-height: 100vh; display: flex; flex-direction: column; }

.page-header { padding: 1.5rem 2rem 1.25rem; border-bottom: 0.5px solid var(--color-border); }
.breadcrumb { display: flex; align-items: center; gap: 6px; margin-bottom: 0.75rem; }
.bc-link { font-size: 15px; color: var(--color-text-tertiary); text-decoration: none; }
.bc-link:hover { color: var(--color-text-secondary); }
.bc-sep { font-size: 14px; color: var(--color-text-tertiary); }
.bc-cur { font-size: 18px; color: var(--color-text-secondary); }
.page-title { font-family: 'Noto Serif SC', serif; font-size: 40px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 4px; }
.page-sub { font-family: 'LXGW WenKai', serif; font-size: 20px; color: var(--color-text-secondary); }

.search-layout {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 2rem;
  padding: 1.5rem 2rem;
  flex: 1;
}

.filter-aside { display: flex; flex-direction: column; gap: 1.5rem; }
.filter-header { display: flex; align-items: center; justify-content: space-between; }
.filter-title { font-family: 'LXGW WenKai', serif; font-size: 16px; font-weight: 600; color: var(--color-text-primary); }
.filter-clear { font-family: 'LXGW WenKai', serif; font-size: 15px; color: var(--color-text-tertiary); background: none; border: none; cursor: pointer; }
.filter-clear:hover { color: var(--color-text-primary); }

.filter-group-label {
  font-family: 'LXGW WenKai', serif;
  font-size: 18px; letter-spacing: 0.06em;
  color: var(--color-text-tertiary); margin-bottom: 8px;
}
.filter-option {
  display: flex; align-items: center; gap: 8px;
  font-family: 'LXGW WenKai', serif;
  font-size: 17px; color: var(--color-text-secondary);
  padding: 4px 0; cursor: pointer;
}
.filter-option input {
  appearance: none;
  width: 14px;
  height: 14px;
  border: 0.5px solid var(--color-border);
  border-radius: 3px;
  background: var(--color-bg-secondary);
  cursor: pointer;
  flex-shrink: 0;
  position: relative;
  transition: background 0.15s, border-color 0.15s;
}

.filter-option input:checked {
  background: var(--archive-gold-soft, #d0aa6b);
  border-color: var(--archive-gold-soft, #d0aa6b);
}

.filter-option input:checked::after {
  content: '✓';
  position: absolute;
  top: -2px;
  left: 1px;
  font-size: 11px;
  color: #1a1410;
  font-weight: 700;
}
.filter-count { margin-left: auto; font-size: 13px; color: var(--color-text-tertiary); }

.results-main { min-width: 0; }
.result-cards { display: flex; flex-direction: column; gap: 8px; }
.result-card { display: block; padding: 14px 16px; border: 0.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: background 0.15s; }
.result-card:hover { background: var(--color-bg-secondary); }
.result-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.result-card-grade { flex-shrink: 0; width: 42px; height: 42px; border-radius: 50%; background: var(--color-bg-secondary); color: var(--archive-gold-soft, #d0aa6b); font-size: 17px; font-weight: 500; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
.result-card-grade-empty { color: var(--archive-gold-soft, #d0aa6b); }
.result-card-heading { flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 8px; }
.result-card-name { font-family: 'Noto Serif SC', serif; font-size: 22px; font-weight: 500; color: var(--color-text-primary); white-space: nowrap; }
.result-card-zh { font-family: 'Inter', sans-serif; font-size: 16px; color: var(--color-text-tertiary); white-space: nowrap; }
.result-card-cat { font-family: 'LXGW WenKai', serif; font-size: 18px; padding: 2px 8px; border-radius: 20px; background: var(--color-bg-secondary); color: var(--color-text-tertiary); flex-shrink: 0; white-space: nowrap; }

.result-card-breadcrumb { font-family: 'LXGW WenKai', serif; font-size: 14.5px; padding-left: 32px; margin-top: 4px; }
.bc-node { display: inline; }
.bc-primary,
.bc-alt {
  color: var(--archive-gold-soft, #d0aa6b);
}
.result-card-bc-sep { color: var(--color-text-tertiary); opacity: 0.6; margin: 0 4px; }
.result-card-kingdoms {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}
.kingdom-badge {
  font-family: 'LXGW WenKai', serif;
  font-size: 18px;
  padding: 2px 6px;
  border-radius: 10px;
  font-weight: 600;
}
.kingdom-wei { background: rgba(94, 132, 184, 0.18); color: #7fa8d9; }
.kingdom-shu { background: rgba(196, 92, 92, 0.18); color: #d98a8a; }
.kingdom-wu { background: rgba(94, 164, 120, 0.18); color: #8fcf9f; }

.result-card-desc { font-family: 'LXGW WenKai', serif; font-size: 16px; color: var(--color-text-secondary); line-height: 1.5; padding-left: 52px; margin-top: 4px; max-width: 1000px; }

.no-results { padding: 3rem; text-align: center; }
.no-results-title { font-family: 'LXGW WenKai', serif; font-size: 18px; font-weight: 500; color: var(--color-text-secondary); }

.pagination { display: flex; justify-content: center; gap: 6px; margin-top: 1.5rem; }
.page-btn {
  min-width: 30px; height: 30px; border-radius: var(--radius-md);
  border: 0.5px solid var(--color-border); background: var(--color-bg-secondary);
  color: var(--color-text-secondary); font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.page-btn.active { background: var(--trans-purple-bg, #6b4308); color: #fff; border-color: transparent; }
.page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.page-ellipsis {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 20px;
  color: var(--color-text-tertiary);
  font-size: 13px;
}

.site-footer { margin-top: auto; border-top: 0.5px solid var(--color-border); padding: 0.875rem 2rem; display: flex; justify-content: space-between; align-items: center; background: var(--color-bg-secondary); }
.footer-right { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
.footer-copy { font-size: 0.82rem; color: var(--color-text-tertiary); }
.footer-github { color: var(--color-text-tertiary); font-size: 18px; text-decoration: none; transition: color 0.15s; }
.footer-github:hover { color: var(--color-text-primary); }
.footer-quote { font-family: 'LXGW WenKai', serif; font-size: 0.8rem; color: var(--color-text-tertiary); font-style: italic; white-space: pre-line; }

@media (max-width: 900px) {
  .search-layout { grid-template-columns: 1fr; }
  .filter-aside { order: -1; }
}
@media (max-width: 800px) {
  .page-header { padding: 1.5rem 1rem; }
  .search-layout { padding: 1rem; }
  .site-footer { flex-direction: column; align-items: center; gap: 0.75rem; padding: 1rem; text-align: center; }
  .result-card-top {
    flex-wrap: wrap;
  }
  .result-card-heading {
    flex-wrap: wrap;
    flex-basis: 100%;
  }
  .result-card-name,
  .result-card-zh {
    white-space: normal;
  }
  .result-card-cat {
    flex-shrink: 0;
    white-space: normal;
    max-width: 300px;
    text-align: center;
  }
  .result-card-breadcrumb,
  .result-card-desc {
    padding-left: 0;
  }
}
</style>